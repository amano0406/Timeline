@page "/windows-codex/thread/{ItemId}"
@inject TimelineHelperClient Timeline

<PageTitle>@TitleLabel - Timeline</PageTitle>

<TimelineBreadcrumbs>
    <a href="scan">スキャン</a>
    <span class="tfa-breadcrumb-separator">/</span>
    <a href="windows-codex">Windows Codex スレッド一覧</a>
    <span class="tfa-breadcrumb-separator">/</span>
    <span aria-current="page">スレッド詳細</span>
</TimelineBreadcrumbs>

<div class="mb-6">
    <div class="min-w-0">
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="comments" Class="tfa-icon text-accent" />
            <span>@TitleLabel</span>
        </h1>
    </div>
</div>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_loading)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else if (_thread is null || !_thread.Available)
{
    <section class="tfa-card tfa-card-pad">
        <div class="flex items-start gap-2 text-sm text-slate-600">
            <FaIcon Name="circle-info" Class="tfa-icon mt-0.5 text-slate-400" />
            <span>@EmptyText(_thread?.Message, "指定されたスレッドは見つかりませんでした。")</span>
        </div>
    </section>
}
else
{
    <TimelineItemSummaryPanel Summary="@_itemSummary" Loading="@_itemSummaryLoading" Class="mb-5" />

    <div class="grid gap-4 md:grid-cols-4">
        <section class="tfa-card tfa-card-pad">
            <div class="tfa-kicker">メッセージ数</div>
            <div class="mt-2 text-3xl font-semibold">@_thread.MessageCount</div>
        </section>
        <section class="tfa-card tfa-card-pad">
            <div class="tfa-kicker">作成日時</div>
            <div class="mt-2 text-lg font-semibold">@ShortDate(_thread.CreatedAt)</div>
        </section>
        <section class="tfa-card tfa-card-pad">
            <div class="tfa-kicker">更新日時</div>
            <div class="mt-2 text-lg font-semibold">@ShortDate(_thread.UpdatedAt)</div>
        </section>
        <section class="tfa-card tfa-card-pad">
            <div class="tfa-kicker">保存先</div>
            <div class="mt-2 truncate text-lg font-semibold">@ShortPath(_thread.DirectoryPath)</div>
        </section>
    </div>

    <section class="tfa-card tfa-conversation-card mt-5 overflow-hidden">
        <div class="tfa-card-pad flex items-center justify-between gap-3 border-b border-line">
            <h2 class="flex items-center gap-2 text-lg font-semibold">
                <FaIcon Name="message" Class="tfa-icon text-accent" />
                <span>会話内容</span>
            </h2>
            <span class="text-sm text-slate-500">@_thread.Messages.Count 件</span>
        </div>

        @if (_thread.Messages.Count == 0)
        {
            <div class="p-5 text-sm text-slate-600">表示できるメッセージはありません。</div>
        }
        else
        {
            <div class="tfa-chat-list">
                @foreach (var group in MessageGroups)
                {
                    <article class="@MessageClass(group.Role)">
                        <div class="tfa-chat-bubble">
                            <div class="tfa-chat-meta">
                                <span class="inline-flex items-center gap-1.5">
                                    <FaIcon Name="@RoleIcon(group.Role)" Class="tfa-icon !h-3 !w-3" />
                                    <span>@RoleLabel(group.Role)</span>
                                </span>
                                <span>@group.Messages.Count 件</span>
                            </div>
                            <div class="tfa-chat-parts">
                                @for (var index = 0; index < group.Messages.Count; index += 1)
                                {
                                    var message = group.Messages[index];
                                    var isContinuation = index > 0;
                                    <section class="@(isContinuation ? "tfa-chat-part tfa-chat-part-continuation" : "tfa-chat-part")">
                                        @if (!isContinuation)
                                        {
                                            <div class="tfa-chat-part-time">@ShortDate(message.CreatedAt)</div>
                                        }
                                        <MarkdownText Text="@EmptyText(message.Text, "本文なし")" />
                                    </section>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
}
