@page "/pc"
@inject TimelineHelperClient Timeline
@inject IJSRuntime Js

<PageTitle>PC状態一覧 - Timeline</PageTitle>

<TimelineBreadcrumbs>
    <a href="scan">スキャン</a>
    <span class="tfa-breadcrumb-separator">/</span>
    <span aria-current="page">PC状態一覧</span>
</TimelineBreadcrumbs>

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="desktop" Class="tfa-icon text-accent" />
            <span>PC状態一覧</span>
        </h1>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="tfa-button-secondary gap-2" @onclick="LoadAsync" disabled="@Busy">
            <FaIcon Name="rotate" Class="@($"tfa-icon {(_loading ? "fa-spin" : "")}")" />
            <span>一覧更新</span>
        </button>
        <button class="tfa-button-primary gap-2" @onclick="RefreshPcAsync" disabled="@Busy">
            <FaIcon Name="@(_refreshing ? "spinner" : "arrows-rotate")" Class="@($"tfa-icon {(_refreshing ? "fa-spin" : "")}")" />
            <span>@(_refreshing ? "記録中" : "PC状態を記録")</span>
        </button>
        <button class="tfa-button-secondary gap-2" @onclick="DownloadAsync" disabled="@(!CanDownload || Busy)">
            <FaIcon Name="@(_downloading ? "spinner" : "download")" Class="@($"tfa-icon {(_downloading ? "fa-spin" : "")}")" />
            <span>@(_downloading ? "作成中" : "ダウンロード")</span>
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_operationMessage))
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="circle-info" Class="tfa-icon mt-0.5" />
        <span>@_operationMessage</span>
    </div>
}

@if (_loading && _overview is null)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else if (_overview is not null)
{
    @if (!_overview.ProductFound)
    {
        <div class="tfa-alert-danger mb-5 flex items-start gap-2">
            <FaIcon Name="folder-open" Class="tfa-icon mt-0.5" />
            <span>TimelineForPC が見つかりません。</span>
        </div>
    }
    else if (!_overview.SettingsValid)
    {
        <div class="tfa-alert-warn mb-5 flex items-start gap-2">
            <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
            <span>@EmptyText(_overview.Message)</span>
        </div>
    }

    <div class="tfa-summary-grid">
        <section class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="tfa-kicker">取り込み済み</div>
                    <div class="mt-2 text-3xl font-semibold">@ItemCountLabel</div>
                </div>
                <span class="tfa-icon-box">
                    <FaIcon Name="desktop" Class="tfa-icon" />
                </span>
            </div>
        </section>
    </div>

    <section class="tfa-card tfa-list-card mt-5 overflow-hidden">
        <div class="tfa-card-pad flex flex-col gap-3 border-b border-line sm:flex-row sm:items-center sm:justify-between">
            <h2 class="flex items-center gap-2 text-lg font-semibold">
                <FaIcon Name="desktop" Class="tfa-icon text-accent" />
                <span>アイテム一覧</span>
            </h2>
            <div class="flex items-center gap-2 text-sm text-slate-500">
                <FaIcon Name="@(ListBusy ? "spinner" : "clock")" Class="@($"tfa-icon {(ListBusy ? "fa-spin" : "")}")" />
                <span>@ListStatusLabel</span>
            </div>
        </div>

        @if (_loadingPage)
        {
            <div class="p-5 text-sm text-slate-600">
                <div class="flex items-center gap-3">
                    <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
                    <span>読み込み中</span>
                </div>
            </div>
        }
        else if (Items.Count == 0)
        {
            <div class="p-5 text-sm text-slate-600">PC状態はありません。</div>
        }
        else
        {
            <div class="overflow-x-auto tfa-long-list-scroll tfa-list-scroll">
                <table class="tfa-table">
                    <thead>
                        <tr>
                            <th>タイトル</th>
                            <th>イベント</th>
                            <th>作成日時</th>
                            <th>更新日時</th>
                            <th>状態</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Items)
                        {
                            <tr>
                                <td class="min-w-80">
                                    <div class="font-medium text-slate-900">@EmptyText(item.Title)</div>
                                </td>
                                <td class="whitespace-nowrap">@item.EventCount 件</td>
                                <td class="whitespace-nowrap">@UiFormat.ShortDate(item.CreatedAt)</td>
                                <td class="whitespace-nowrap">@UiFormat.ShortDate(item.UpdatedAt)</td>
                                <td class="whitespace-nowrap">
                                    <span class="@PcUpdateStatusPillClass(item.LatestUpdateStatus)">
                                        <FaIcon Name="@PcUpdateStatusIcon(item.LatestUpdateStatus)" Class="tfa-icon !h-3 !w-3" />
                                        <span>@PcUpdateStatusLabel(item.LatestUpdateStatus)</span>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <PaginationControls CurrentPage="@_currentPage"
                                PageSize="@PageSize"
                                TotalItems="@ListTotalItems"
                                Disabled="@Busy"
                                Label="PC状態一覧のページ移動"
                                PageChanged="ChangePageAsync" />
        }
    </section>
}
