@page "/pc"
@inject TimelineHelperClient Timeline

<PageTitle>PC状態一覧 - Timeline</PageTitle>

<TimelineBreadcrumbs>
    <a href="scan">スキャン</a>
    <span class="tfa-breadcrumb-separator">/</span>
    <span aria-current="page">PC状態一覧</span>
</TimelineBreadcrumbs>

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="desktop" Class="tfa-icon text-accent" />
            <span>PC状態一覧</span>
        </h1>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="tfa-button-secondary gap-2" @onclick="LoadAsync" disabled="@Busy">
            <FaIcon Name="rotate" Class="@($"tfa-icon {(_loading ? "fa-spin" : "")}")" />
            <span>一覧更新</span>
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_loading && _overview is null)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else if (_overview is not null)
{
    @if (!_overview.ProductFound)
    {
        <div class="tfa-alert-danger mb-5 flex items-start gap-2">
            <FaIcon Name="folder-open" Class="tfa-icon mt-0.5" />
            <span>TimelineForPC が見つかりません。</span>
        </div>
    }
    else if (!_overview.SettingsValid)
    {
        <div class="tfa-alert-warn mb-5 flex items-start gap-2">
            <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
            <span>@EmptyText(_overview.Message)</span>
        </div>
    }

    <div class="tfa-summary-grid">
        <section class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="tfa-kicker">取り込み済み</div>
                    <div class="mt-2 text-3xl font-semibold">@ItemCountLabel</div>
                </div>
                <span class="tfa-icon-box">
                    <FaIcon Name="desktop" Class="tfa-icon" />
                </span>
            </div>
        </section>
    </div>

    <section class="tfa-card tfa-list-card mt-5 overflow-hidden">
        <div class="tfa-card-pad flex flex-col gap-3 border-b border-line sm:flex-row sm:items-center sm:justify-between">
            <h2 class="flex items-center gap-2 text-lg font-semibold">
                <FaIcon Name="desktop" Class="tfa-icon text-accent" />
                <span>アイテム一覧</span>
            </h2>
            <div class="flex items-center gap-2 text-sm text-slate-500">
                <FaIcon Name="@(ListBusy ? "spinner" : "clock")" Class="@($"tfa-icon {(ListBusy ? "fa-spin" : "")}")" />
                <span>@ListStatusLabel</span>
            </div>
        </div>

        @if (_loadingPage)
        {
            <div class="p-5 text-sm text-slate-600">
                <div class="flex items-center gap-3">
                    <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
                    <span>読み込み中</span>
                </div>
            </div>
        }
        else if (Items.Count == 0)
        {
            <div class="p-5 text-sm text-slate-600">PC状態はありません。</div>
        }
        else
        {
            <div class="overflow-x-auto tfa-long-list-scroll tfa-list-scroll">
                <table class="tfa-table">
                    <thead>
                        <tr>
                            <th>タイトル</th>
                            <th>イベント</th>
                            <th>作成日時</th>
                            <th>更新日時</th>
                            <th>状態</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Items)
                        {
                            <tr>
                                <td class="min-w-80">
                                    <div class="font-medium text-slate-900">@EmptyText(item.Title)</div>
                                </td>
                                <td class="whitespace-nowrap">@item.EventCount 件</td>
                                <td class="whitespace-nowrap">@UiFormat.ShortDate(item.CreatedAt)</td>
                                <td class="whitespace-nowrap">@UiFormat.ShortDate(item.UpdatedAt)</td>
                                <td class="whitespace-nowrap">
                                    <span class="@PcUpdateStatusPillClass(item.LatestUpdateStatus)">
                                        <FaIcon Name="@PcUpdateStatusIcon(item.LatestUpdateStatus)" Class="tfa-icon !h-3 !w-3" />
                                        <span>@PcUpdateStatusLabel(item.LatestUpdateStatus)</span>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <PaginationControls CurrentPage="@_currentPage"
                                PageSize="@PageSize"
                                TotalItems="@ListTotalItems"
                                Disabled="@Busy"
                                Label="PC状態一覧のページ移動"
                                PageChanged="ChangePageAsync" />
        }
    </section>
}

@code {
    private const int PageSize = 25;
    private PcOverview? _overview;
    private PcItemListResult? _items;
    private bool _loading = true;
    private bool _loadingPage;
    private DateTime? _lastLoadedAt;
    private int _currentPage = 1;
    private string? _error;

    private IReadOnlyList<PcItemRow> Items => _items?.Items ?? [];
    private bool Busy => _loading || _loadingPage;
    private bool ListBusy => Busy;
    private int ItemCount => _items?.Total > 0 ? _items.Total : _overview?.ItemCount ?? Items.Count;
    private string ItemCountLabel => $"{ItemCount:N0} 件";
    private int ListTotalItems => _items?.Pagination.TotalItems > 0 ? _items.Pagination.TotalItems : ItemCount;
    private int VisibleEventCount => Items.Sum(item => item.EventCount);
    private string ProcessingLabel => _overview?.ItemCount > 0 ? "取得済み" : "未作成";
    private string ProcessingIcon => _overview?.ItemCount > 0 ? "circle-check" : "circle-minus";
    private string ProcessingIconClass => _overview?.ItemCount > 0 ? "text-teal-700" : "text-slate-500";
    private string ListStatusLabel => ListBusy
        ? "読み込み中"
        : _lastLoadedAt is null
            ? ""
            : $"最終更新 {_lastLoadedAt.Value:HH:mm:ss}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _overview = await Timeline.GetPcOverviewAsync();
            _currentPage = 1;
            _items = new PcItemListResult
            {
                Total = _overview.ItemCount,
                Pagination = new TimelinePagination
                {
                    Page = 1,
                    PageSize = PageSize,
                    TotalItems = _overview.ItemCount,
                    ReturnedItems = 0,
                },
            };
            await InvokeAsync(StateHasChanged);
            await LoadPageAsync(_currentPage);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ChangePageAsync(int page)
    {
        if (page == _currentPage)
        {
            return;
        }

        await LoadPageAsync(page);
    }

    private async Task LoadPageAsync(int page)
    {
        _loadingPage = true;
        _error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            _items = await Timeline.GetPcItemsAsync(page, PageSize);
            _currentPage = Math.Max(1, _items.Pagination.Page);
            _lastLoadedAt = DateTime.Now;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingPage = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string EmptyText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string PcUpdateStatusLabel(string? value) =>
        (value ?? "").Trim().ToLowerInvariant() switch
        {
            "first_seen" => "初回取得",
            "changed" => "更新あり",
            "unchanged" => "変化なし",
            _ => EmptyText(value),
        };

    private static string PcUpdateStatusIcon(string? value) =>
        (value ?? "").Trim().ToLowerInvariant() switch
        {
            "changed" => "circle-check",
            "unchanged" => "circle-minus",
            _ => "circle-info",
        };

    private static string PcUpdateStatusPillClass(string? value) =>
        (value ?? "").Trim().ToLowerInvariant() switch
        {
            "first_seen" => "tfa-status-pill border-sky-200 bg-sky-50 text-sky-800",
            "changed" => "tfa-status-pill border-teal-200 bg-teal-50 text-teal-800",
            "unchanged" => "tfa-status-pill border-slate-200 bg-slate-50 text-slate-700",
            _ => "tfa-status-pill border-slate-200 bg-slate-50 text-slate-700",
        };
}
