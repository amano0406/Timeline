@page "/"
@page "/audio/files"
@inject TimelineHelperClient Timeline

<PageTitle>音声ファイル - Timeline</PageTitle>

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <div class="tfa-kicker">Audio files</div>
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="file-audio" Class="tfa-icon text-accent" />
            <span>音声ファイル</span>
        </h1>
        <p class="mt-2 max-w-3xl text-sm text-slate-600">
            入力ディレクトリにある音声を確認し、分析できているかをファイル単位で見ます。
        </p>
    </div>
    <button class="tfa-button-secondary gap-2" @onclick="LoadAsync" disabled="@_loading">
        <FaIcon Name="rotate" Class="@($"tfa-icon {(_loading ? "fa-spin" : "")}")" />
        <span>更新</span>
    </button>
</div>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_overview is not null && !_overview.HasToken)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="key" Class="tfa-icon mt-0.5" />
        <span>Hugging Face トークンが未設定です。設定画面で登録してから分析を開始してください。</span>
    </div>
}

@if (WorkerState.Equals("starting", StringComparison.OrdinalIgnoreCase))
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin mt-0.5" />
        <span>分析処理を起動しています。準備ができると待機中の分析を処理します。</span>
    </div>
}
else if (WorkerState.Equals("stopped", StringComparison.OrdinalIgnoreCase))
{
    <div class="tfa-alert-warn mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>分析処理が停止しています。Timelineを再起動してください。</span>
    </div>
}

<div class="grid gap-4 md:grid-cols-4">
    <section class="tfa-card tfa-card-pad">
        <div class="flex items-start justify-between gap-3">
            <div>
                <div class="tfa-kicker">音声ファイル</div>
                <div class="mt-2 text-3xl font-semibold">@FileCount</div>
            </div>
            <span class="tfa-icon-box">
                <FaIcon Name="file-audio" Class="tfa-icon" />
            </span>
        </div>
    </section>
    <section class="tfa-card tfa-card-pad">
        <div class="flex items-start justify-between gap-3">
            <div>
                <div class="tfa-kicker">処理済み</div>
                <div class="mt-2 text-3xl font-semibold">@CompletedCount</div>
            </div>
            <span class="tfa-icon-box text-teal-700">
                <FaIcon Name="circle-check" Class="tfa-icon" />
            </span>
        </div>
    </section>
    <section class="tfa-card tfa-card-pad">
        <div class="flex items-start justify-between gap-3">
            <div>
                <div class="tfa-kicker">未処理</div>
                <div class="mt-2 text-3xl font-semibold">@PendingCount</div>
            </div>
            <span class="tfa-icon-box text-amber-700">
                <FaIcon Name="clock" Class="tfa-icon" />
            </span>
        </div>
    </section>
    <section class="tfa-card tfa-card-pad">
        <div class="flex items-start justify-between gap-3">
            <div>
                <div class="tfa-kicker">分析処理</div>
                <div class="mt-2 text-2xl font-semibold">@WorkerStateLabel</div>
            </div>
            <span class="@($"tfa-icon-box {WorkerStateIconClass}")">
                <FaIcon Name="@WorkerStateIcon" Class="@($"tfa-icon {(WorkerWaiting ? "fa-spin" : "")}")" />
            </span>
        </div>
    </section>
</div>

<section class="tfa-card mt-5 overflow-hidden">
    <div class="tfa-card-pad flex flex-col gap-3 border-b border-line sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="flex items-center gap-2 text-lg font-semibold">
                <FaIcon Name="folder-open" Class="tfa-icon text-accent" />
                <span>入力ファイル一覧</span>
            </h2>
            <p class="mt-1 text-sm text-slate-600">ファイル名を開くと、音声と時間軸データを確認できます。</p>
        </div>
        <div class="flex items-center gap-2 text-sm text-slate-500">
            <FaIcon Name="@(_loading ? "spinner" : "clock")" Class="@($"tfa-icon {(_loading ? "fa-spin" : "")}")" />
            <span>@(_loading ? "読み込み中" : $"最終更新 {DateTime.Now:HH:mm:ss}")</span>
        </div>
    </div>

    @if (FileCount == 0 && !_loading)
    {
        <div class="p-5 text-sm text-slate-600">
            <div class="flex items-start gap-2">
                <FaIcon Name="folder-open" Class="tfa-icon mt-0.5 text-slate-400" />
                <span>音声ファイルは見つかりませんでした。設定画面で入力ディレクトリを確認してください。</span>
            </div>
        </div>
    }
    else
    {
        <div class="divide-y divide-line">
            @foreach (var rootGroup in RootGroups)
            {
                <section>
                    <div class="bg-slate-50 px-4 py-3">
                        <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                            <div class="flex items-center gap-2 font-semibold text-slate-800">
                                <FaIcon Name="folder" Class="tfa-icon text-slate-500" />
                                <span>@RootDisplayName(rootGroup.Key)</span>
                            </div>
                            <div class="break-all font-mono text-xs text-slate-500">@rootGroup.Key.RootPath</div>
                        </div>
                    </div>

                    @foreach (var directoryGroup in rootGroup.GroupBy(FileDirectory).OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <div class="border-t border-line">
                            <div class="flex items-center gap-2 px-4 py-2 text-xs font-semibold uppercase tracking-normal text-slate-500">
                                <FaIcon Name="folder-tree" Class="tfa-icon text-slate-400" />
                                <span>@(string.IsNullOrWhiteSpace(directoryGroup.Key) ? "ルート" : directoryGroup.Key)</span>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="tfa-table">
                                    <thead>
                                        <tr>
                                            <th>ファイル</th>
                                            <th>状態</th>
                                            <th>日時</th>
                                            <th>記録時間</th>
                                            <th>サイズ</th>
                                            <th>結果</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var file in directoryGroup.OrderBy(item => item.FileName, StringComparer.OrdinalIgnoreCase))
                                        {
                                            <tr>
                                                <td class="min-w-[320px]">
                                                    <a class="inline-flex items-center gap-2 font-medium text-accent underline" href="@DetailHref(file)">
                                                        <FaIcon Name="file-audio" Class="tfa-icon" />
                                                        <span>@file.FileName</span>
                                                    </a>
                                                    <div class="mt-1 break-all font-mono text-xs text-slate-500">@file.DisplayPath</div>
                                                </td>
                                                <td>
                                                    <span class="@StatusPill(file.Status)">
                                                        <FaIcon Name="@StatusIcon(file.Status)" Class="tfa-icon !h-3 !w-3" />
                                                        <span>@StatusLabel(file.Status)</span>
                                                    </span>
                                                </td>
                                                <td class="whitespace-nowrap">@UiFormat.ShortDate(file.ModifiedAt)</td>
                                                <td class="whitespace-nowrap">@DurationLabel(file.DurationSec)</td>
                                                <td class="whitespace-nowrap">@UiFormat.Bytes(file.SizeBytes)</td>
                                                <td class="whitespace-nowrap text-sm">
                                                    @if (file.HasTimeline)
                                                    {
                                                        <span class="inline-flex items-center gap-2">
                                                            <FaIcon Name="users" Class="tfa-icon text-slate-400" />
                                                            <span>@file.TurnCount 区間 / @file.SpeakerCount 話者</span>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-center gap-2 text-slate-500">
                                                            <FaIcon Name="circle-minus" Class="tfa-icon" />
                                                            <span>未作成</span>
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </section>
            }
        </div>
    }
</section>

@code {
    private sealed record RootKey(string SourceId, string SourceDisplayName, string RootPath);

    private TimelineProductOverview? _overview;
    private AudioFileListResult? _files;
    private bool _loading;
    private string? _error;

    private IReadOnlyList<AudioFileRow> Files => _files?.Files ?? [];
    private int FileCount => _files?.Total ?? Files.Count;
    private int CompletedCount => Files.Count(file => file.Status.Equals("completed", StringComparison.OrdinalIgnoreCase));
    private int PendingCount => Files.Count(file => !file.Status.Equals("completed", StringComparison.OrdinalIgnoreCase));
    private string WorkerState => _overview?.WorkerState ?? "checking";
    private bool WorkerWaiting => WorkerState.Equals("checking", StringComparison.OrdinalIgnoreCase) || WorkerState.Equals("starting", StringComparison.OrdinalIgnoreCase);

    private string WorkerStateLabel => WorkerState.ToLowerInvariant() switch
    {
        "running" => "稼働中",
        "checking" => "確認中",
        "starting" => "起動待ち",
        "stopped" => "停止中",
        _ => "未確認",
    };

    private string WorkerStateIcon => WorkerState.ToLowerInvariant() switch
    {
        "running" => "microchip",
        "checking" => "spinner",
        "starting" => "spinner",
        _ => "circle-minus",
    };

    private string WorkerStateIconClass => WorkerState.ToLowerInvariant() switch
    {
        "running" => "text-teal-700",
        "checking" => "text-sky-800",
        "starting" => "text-sky-800",
        _ => "text-slate-500",
    };

    private IEnumerable<IGrouping<RootKey, AudioFileRow>> RootGroups =>
        Files.GroupBy(file => new RootKey(file.SourceId, file.SourceDisplayName, file.RootPath))
            .OrderBy(group => RootDisplayName(group.Key), StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _overview = await Timeline.GetAudioOverviewAsync();
            _files = await Timeline.GetAudioFilesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string DetailHref(AudioFileRow file) =>
        "/audio/file-detail?sourceId=" + Uri.EscapeDataString(file.SourceId) + "&path=" + Uri.EscapeDataString(file.RelativePath);

    private static string DurationLabel(double? seconds) =>
        seconds is > 0 ? UiFormat.Duration(seconds.Value) : "-";

    private static string FileDirectory(AudioFileRow file)
    {
        if (!string.IsNullOrWhiteSpace(file.Directory))
        {
            return file.Directory;
        }

        var relativePath = (file.RelativePath ?? "").Replace('/', '\\');
        var index = relativePath.LastIndexOf('\\');
        return index > 0 ? relativePath[..index] : "";
    }

    private static string RootDisplayName(RootKey root) =>
        string.IsNullOrWhiteSpace(root.SourceDisplayName) ? root.SourceId : root.SourceDisplayName;

    private static string StatusLabel(string status) =>
        status.ToLowerInvariant() switch
        {
            "completed" => "処理済み",
            "queued" => "待機中",
            "processing" => "処理中",
            "changed" => "再処理必要",
            "settings_changed" => "設定変更あり",
            "failed" => "エラー",
            _ => "未処理",
        };

    private static string StatusPill(string status) =>
        status.ToLowerInvariant() switch
        {
            "completed" => "tfa-status-pill border-teal-200 bg-teal-50 text-teal-800",
            "queued" or "processing" => "tfa-status-pill border-sky-200 bg-sky-50 text-sky-800",
            "failed" => "tfa-status-pill border-red-200 bg-red-50 text-red-800",
            "changed" or "settings_changed" => "tfa-status-pill border-amber-200 bg-amber-50 text-amber-900",
            _ => "tfa-status-pill border-slate-200 bg-slate-50 text-slate-700",
        };

    private static string StatusIcon(string status) =>
        status.ToLowerInvariant() switch
        {
            "completed" => "circle-check",
            "queued" => "clock",
            "processing" => "spinner",
            "changed" or "settings_changed" => "triangle-exclamation",
            "failed" => "circle-xmark",
            _ => "circle-minus",
        };
}
