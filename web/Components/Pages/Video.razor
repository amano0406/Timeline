@page "/video"
@inject TimelineHelperClient Timeline

<PageTitle>動画ファイル一覧 - Timeline</PageTitle>

<TimelineBreadcrumbs>
    <a href="scan">スキャン</a>
    <span class="tfa-breadcrumb-separator">/</span>
    <span aria-current="page">動画ファイル一覧</span>
</TimelineBreadcrumbs>

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="video" Class="tfa-icon text-accent" />
            <span>動画ファイル一覧</span>
        </h1>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="tfa-button-secondary gap-2" @onclick="() => LoadAsync(forceRefresh: true)" disabled="@Busy">
            <FaIcon Name="rotate" Class="@($"tfa-icon {(_loading ? "fa-spin" : "")}")" />
            <span>一覧更新</span>
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_loading && _files is null)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else if (_files is not null || _overview is not null)
{
    @if (_overview is not null && !_overview.ProductFound)
    {
        <div class="tfa-alert-danger mb-5 flex items-start gap-2">
            <FaIcon Name="folder-open" Class="tfa-icon mt-0.5" />
            <span>TimelineForVideo が見つかりません。</span>
        </div>
    }
    else if (_overview is not null && !_overview.SettingsValid)
    {
        <div class="tfa-alert-warn mb-5 flex items-start gap-2">
            <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
            <span>@EmptyText(_overview.Message)</span>
        </div>
    }

    <div class="tfa-summary-grid">
        <section class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="tfa-kicker">取り込み済み</div>
                    <div class="mt-2 text-3xl font-semibold">@ImportedFileCountLabel</div>
                </div>
                <span class="tfa-icon-box">
                    <FaIcon Name="video" Class="tfa-icon" />
                </span>
            </div>
        </section>
        <section class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="tfa-kicker">言語化済み</div>
                    <div class="mt-2 text-3xl font-semibold">@VerbalizedFileCountLabel</div>
                </div>
                <span class="tfa-icon-box text-teal-700">
                    <FaIcon Name="language" Class="tfa-icon" />
                </span>
            </div>
        </section>
    </div>

    <section class="tfa-card tfa-list-card mt-5 overflow-hidden">
        <div class="tfa-card-pad flex flex-col gap-3 border-b border-line sm:flex-row sm:items-center sm:justify-between">
            <h2 class="flex items-center gap-2 text-lg font-semibold">
                <FaIcon Name="folder-open" Class="tfa-icon text-accent" />
                <span>アイテム一覧</span>
            </h2>
            <div class="flex items-center gap-2 text-sm text-slate-500">
                <FaIcon Name="@(ListBusy ? "spinner" : "clock")" Class="@($"tfa-icon {(ListBusy ? "fa-spin" : "")}")" />
                <span>@FileListStatusLabel</span>
            </div>
        </div>

        @if (FileCount == 0 && !_loading)
        {
            <div class="p-5 text-sm text-slate-600">
                <div class="flex items-start gap-2">
                    <FaIcon Name="folder-open" Class="tfa-icon mt-0.5 text-slate-400" />
                    <span>動画ファイルは見つかりませんでした。設定で入力ディレクトリを確認してください。</span>
                </div>
            </div>
        }
        else
        {
            <div class="overflow-x-auto tfa-long-list-scroll tfa-list-scroll">
                <div class="tfa-file-tree tfa-file-tree-video" role="treegrid" aria-label="動画アイテム一覧">
                    <div class="tfa-file-tree-header" role="row">
                        <div class="tfa-file-tree-select" role="columnheader"></div>
                        <div role="columnheader">名前</div>
                        <div role="columnheader">状態</div>
                        <div role="columnheader">日時</div>
                        <div role="columnheader">記録時間</div>
                        <div role="columnheader">サイズ</div>
                        <div role="columnheader">生成物</div>
                    </div>

                    @foreach (var row in BuildTreeRows(Files))
                    {
                        <div class="@TreeRowClass(row)" role="row">
                            <div class="tfa-file-tree-select" role="gridcell"></div>
                            <div class="tfa-file-tree-name" role="gridcell">
                                <span class="tfa-file-tree-indent" style="@TreeIndentStyle(row.Depth)"></span>
                                <FaIcon Name="@(row.File is null ? "folder" : "video")"
                                        Class="@($"tfa-icon {(row.File is null ? "text-slate-500" : "text-accent")}")" />
                                @if (row.File is null)
                                {
                                    <span class="tfa-file-tree-directory-name">@row.Name</span>
                                }
                                else
                                {
                                    <a class="tfa-file-tree-file-name" href="@VideoDetailUrl(row.File)">
                                        @row.Name
                                    </a>
                                }
                            </div>

                            @if (row.File is null)
                            {
                                <div role="gridcell"></div>
                                <div role="gridcell"></div>
                                <div role="gridcell"></div>
                                <div role="gridcell"></div>
                                <div role="gridcell"></div>
                            }
                            else
                            {
                                var file = row.File;
                                <div class="tfa-file-tree-meta" role="gridcell">
                                    <span class="@StatusPill(file.Status)">
                                        <FaIcon Name="@StatusIcon(file.Status)" Class="tfa-icon !h-3 !w-3" />
                                        <span>@StatusLabel(file.Status)</span>
                                    </span>
                                </div>
                                <div class="tfa-file-tree-meta" role="gridcell">@UiFormat.ShortDate(file.ModifiedAt)</div>
                                <div class="tfa-file-tree-meta" role="gridcell">@DurationLabel(file.DurationSec)</div>
                                <div class="tfa-file-tree-meta" role="gridcell">@UiFormat.Bytes(file.SizeBytes)</div>
                                <div class="tfa-file-tree-meta" role="gridcell">
                                    <div class="flex flex-col items-end gap-1">
                                        <span class="@(file.HasTimeline ? "tfa-file-tree-result" : "tfa-file-tree-result tfa-file-tree-result-muted")">
                                            <FaIcon Name="file-lines" Class="tfa-icon text-teal-700" />
                                            <span>@ArtifactLabel(file)</span>
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <PaginationControls CurrentPage="@_currentPage"
                                PageSize="@PageSize"
                                TotalItems="@ListTotalItems"
                                Disabled="@Busy"
                                Label="動画ファイル一覧のページ移動"
                                PageChanged="ChangePageAsync" />
        }
    </section>
}
