            || run.State.Equals("processing", StringComparison.OrdinalIgnoreCase)
            || run.State.Equals("pending", StringComparison.OrdinalIgnoreCase)
            || run.State.Equals("queued", StringComparison.OrdinalIgnoreCase)
        );

