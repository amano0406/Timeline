@page "/audio/files"
@inject TimelineHelperClient Timeline
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>音声ファイル一覧 - Timeline</PageTitle>

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="file-audio" Class="tfa-icon text-accent" />
            <span>音声ファイル一覧</span>
        </h1>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="tfa-button-secondary gap-2" @onclick="LoadAsync" disabled="@(ListBusy || _refreshing)">
            <FaIcon Name="rotate" Class="@($"tfa-icon {(ListBusy ? "fa-spin" : "")}")" />
            <span>一覧更新</span>
        </button>
        <button class="tfa-button-primary gap-2" @onclick="StartAudioRefreshAsync" disabled="@(ListBusy || _refreshing || _deleting || _downloading)">
            <FaIcon Name="@(_refreshing ? "spinner" : "play")" Class="@($"tfa-icon {(_refreshing ? "fa-spin" : "")}")" />
            <span>@(_refreshing ? "分析開始中" : "再スキャンして分析")</span>
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_overview is not null && !_overview.HasToken)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="key" Class="tfa-icon mt-0.5" />
        <span>Hugging Face トークンが未設定です。設定画面で登録してから分析を開始してください。</span>
    </div>
}

@if (WorkerState.Equals("starting", StringComparison.OrdinalIgnoreCase) && ActiveRun is null)
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin mt-0.5" />
        <span>分析処理を起動しています。準備ができると待機中の分析を処理します。</span>
    </div>
}
else if (WorkerState.Equals("stopped", StringComparison.OrdinalIgnoreCase))
{
    <div class="tfa-alert-warn mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>分析処理が停止しています。Timelineを再起動してください。</span>
    </div>
}

@if (_operationMessage is not null)
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="circle-info" Class="tfa-icon mt-0.5" />
        <span>@_operationMessage</span>
    </div>
}

@if (_loading && _files is null)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else
{
    @if (ActiveRun is not null)
    {
        <section class="tfa-card tfa-run-progress">
            <div class="tfa-run-progress-head">
                <div class="tfa-run-progress-summary">
                    <div class="tfa-run-progress-title">
                        <span class="tfa-icon-box text-sky-800">
                            <FaIcon Name="spinner" Class="tfa-icon fa-spin" />
                        </span>
                        <div class="tfa-run-progress-title-text">
                            <h2>分析の進捗</h2>
                            <div class="tfa-run-progress-meta">
                                <span class="@RunStatePill(ActiveRun.State)">@RunStateLabel(ActiveRun.State)</span>
                                @if (ShouldShowStage(ActiveRun))
                                {
                                    <span class="tfa-status-pill border-slate-200 bg-white text-slate-700">@StageLabel(ActiveRun.CurrentStage)</span>
                                }
                                <span class="tfa-run-progress-id">実行ID: @ActiveRun.RunId</span>
                                @if (!string.IsNullOrWhiteSpace(ActiveRun.CurrentItem))
                                {
                                    <span class="tfa-run-progress-current-inline">処理中ファイル: @ActiveRun.CurrentItem</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="tfa-run-progress-rate">
                        <div class="tfa-run-progress-percent">@ProgressLabel(ActiveRun.ProgressPercent)</div>
                        <div class="tfa-run-progress-count">@ActiveRun.ItemsDone / @ActiveRun.ItemsTotal 件</div>
                    </div>
                </div>

                <div class="tfa-run-progress-bar-track"
                     role="progressbar"
                     aria-label="分析の進捗"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@ProgressAriaValue(ActiveRun.ProgressPercent)">
                    <div class="tfa-run-progress-bar" style="@ProgressBarStyle(ActiveRun.ProgressPercent)"></div>
                </div>
            </div>

            <div class="tfa-run-progress-body">
                <div class="tfa-run-progress-actions">
                    <button type="button"
                            class="tfa-run-progress-toggle"
                            @onclick="ToggleRunDetails"
                            aria-expanded="@_runDetailsOpen">
                        <FaIcon Name="@(_runDetailsOpen ? "chevron-up" : "chevron-down")" Class="tfa-icon !h-3 !w-3" />
                        <span>@(_runDetailsOpen ? "詳細を閉じる" : "詳細を表示")</span>
                    </button>
                </div>

                @if (_runDetailsOpen)
                {
                    <div class="tfa-run-metrics">
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">失敗</div>
                            <div>@ActiveRun.ItemsFailed 件</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">スキップ</div>
                            <div>@ActiveRun.ItemsSkipped 件</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">処理済み時間</div>
                            <div>@RunDurationLabel(ActiveRun.ProcessedDurationSec)</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">残り目安</div>
                            <div>@RunDurationLabel(ActiveRun.EstimatedRemainingSec)</div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <div class="grid gap-4 md:grid-cols-4">
        <section class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="tfa-kicker">総ファイル数</div>
                    <div class="mt-2 text-3xl font-semibold">@FileCount</div>
                </div>
                <span class="tfa-icon-box">
                    <FaIcon Name="file-audio" Class="tfa-icon" />
                </span>
            </div>
        </section>
        <section class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="tfa-kicker">表示中未処理</div>
                    <div class="mt-2 text-3xl font-semibold">@UnprocessedCount</div>
                </div>
                <span class="tfa-icon-box text-slate-600">
                    <FaIcon Name="circle-minus" Class="tfa-icon" />
                </span>
            </div>
        </section>
        <section class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="tfa-kicker">表示中記録時間</div>
                    <div class="mt-2 text-2xl font-semibold">@TotalDurationLabel</div>
                    @if (HasPartialDuration)
                    {
                        <div class="mt-1 text-xs text-slate-500">@KnownDurationCount / @Files.Count 件</div>
                    }
                </div>
                <span class="tfa-icon-box text-sky-800">
                    <FaIcon Name="stopwatch" Class="tfa-icon" />
                </span>
            </div>
        </section>
        <section class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="tfa-kicker">処理ステータス</div>
                    <div class="mt-2 text-2xl font-semibold">@WorkerStateLabel</div>
                </div>
                <span class="@($"tfa-icon-box {WorkerStateIconClass}")">
                    <FaIcon Name="@WorkerStateIcon" Class="@($"tfa-icon {(WorkerWaiting ? "fa-spin" : "")}")" />
                </span>
            </div>
        </section>
    </div>

    <section class="tfa-card mt-5 overflow-hidden">
    <div class="tfa-card-pad flex flex-col gap-3 border-b border-line sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="flex items-center gap-2 text-lg font-semibold">
                <FaIcon Name="folder-open" Class="tfa-icon text-accent" />
                <span>ファイル一覧</span>
            </h2>
        </div>
        <div class="flex items-center gap-2 text-sm text-slate-500">
            <FaIcon Name="@(ListBusy ? "spinner" : "clock")" Class="@($"tfa-icon {(ListBusy ? "fa-spin" : "")}")" />
            <span>@FileListStatusLabel</span>
        </div>
    </div>

    @if (FileCount == 0 && !_loading)
    {
        <div class="p-5 text-sm text-slate-600">
            <div class="flex items-start gap-2">
                <FaIcon Name="folder-open" Class="tfa-icon mt-0.5 text-slate-400" />
                <span>音声ファイルは見つかりませんでした。設定画面で入力ディレクトリを確認してください。</span>
            </div>
        </div>
    }
    else
    {
        <div class="tfa-file-actionbar">
            <div class="tfa-file-actionbar-count">
                <FaIcon Name="check-square" Class="tfa-icon text-slate-500" />
                <span>@SelectionSummary</span>
            </div>
            <div class="tfa-file-actionbar-actions">
                <button class="tfa-button-secondary gap-2" @onclick="OpenDeleteModal" disabled="@(ListBusy || !HasGeneratedItemSelection || _deleting || _downloading)">
                    <FaIcon Name="trash-can" Class="tfa-icon" />
                    <span>生成物を削除</span>
                </button>
                <button class="tfa-button-secondary gap-2" @onclick="DownloadSelectedAsync" disabled="@(ListBusy || !HasGeneratedItemSelection || _deleting || _downloading)">
                    <FaIcon Name="@(_downloading ? "spinner" : "download")" Class="@($"tfa-icon {(_downloading ? "fa-spin" : "")}")" />
                    <span>ダウンロード</span>
                </button>
                <button class="tfa-button-secondary gap-2" @onclick="DownloadAllAsync" disabled="@(_loading || FileCount == 0 || _deleting || _downloading)">
                    <FaIcon Name="@(_downloading ? "spinner" : "download")" Class="@($"tfa-icon {(_downloading ? "fa-spin" : "")}")" />
                    <span>すべてダウンロード</span>
                </button>
                <button class="tfa-button-secondary gap-2" @onclick="ClearSelection" disabled="@(ListBusy || !HasSelection || _deleting || _downloading)">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>選択解除</span>
                </button>
            </div>
        </div>

        <div class="overflow-x-auto">
            <div class="tfa-file-tree" role="treegrid" aria-label="ファイル一覧">
                <div class="tfa-file-tree-header" role="row">
                    <div class="tfa-file-tree-select" role="columnheader">
                        <input type="checkbox"
                               checked="@AllVisibleSelected"
                               @onchange="ToggleAllVisible"
                               disabled="@ListBusy"
                               aria-label="すべて選択" />
                    </div>
                    <div role="columnheader">名前</div>
                    <div role="columnheader">状態</div>
                    <div role="columnheader">日時</div>
                    <div role="columnheader">記録時間</div>
                    <div role="columnheader">サイズ</div>
                    <div role="columnheader">生成物</div>
                </div>

                @foreach (var row in BuildTreeRows(Files))
                {
                    <div class="@TreeRowClass(row)" role="row">
                        <div class="tfa-file-tree-select" role="gridcell">
                            <span class="tfa-file-tree-check">
                                <input type="checkbox"
                                       checked="@IsTreeRowSelected(row)"
                                       @onchange="(args) => ToggleTreeRow(row, IsChecked(args))"
                                       disabled="@(ListBusy || row.FileKeys.Count == 0)"
                                       aria-label="@SelectionLabel(row)" />
                                @if (IsTreeRowPartiallySelected(row))
                                {
                                    <span class="tfa-file-tree-check-partial"></span>
                                }
                            </span>
                        </div>

                        <div class="tfa-file-tree-name" role="gridcell">
                            <span class="tfa-file-tree-indent" style="@TreeIndentStyle(row.Depth)"></span>
                            <FaIcon Name="@(row.File is null ? "folder" : "file-audio")"
                                    Class="@($"tfa-icon {(row.File is null ? "text-slate-500" : "text-accent")}")" />
                            @if (row.File is null)
                            {
                                <span class="tfa-file-tree-directory-name">@row.Name</span>
                            }
                            else
                            {
                                <a class="tfa-file-tree-file-name" href="@DetailHref(row.File)">
                                    @row.Name
                                </a>
                            }
                        </div>

                        @if (row.File is null)
                        {
                            <div role="gridcell"></div>
                            <div role="gridcell"></div>
                            <div role="gridcell"></div>
                            <div role="gridcell"></div>
                            <div role="gridcell"></div>
                        }
                        else
                        {
                            var file = row.File;
                            <div class="tfa-file-tree-meta" role="gridcell">
                                <span class="@StatusPill(file.Status)">
                                    <FaIcon Name="@StatusIcon(file.Status)" Class="tfa-icon !h-3 !w-3" />
                                    <span>@StatusLabel(file.Status)</span>
                                </span>
                            </div>
                            <div class="tfa-file-tree-meta" role="gridcell">@UiFormat.ShortDate(file.ModifiedAt)</div>
                            <div class="tfa-file-tree-meta" role="gridcell">@DurationLabel(file.DurationSec)</div>
                            <div class="tfa-file-tree-meta" role="gridcell">@UiFormat.Bytes(file.SizeBytes)</div>
                            <div class="tfa-file-tree-meta" role="gridcell">
                                <div class="flex flex-col items-end gap-1">
                                    @if (file.HasTimeline && HasGeneratedItem(file))
                                    {
                                        <span class="tfa-file-tree-result">
                                            <FaIcon Name="file-lines" Class="tfa-icon text-teal-700" />
                                            <span>@ArtifactLabel(file)</span>
                                        </span>
                                    }
                                    else if (file.HasTimeline)
                                    {
                                        <span class="tfa-file-tree-result tfa-file-tree-result-muted">
                                            <FaIcon Name="spinner" Class="tfa-icon" />
                                            <span>分析中</span>
                                        </span>
                                    }
                                    else if (file.HasAudio)
                                    {
                                        <span class="tfa-file-tree-result tfa-file-tree-result-muted">
                                            <FaIcon Name="file-audio" Class="tfa-icon" />
                                            <span>@(IsProcessingStatus(file.Status) ? "分析中" : "音声あり")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tfa-file-tree-result tfa-file-tree-result-muted">
                                            <FaIcon Name="circle-minus" Class="tfa-icon" />
                                            <span>未作成</span>
                                        </span>
                                    }

                                    @if (ShouldShowVerbalizationStatus(file))
                                    {
                                        <span class="@VerbalizationPill(file.AudioVerbalization.State)">
                                            <FaIcon Name="@VerbalizationIcon(file.AudioVerbalization.State)" Class="@($"tfa-icon !h-3 !w-3 {VerbalizationIconSpin(file.AudioVerbalization.State)}")" />
                                            <span>@VerbalizationLabel(file.AudioVerbalization)</span>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <PaginationControls CurrentPage="@_currentFilePage"
                            PageSize="@FilePageSize"
                            TotalItems="@FileTotalItems"
                            Disabled="@ListBusy"
                            Label="音声ファイル一覧のページ移動"
                            PageChanged="ChangeFilePageAsync" />
    }
    </section>
}

@if (_deleteModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4">
        <section class="w-full max-w-xl rounded-md bg-white shadow-xl">
            <div class="border-b border-line p-5">
                <h2 class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="trash-can" Class="tfa-icon text-danger" />
                    <span>生成物を削除</span>
                </h2>
            </div>
            <div class="p-5 text-sm text-slate-700">
                <p>選択中のうち @SelectedGeneratedItemCount 件の操作可能な生成物を削除します。</p>
                <p class="mt-2 text-slate-500">元の音声ファイルは削除しません。</p>
            </div>
            <div class="flex flex-wrap justify-end gap-2 border-t border-line p-4">
                <button class="tfa-button-secondary gap-2" @onclick="CloseDeleteModal" disabled="@_deleting">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>キャンセル</span>
                </button>
                <button class="tfa-button-primary gap-2" @onclick="ConfirmDeleteSelectedAsync" disabled="@_deleting">
                    <FaIcon Name="@(_deleting ? "spinner" : "trash-can")" Class="@($"tfa-icon {(_deleting ? "fa-spin" : "")}")" />
                    <span>削除</span>
                </button>
            </div>
        </section>
    </div>
}

@code {
    private sealed class FileTreeDirectory
    {
        private readonly Dictionary<string, FileTreeDirectory> _directories = new(StringComparer.OrdinalIgnoreCase);

        public FileTreeDirectory(string name)
        {
            Name = name;
        }

        public string Name { get; }
        public IReadOnlyCollection<FileTreeDirectory> Directories => _directories.Values;
        public List<AudioFileRow> Files { get; } = [];

        public FileTreeDirectory GetOrAddDirectory(string name)
        {
            if (!_directories.TryGetValue(name, out var directory))
            {
                directory = new FileTreeDirectory(name);
                _directories.Add(name, directory);
            }

            return directory;
        }
    }

    private sealed record FileTreeRow(string Name, int Depth, AudioFileRow? File, IReadOnlyList<string> FileKeys);

    private const int FilePageSize = 100;

    private TimelineProductOverview? _overview;
    private AudioFileListResult? _files;
    private readonly HashSet<string> _selectedFileKeys = new(StringComparer.OrdinalIgnoreCase);
    private bool _loading = true;
    private bool _refreshing;
    private bool _downloading;
    private bool _deleting;
    private bool _pollingOverview;
    private bool _loadingMoreFiles;
    private bool _deleteModalOpen;
    private bool _runDetailsOpen;
    private bool _disposed;
    private int _currentFilePage = 1;
    private DateTime? _lastLoadedAt;
    private CancellationTokenSource? _pollingCts;
    private string? _error;
    private string? _operationMessage;

    private IReadOnlyList<AudioFileRow> Files => _files?.Files ?? [];
    private int FileCount => _files?.Total ?? Files.Count;
    private int LoadedFileCount => Files.Count;
    private bool ListBusy => _loading || _loadingMoreFiles;
    private int FileTotalItems => _files?.Pagination.TotalItems > 0
        ? _files.Pagination.TotalItems
        : FileCount;
    private string FileListStatusLabel => ListBusy
        ? "読み込み中"
        : _lastLoadedAt is null
            ? ""
            : $"最終更新 {_lastLoadedAt.Value:HH:mm:ss}";
    private int UnprocessedCount => Files.Count(file => !file.Status.Equals("completed", StringComparison.OrdinalIgnoreCase));
    private int KnownDurationCount => Files.Count(file => file.DurationSec is > 0);
    private double TotalDurationSec => Files.Where(file => file.DurationSec is > 0).Sum(file => file.DurationSec!.Value);
    private string TotalDurationLabel => TotalDurationSec > 0 ? UiFormat.Duration(TotalDurationSec) : "未取得";
    private bool HasPartialDuration => Files.Count > 0 && KnownDurationCount > 0 && KnownDurationCount < Files.Count;
    private int SelectedFileCount => _selectedFileKeys.Count;
    private bool HasSelection => SelectedFileCount > 0;
    private int SelectedGeneratedItemCount => SelectedGeneratedItemIds().Count;
    private bool HasGeneratedItemSelection => SelectedGeneratedItemCount > 0;
    private bool AllVisibleSelected => Files.Count > 0 && Files.All(file => _selectedFileKeys.Contains(FileKey(file)));
    private string SelectionSummary =>
        HasSelection
            ? $"{SelectedFileCount} 件選択中 / 操作可能な生成物 {SelectedGeneratedItemCount} 件"
            : "未選択";
    private string WorkerState => _overview?.WorkerState ?? "checking";
    private AudioRunProgress? ActiveRun => IsActiveRun(_overview?.ActiveRun) ? _overview?.ActiveRun : null;
    private bool WorkerWaiting =>
        WorkerState.Equals("checking", StringComparison.OrdinalIgnoreCase)
        || WorkerState.Equals("starting", StringComparison.OrdinalIgnoreCase)
        || WorkerState.Equals("processing", StringComparison.OrdinalIgnoreCase);

    private string WorkerStateLabel => WorkerState.ToLowerInvariant() switch
    {
        "processing" => "分析中",
        "running" => "待機中",
        "checking" => "確認中",
        "starting" => "起動待ち",
        "stopped" => "停止中",
        _ => "未確認",
    };

    private string WorkerStateIcon => WorkerState.ToLowerInvariant() switch
    {
        "processing" => "spinner",
        "running" => "microchip",
        "checking" => "spinner",
        "starting" => "spinner",
        _ => "circle-minus",
    };

    private string WorkerStateIconClass => WorkerState.ToLowerInvariant() switch
    {
        "processing" => "text-sky-800",
        "running" => "text-teal-700",
        "checking" => "text-sky-800",
        "starting" => "text-sky-800",
        _ => "text-slate-500",
    };

    protected override void OnInitialized()
    {
        _pollingCts = new CancellationTokenSource();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _pollingCts is null || _disposed)
        {
            return;
        }

        await LoadAsync();
        if (_disposed || _pollingCts is null)
        {
            return;
        }
        _ = PollActiveRunAsync(_pollingCts.Token);
    }

    private async Task LoadAsync()
    {
        _loading = true;
            _error = null;
        try
        {
            _overview = await Timeline.GetAudioOverviewAsync();
            _files = new AudioFileListResult();
            _currentFilePage = 1;
            await InvokeAsync(StateHasChanged);
            await LoadFilePageAsync(1, reset: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadFilePageAsync(int page, bool reset)
    {
        var result = await Timeline.GetAudioFilesAsync(page, FilePageSize);
        _files = result;

        _lastLoadedAt = DateTime.Now;
        _currentFilePage = Math.Max(1, result.Pagination.Page);
        RemoveMissingSelections();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ChangeFilePageAsync(int page)
    {
        if (page == _currentFilePage || _loadingMoreFiles)
        {
            return;
        }

        _loadingMoreFiles = true;
        _error = null;
        try
        {
            await LoadFilePageAsync(page, reset: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingMoreFiles = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PollActiveRunAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(5), cancellationToken);
                if (ShouldPollRunProgress)
                {
                    await InvokeAsync(RefreshOverviewForPollingAsync);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private bool ShouldPollRunProgress =>
        IsActiveRun(_overview?.ActiveRun)
        || WorkerState.Equals("processing", StringComparison.OrdinalIgnoreCase)
        || WorkerState.Equals("starting", StringComparison.OrdinalIgnoreCase);

    private async Task RefreshOverviewForPollingAsync()
    {
        if (_pollingOverview || _loading || _refreshing || _deleting || _downloading)
        {
            return;
        }

        _pollingOverview = true;
        var hadActiveRun = IsActiveRun(_overview?.ActiveRun);
        try
        {
            _overview = await Timeline.GetAudioOverviewAsync();
            if (hadActiveRun && !IsActiveRun(_overview.ActiveRun))
            {
                await LoadFilePageAsync(_currentFilePage, reset: true);
            }
        }
        catch (Exception ex)
        {
            _error ??= ex.Message;
        }
        finally
        {
            _pollingOverview = false;
            StateHasChanged();
        }
    }

    private async Task StartAudioRefreshAsync()
    {
        _refreshing = true;
        _error = null;
        _operationMessage = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await Timeline.RefreshAudioAsync(new AudioRefreshRequest
            {
                QueueOnly = true,
            });
            _operationMessage = RefreshMessage(result);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _refreshing = false;
        }
    }

