@page "/audio/files"
@inject TimelineHelperClient Timeline
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>音声ファイル一覧 - Timeline</PageTitle>

<TimelineBreadcrumbs>
    <a href="scan">スキャン</a>
    <span class="tfa-breadcrumb-separator">/</span>
    <span aria-current="page">音声ファイル一覧</span>
</TimelineBreadcrumbs>

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="file-audio" Class="tfa-icon text-accent" />
            <span>音声ファイル一覧</span>
        </h1>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="tfa-button-secondary gap-2" @onclick="LoadAsync" disabled="@(ListBusy || _refreshing)">
            <FaIcon Name="rotate" Class="@($"tfa-icon {(ListBusy ? "fa-spin" : "")}")" />
            <span>一覧更新</span>
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_overview is not null && !_overview.HasToken)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="key" Class="tfa-icon mt-0.5" />
        <span>Hugging Face トークンが未設定です。設定画面で登録してから分析を開始してください。</span>
    </div>
}

@if (WorkerState.Equals("starting", StringComparison.OrdinalIgnoreCase) && ActiveRun is null)
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin mt-0.5" />
        <span>分析処理を起動しています。準備ができると待機中の分析を処理します。</span>
    </div>
}
else if (WorkerState.Equals("stopped", StringComparison.OrdinalIgnoreCase))
{
    <div class="tfa-alert-warn mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>分析処理が停止しています。Timelineを再起動してください。</span>
    </div>
}

@if (_operationMessage is not null)
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="circle-info" Class="tfa-icon mt-0.5" />
        <span>@_operationMessage</span>
    </div>
}

@if (_loading && _files is null)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else
{
    @if (ActiveRun is not null)
    {
        <section class="tfa-card tfa-run-progress">
            <div class="tfa-run-progress-head">
                <div class="tfa-run-progress-summary">
                    <div class="tfa-run-progress-title">
                        <span class="tfa-icon-box text-sky-800">
                            <FaIcon Name="spinner" Class="tfa-icon fa-spin" />
                        </span>
                        <div class="tfa-run-progress-title-text">
                            <h2>分析の進捗</h2>
                            <div class="tfa-run-progress-meta">
                                <span class="@RunStatePill(ActiveRun.State)">@RunStateLabel(ActiveRun.State)</span>
                                @if (ShouldShowStage(ActiveRun))
                                {
                                    <span class="tfa-status-pill border-slate-200 bg-white text-slate-700">@StageLabel(ActiveRun.CurrentStage)</span>
                                }
                                <span class="tfa-run-progress-id">実行ID: @ActiveRun.RunId</span>
                                @if (!string.IsNullOrWhiteSpace(ActiveRun.CurrentItem))
                                {
                                    <span class="tfa-run-progress-current-inline">処理中ファイル: @ActiveRun.CurrentItem</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="tfa-run-progress-rate">
                        <div class="tfa-run-progress-percent">@ProgressLabel(ActiveRun.ProgressPercent)</div>
                        <div class="tfa-run-progress-count">@ActiveRun.ItemsDone / @ActiveRun.ItemsTotal 件</div>
                    </div>
                </div>

                <div class="tfa-run-progress-bar-track"
                     role="progressbar"
                     aria-label="分析の進捗"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@ProgressAriaValue(ActiveRun.ProgressPercent)">
                    <div class="tfa-run-progress-bar" style="@ProgressBarStyle(ActiveRun.ProgressPercent)"></div>
                </div>
            </div>

            <div class="tfa-run-progress-body">
                <div class="tfa-run-progress-actions">
                    <button type="button"
                            class="tfa-run-progress-toggle"
                            @onclick="ToggleRunDetails"
                            aria-expanded="@_runDetailsOpen">
                        <FaIcon Name="@(_runDetailsOpen ? "chevron-up" : "chevron-down")" Class="tfa-icon !h-3 !w-3" />
                        <span>@(_runDetailsOpen ? "詳細を閉じる" : "詳細を表示")</span>
                    </button>
                </div>

                @if (_runDetailsOpen)
                {
                    <div class="tfa-run-metrics">
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">失敗</div>
                            <div>@ActiveRun.ItemsFailed 件</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">スキップ</div>
                            <div>@ActiveRun.ItemsSkipped 件</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">処理済み時間</div>
                            <div>@RunDurationLabel(ActiveRun.ProcessedDurationSec)</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">残り目安</div>
                            <div>@RunDurationLabel(ActiveRun.EstimatedRemainingSec)</div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <div class="tfa-summary-grid">
        <section class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="tfa-kicker">取り込み済み</div>
                    <div class="mt-2 text-3xl font-semibold">@ImportedFileCountLabel</div>
                </div>
                <span class="tfa-icon-box">
                    <FaIcon Name="file-audio" Class="tfa-icon" />
                </span>
            </div>
        </section>
        <section class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="tfa-kicker">言語化済み</div>
                    <div class="mt-2 text-3xl font-semibold">@VerbalizedFileCountLabel</div>
                </div>
                <span class="tfa-icon-box text-teal-700">
                    <FaIcon Name="language" Class="tfa-icon" />
                </span>
            </div>
        </section>
    </div>

    <section class="tfa-card tfa-list-card mt-5 overflow-hidden">
    <div class="tfa-card-pad flex flex-col gap-3 border-b border-line sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="flex items-center gap-2 text-lg font-semibold">
                <FaIcon Name="folder-open" Class="tfa-icon text-accent" />
                <span>アイテム一覧</span>
            </h2>
        </div>
        <div class="flex items-center gap-2 text-sm text-slate-500">
            <FaIcon Name="@(ListBusy ? "spinner" : "clock")" Class="@($"tfa-icon {(ListBusy ? "fa-spin" : "")}")" />
            <span>@FileListStatusLabel</span>
        </div>
    </div>

    @if (FileCount == 0 && !_loading)
    {
        <div class="p-5 text-sm text-slate-600">
            <div class="flex items-start gap-2">
                <FaIcon Name="folder-open" Class="tfa-icon mt-0.5 text-slate-400" />
                <span>音声ファイルは見つかりませんでした。設定画面で入力ディレクトリを確認してください。</span>
            </div>
        </div>
    }
    else
    {
        <div class="tfa-file-actionbar">
            <div class="tfa-file-actionbar-count">
                <FaIcon Name="check-square" Class="tfa-icon text-slate-500" />
                <span>@SelectionSummary</span>
            </div>
            <div class="tfa-file-actionbar-actions">
                <button class="tfa-button-secondary gap-2" @onclick="OpenDeleteModal" disabled="@(ListBusy || !HasGeneratedItemSelection || _deleting || _downloading)">
                    <FaIcon Name="trash-can" Class="tfa-icon" />
                    <span>生成物を削除</span>
                </button>
                <button class="tfa-button-secondary gap-2" @onclick="DownloadSelectedAsync" disabled="@(ListBusy || !HasGeneratedItemSelection || _deleting || _downloading)">
                    <FaIcon Name="@(_downloading ? "spinner" : "download")" Class="@($"tfa-icon {(_downloading ? "fa-spin" : "")}")" />
                    <span>ダウンロード</span>
                </button>
                <button class="tfa-button-secondary gap-2" @onclick="DownloadAllAsync" disabled="@(_loading || FileCount == 0 || _deleting || _downloading)">
                    <FaIcon Name="@(_downloading ? "spinner" : "download")" Class="@($"tfa-icon {(_downloading ? "fa-spin" : "")}")" />
                    <span>すべてダウンロード</span>
                </button>
                <button class="tfa-button-secondary gap-2" @onclick="ClearSelection" disabled="@(ListBusy || !HasSelection || _deleting || _downloading)">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>選択解除</span>
                </button>
            </div>
        </div>

        <div class="overflow-x-auto tfa-long-list-scroll tfa-list-scroll">
            <div class="tfa-file-tree" role="treegrid" aria-label="音声アイテム一覧">
                <div class="tfa-file-tree-header" role="row">
                    <div class="tfa-file-tree-select" role="columnheader">
                        <input type="checkbox"
                               checked="@AllVisibleSelected"
                               @onchange="ToggleAllVisible"
                               disabled="@ListBusy"
                               aria-label="すべて選択" />
                    </div>
                    <div role="columnheader">名前</div>
                    <div role="columnheader">状態</div>
                    <div role="columnheader">日時</div>
                    <div role="columnheader">記録時間</div>
                    <div role="columnheader">サイズ</div>
                    <div role="columnheader">文字数</div>
                    <div role="columnheader">言語化</div>
                    <div role="columnheader">概要生成</div>
                </div>

                @foreach (var row in BuildTreeRows(Files))
                {
                    <div class="@TreeRowClass(row)" role="row">
                        <div class="tfa-file-tree-select" role="gridcell">
                            <span class="tfa-file-tree-check">
                                <input type="checkbox"
                                       checked="@IsTreeRowSelected(row)"
                                       @onchange="(args) => ToggleTreeRow(row, IsChecked(args))"
                                       disabled="@(ListBusy || row.FileKeys.Count == 0)"
                                       aria-label="@SelectionLabel(row)" />
                                @if (IsTreeRowPartiallySelected(row))
                                {
                                    <span class="tfa-file-tree-check-partial"></span>
                                }
                            </span>
                        </div>

                        <div class="tfa-file-tree-name" role="gridcell">
                            <span class="tfa-file-tree-indent" style="@TreeIndentStyle(row.Depth)"></span>
                            <FaIcon Name="@(row.File is null ? "folder" : "file-audio")"
                                    Class="@($"tfa-icon {(row.File is null ? "text-slate-500" : "text-accent")}")" />
                            @if (row.File is null)
                            {
                                <span class="tfa-file-tree-directory-name">@row.Name</span>
                            }
                            else
                            {
                                <a class="tfa-file-tree-file-name" href="@DetailHref(row.File)">
                                    @row.Name
                                </a>
                            }
                        </div>

                        @if (row.File is null)
                        {
                            <div role="gridcell"></div>
                            <div role="gridcell"></div>
                            <div role="gridcell"></div>
                            <div role="gridcell"></div>
                            <div role="gridcell"></div>
                            <div role="gridcell"></div>
                            <div role="gridcell"></div>
                        }
                        else
                        {
                            var file = row.File;
                            <div class="tfa-file-tree-meta" role="gridcell">
                                <span class="@StatusPill(file.Status)">
                                    <FaIcon Name="@StatusIcon(file.Status)" Class="tfa-icon !h-3 !w-3" />
                                    <span>@StatusLabel(file.Status)</span>
                                </span>
                            </div>
                            <div class="tfa-file-tree-meta" role="gridcell">@UiFormat.ShortDate(file.ModifiedAt)</div>
                            <div class="tfa-file-tree-meta" role="gridcell">@DurationLabel(file.DurationSec)</div>
                            <div class="tfa-file-tree-meta" role="gridcell">@UiFormat.Bytes(file.SizeBytes)</div>
                            <div class="tfa-file-tree-meta" role="gridcell">
                                @TextCharCountLabel(file)
                            </div>
                            <div class="tfa-file-tree-meta" role="gridcell">
                                <span class="@VerbalizationListPill(file)">
                                    @VerbalizationListLabel(file)
                                </span>
                            </div>
                            <div class="tfa-file-tree-meta" role="gridcell">
                                <span class="@SummaryStatusPill(file)">
                                    @SummaryStatusLabel(file)
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <PaginationControls CurrentPage="@_currentFilePage"
                            PageSize="@FilePageSize"
                            TotalItems="@FileTotalItems"
                            Disabled="@ListBusy"
                            Label="音声ファイル一覧のページ移動"
                            PageChanged="ChangeFilePageAsync" />
    }
    </section>
}

@if (_deleteModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4">
        <section class="w-full max-w-xl rounded-md bg-white shadow-xl">
            <div class="border-b border-line p-5">
                <h2 class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="trash-can" Class="tfa-icon text-danger" />
                    <span>生成物を削除</span>
                </h2>
            </div>
            <div class="p-5 text-sm text-slate-700">
                <p>選択中のうち @SelectedGeneratedItemCount 件の操作可能な生成物を削除します。</p>
                <p class="mt-2 text-slate-500">元の音声ファイルは削除しません。</p>
            </div>
            <div class="flex flex-wrap justify-end gap-2 border-t border-line p-4">
                <button class="tfa-button-secondary gap-2" @onclick="CloseDeleteModal" disabled="@_deleting">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>キャンセル</span>
                </button>
                <button class="tfa-button-primary gap-2" @onclick="ConfirmDeleteSelectedAsync" disabled="@_deleting">
                    <FaIcon Name="@(_deleting ? "spinner" : "trash-can")" Class="@($"tfa-icon {(_deleting ? "fa-spin" : "")}")" />
                    <span>削除</span>
                </button>
            </div>
        </section>
    </div>
}
