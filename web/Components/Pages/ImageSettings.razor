@inject TimelineHelperClient Timeline
@inject IJSRuntime Js

@if (!Embedded)
{
    <PageTitle>TimelineForImage 設定 - Timeline</PageTitle>

    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="gear" Class="tfa-icon text-accent" />
            <span>TimelineForImage 設定</span>
        </h1>
        <a class="tfa-button-secondary gap-2" href="image">
            <FaIcon Name="arrow-left" Class="tfa-icon" />
            <span>一覧に戻る</span>
        </a>
    </div>
}

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_saved)
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="circle-check" Class="tfa-icon mt-0.5" />
        <span>設定を保存しました。</span>
    </div>
}

@if (_loading)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else
{
    @if (_overview is not null && !_overview.ProductFound)
    {
        <div class="tfa-alert-danger mb-5 flex items-start gap-2">
            <FaIcon Name="folder-open" Class="tfa-icon mt-0.5" />
            <span>TimelineForImage が見つかりません。</span>
        </div>
    }

    @if (_overview is not null && !_overview.SettingsValid && !string.IsNullOrWhiteSpace(_overview.Message))
    {
        <div class="tfa-alert-warn mb-5 flex items-start gap-2">
            <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
            <span>@_overview.Message</span>
        </div>
    }

    <section class="tfa-card tfa-card-pad">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="folder" Class="tfa-icon text-accent" />
            <span>入力ディレクトリ</span>
        </h2>

        <div class="mt-4 grid gap-3">
            @foreach (var root in _inputRoots)
            {
                <div class="rounded-md border border-line p-3">
                    <div class="grid gap-3 lg:grid-cols-[1fr_auto] lg:items-center">
                        <div class="flex min-h-10 min-w-0 items-center">
                            <div class="break-all font-mono text-sm text-slate-900">@DirectoryDisplay(root)</div>
                        </div>
                        <button class="tfa-button-secondary gap-2" @onclick="() => RemoveInputRoot(root)" disabled="@(_inputRoots.Count <= 1)">
                            <FaIcon Name="xmark" Class="tfa-icon" />
                            <span>外す</span>
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="mt-3 flex justify-end">
            <button class="tfa-button-secondary gap-2" @onclick="AddInputRootAsync">
                <FaIcon Name="plus" Class="tfa-icon" />
                <span>追加</span>
            </button>
        </div>
    </section>

    <section class="tfa-card tfa-card-pad mt-5">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="database" Class="tfa-icon text-accent" />
            <span>出力ディレクトリ</span>
        </h2>

        <div class="mt-4 rounded-md border border-line bg-slate-50 p-4">
            <div class="grid gap-3 lg:grid-cols-[1fr_auto] lg:items-center">
                <div class="min-w-0 break-all font-mono text-sm text-slate-900">@DirectoryDisplay(_outputRoot)</div>
                <button class="tfa-button-secondary gap-2" @onclick="PickOutputRootAsync">
                    <FaIcon Name="folder-open" Class="tfa-icon" />
                    <span>変更</span>
                </button>
            </div>
        </div>
    </section>

    <div class="mt-5 flex flex-wrap gap-3">
        <button class="tfa-button-primary gap-2" @onclick="SaveAsync" disabled="@_saving">
            <FaIcon Name="@(_saving ? "spinner" : "floppy-disk")" Class="@($"tfa-icon {(_saving ? "fa-spin" : "")}")" />
            <span>保存</span>
        </button>
    </div>
}
