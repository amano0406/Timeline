@page "/timeline/operations"
@using System.Text.Json
@inject TimelineHelperClient Timeline

<PageTitle>操作ログ - Timeline</PageTitle>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="tfa-title flex items-center gap-2">
        <FaIcon Name="clipboard-list" Class="tfa-icon text-accent" />
        <span>操作ログ</span>
    </h1>
    <button class="tfa-button-secondary gap-2" @onclick="LoadAsync" disabled="@_loading">
        <FaIcon Name="@(_loading ? "spinner" : "rotate")" Class="@($"tfa-icon {(_loading ? "fa-spin" : "")}")" />
        <span>更新</span>
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_loading)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else
{
    <section class="tfa-card">
        <header class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-4">
            <h2 class="flex items-center gap-2 text-lg font-semibold">
                <FaIcon Name="list-check" Class="tfa-icon text-accent" />
                <span>最近の操作</span>
            </h2>
            <div class="text-sm text-slate-500">@_result.Operations.Count / @_result.Total 件</div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_result.Message))
        {
            <div class="px-5 py-4 text-sm text-slate-600">@_result.Message</div>
        }
        else if (_result.Operations.Count == 0)
        {
            <div class="px-5 py-10 text-center text-sm text-slate-500">操作ログはまだありません。</div>
        }
        else
        {
            <div class="divide-y divide-line">
                @foreach (var operation in _result.Operations)
                {
                    <article class="@OperationRowClass(operation)">
                        <button class="grid w-full gap-3 text-left lg:grid-cols-[11rem_1fr_auto] lg:items-center"
                                @onclick="@(() => SelectAsync(operation.OperationId))">
                            <div class="text-sm text-slate-600">@FormatDate(operation.UpdatedAt)</div>
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="@StatePillClass(operation.State)">@StateLabel(operation.State)</span>
                                    @if (!string.IsNullOrWhiteSpace(operation.ProductName))
                                    {
                                        <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700">@operation.ProductName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(operation.Action))
                                    {
                                        <span class="rounded-full bg-blue-50 px-2 py-1 text-xs text-blue-700">@operation.Action</span>
                                    }
                                </div>
                                <div class="mt-2 truncate font-medium text-slate-900">@OperationTitle(operation)</div>
                            </div>
                            <div class="flex items-center gap-3 text-sm text-slate-500">
                                @if (operation.DurationMs is not null)
                                {
                                    <span>@FormatDuration(operation.DurationMs.Value)</span>
                                }
                                <FaIcon Name="chevron-right" Class="tfa-icon" />
                            </div>
                        </button>
                    </article>
                }
            </div>
        }
    </section>

    @if (_selectedDetail is not null)
    {
        <section class="tfa-card mt-5">
            <header class="flex flex-wrap items-start justify-between gap-3 border-b border-line px-5 py-4">
                <div class="min-w-0">
                    <h2 class="flex items-center gap-2 text-lg font-semibold">
                        <FaIcon Name="magnifying-glass-chart" Class="tfa-icon text-accent" />
                        <span>詳細</span>
                    </h2>
                    <div class="mt-1 break-all font-mono text-xs text-slate-500">@(_selectedDetail.Summary?.OperationId ?? _selectedOperationId)</div>
                </div>
                <button class="tfa-button-secondary gap-2" @onclick="CloseDetail">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>閉じる</span>
                </button>
            </header>

            @if (!_selectedDetail.Available)
            {
                <div class="px-5 py-4 text-sm text-slate-600">@EmptyText(_selectedDetail.Message)</div>
            }
            else
            {
                <div class="grid gap-4 px-5 py-4 lg:grid-cols-2">
                    <div class="rounded-md border border-line bg-slate-50 p-3">
                        <div class="tfa-kicker">状態</div>
                        <div class="mt-1 text-sm font-medium text-slate-900">@StateLabel(_selectedDetail.Summary?.State)</div>
                    </div>
                    <div class="rounded-md border border-line bg-slate-50 p-3">
                        <div class="tfa-kicker">日時</div>
                        <div class="mt-1 text-sm font-medium text-slate-900">@FormatDate(_selectedDetail.Summary?.UpdatedAt)</div>
                    </div>
                    <div class="rounded-md border border-line bg-slate-50 p-3">
                        <div class="tfa-kicker">製品</div>
                        <div class="mt-1 text-sm font-medium text-slate-900">@EmptyText(_selectedDetail.Summary?.ProductName)</div>
                    </div>
                    <div class="rounded-md border border-line bg-slate-50 p-3">
                        <div class="tfa-kicker">操作</div>
                        <div class="mt-1 text-sm font-medium text-slate-900">@EmptyText(_selectedDetail.Summary?.Action)</div>
                    </div>
                    <div class="rounded-md border border-line bg-slate-50 p-3">
                        <div class="tfa-kicker">所要時間</div>
                        <div class="mt-1 text-sm font-medium text-slate-900">@FormatDuration(_selectedDetail.Summary?.DurationMs)</div>
                    </div>
                    <div class="rounded-md border border-line bg-slate-50 p-3">
                        <div class="tfa-kicker">ログディレクトリ</div>
                        <div class="mt-1 break-all font-mono text-sm text-slate-900">@EmptyText(_selectedDetail.LogDirectory)</div>
                    </div>
                </div>

                @if (HasJson(_selectedDetail.Summary?.Details))
                {
                    <div class="border-t border-line px-5 py-4">
                        <div class="mb-2 text-sm font-semibold text-slate-700">結果</div>
                        <pre class="max-h-72 overflow-auto rounded-md bg-slate-950 p-3 text-xs text-slate-100"><code>@JsonText(_selectedDetail.Summary?.Details)</code></pre>
                    </div>
                }

                <div class="border-t border-line px-5 py-4">
                    <h3 class="mb-3 text-sm font-semibold text-slate-700">イベント</h3>
                    <div class="grid gap-3">
                        @foreach (var item in _selectedDetail.Events)
                        {
                            <details class="rounded-md border border-line bg-white p-3" open="@IsImportantEvent(item)">
                                <summary class="cursor-pointer list-none">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <span class="@StatePillClass(item.State)">@StateLabel(item.State)</span>
                                            <span class="text-sm font-medium text-slate-900">@EventTitle(item)</span>
                                        </div>
                                        <span class="text-sm text-slate-500">@FormatDate(item.OccurredAt)</span>
                                    </div>
                                </summary>
                                <div class="mt-3 grid gap-3 text-sm">
                                    @if (!string.IsNullOrWhiteSpace(item.CommandLine))
                                    {
                                        <pre class="overflow-auto rounded-md bg-slate-950 p-3 text-xs text-slate-100"><code>@item.CommandLine</code></pre>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.StdoutTail))
                                    {
                                        <details>
                                            <summary class="cursor-pointer text-slate-700">stdout</summary>
                                            <pre class="mt-2 max-h-60 overflow-auto rounded-md bg-slate-950 p-3 text-xs text-slate-100"><code>@item.StdoutTail</code></pre>
                                        </details>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.StderrTail))
                                    {
                                        <details open>
                                            <summary class="cursor-pointer text-rose-700">stderr</summary>
                                            <pre class="mt-2 max-h-60 overflow-auto rounded-md bg-rose-950 p-3 text-xs text-rose-50"><code>@item.StderrTail</code></pre>
                                        </details>
                                    }
                                    @if (HasJson(item.Details))
                                    {
                                        <details>
                                            <summary class="cursor-pointer text-slate-700">details</summary>
                                            <pre class="mt-2 max-h-60 overflow-auto rounded-md bg-slate-950 p-3 text-xs text-slate-100"><code>@JsonText(item.Details)</code></pre>
                                        </details>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                </div>
            }
        </section>
    }
}

@code {
    private static readonly JsonSerializerOptions JsonWriteOptions = new() { WriteIndented = true };
    private TimelineOperationLogListResult _result = new();
    private TimelineOperationLogDetailResult? _selectedDetail;
    private string _selectedOperationId = "";
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _result = await Timeline.GetOperationLogsAsync(100);
            if (!string.IsNullOrWhiteSpace(_selectedOperationId))
            {
                _selectedDetail = await Timeline.GetOperationLogDetailAsync(_selectedOperationId);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectAsync(string operationId)
    {
        _selectedOperationId = operationId;
        _selectedDetail = await Timeline.GetOperationLogDetailAsync(operationId);
    }

    private void CloseDetail()
    {
        _selectedOperationId = "";
        _selectedDetail = null;
    }

    private static string OperationTitle(TimelineOperationSummary operation)
    {
        if (!string.IsNullOrWhiteSpace(operation.Message))
        {
            return operation.Message;
        }
        if (!string.IsNullOrWhiteSpace(operation.CommandLine))
        {
            return operation.CommandLine;
        }
        return operation.OperationId;
    }

    private static string EventTitle(TimelineOperationEventRow item)
    {
        if (!string.IsNullOrWhiteSpace(item.Message))
        {
            return item.Message;
        }
        if (!string.IsNullOrWhiteSpace(item.Action))
        {
            return item.Action;
        }
        return item.Kind;
    }

    private static string OperationRowClass(TimelineOperationSummary operation) =>
        $"px-5 py-4 hover:bg-slate-50 {(IsErrorState(operation.State) ? "bg-rose-50/40" : "")}";

    private static string StateLabel(string? state) => state switch
    {
        "started" => "開始",
        "completed" => "完了",
        "failed" => "失敗",
        "success" => "成功",
        "error" => "エラー",
        "info" => "情報",
        _ when string.IsNullOrWhiteSpace(state) => "未確認",
        _ => state,
    };

    private static string StatePillClass(string? state)
    {
        if (IsErrorState(state))
        {
            return "rounded-full bg-rose-100 px-2 py-1 text-xs font-medium text-rose-700";
        }
        if (string.Equals(state, "completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(state, "success", StringComparison.OrdinalIgnoreCase))
        {
            return "rounded-full bg-emerald-100 px-2 py-1 text-xs font-medium text-emerald-700";
        }
        if (string.Equals(state, "started", StringComparison.OrdinalIgnoreCase))
        {
            return "rounded-full bg-blue-100 px-2 py-1 text-xs font-medium text-blue-700";
        }
        return "rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700";
    }

    private static bool IsErrorState(string? state) =>
        string.Equals(state, "failed", StringComparison.OrdinalIgnoreCase)
        || string.Equals(state, "error", StringComparison.OrdinalIgnoreCase);

    private static bool IsImportantEvent(TimelineOperationEventRow item) =>
        IsErrorState(item.State) || !string.IsNullOrWhiteSpace(item.StderrTail);

    private static string FormatDate(string? value)
    {
        if (DateTimeOffset.TryParse(value, out var date))
        {
            return date.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss");
        }
        return "-";
    }

    private static string FormatDuration(int? durationMs) =>
        durationMs is null
            ? "-"
            : durationMs.Value >= 1000
                ? $"{durationMs.Value / 1000.0:0.0}s"
                : $"{durationMs.Value}ms";

    private static bool HasJson(JsonElement? element) =>
        element.HasValue
        && element.Value.ValueKind != JsonValueKind.Null
        && element.Value.ValueKind != JsonValueKind.Undefined;

    private static string JsonText(JsonElement? element)
    {
        if (!HasJson(element))
        {
            return "";
        }

        return JsonSerializer.Serialize(element.GetValueOrDefault(), JsonWriteOptions);
    }

    private static string EmptyText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;
}
