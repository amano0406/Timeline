@page "/chatgpt"
@inject TimelineHelperClient Timeline
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>スレッド一覧 - Timeline</PageTitle>

<TimelineBreadcrumbs>
    <a href="scan">スキャン</a>
    <span class="tfa-breadcrumb-separator">/</span>
    <span aria-current="page">ChatGPT スレッド一覧</span>
</TimelineBreadcrumbs>

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="comments" Class="tfa-icon text-accent" />
            <span>スレッド一覧</span>
        </h1>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="tfa-button-primary gap-2" @onclick="StartRefreshAsync" disabled="@(ListBusy || _refreshing || _downloading || !CanRefresh)">
            <FaIcon Name="@(_refreshing ? "spinner" : "file-arrow-up")" Class="@($"tfa-icon {(_refreshing ? "fa-spin" : "")}")" />
            <span>@(_refreshing ? "取り込み中" : "エクスポートZIPを取り込む")</span>
        </button>
    </div>
</div>

<section class="tfa-card tfa-card-pad mb-5">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="min-w-0">
            <h2 class="flex items-center gap-2 text-lg font-semibold">
                <FaIcon Name="file-zipper" Class="tfa-icon text-accent" />
                <span>ChatGPTの履歴を取り込む</span>
            </h2>
            <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
                ChatGPTからダウンロードしたエクスポートZIPを選択してください。ZIPはローカルで読み取り、元ファイルは削除・変更しません。
                取り込み後、スキャンを実行するとTimelineの時間軸に反映されます。
            </p>
        </div>
        <button class="tfa-button-primary shrink-0 gap-2" @onclick="StartRefreshAsync" disabled="@(ListBusy || _refreshing || _downloading || !CanRefresh)">
            <FaIcon Name="@(_refreshing ? "spinner" : "file-arrow-up")" Class="@($"tfa-icon {(_refreshing ? "fa-spin" : "")}")" />
            <span>@(_refreshing ? "取り込み中" : "ZIPを選択")</span>
        </button>
    </div>
</section>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_operationMessage is not null)
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="circle-info" Class="tfa-icon mt-0.5" />
        <span>@_operationMessage</span>
    </div>
}

@if (_overview is not null && !_overview.ProductFound)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="folder-open" Class="tfa-icon mt-0.5" />
        <span>TimelineForChatGPT が見つかりません。</span>
    </div>
}
else if (_overview is not null && !_overview.SettingsValid)
{
    <div class="tfa-alert-warn mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>出力ディレクトリを確認してください。</span>
    </div>
}

@if (_loading && _overview is null)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else if (_overview is not null)
{
    @if (ShowProcessingProgress)
    {
        <section class="tfa-card tfa-run-progress">
            <div class="tfa-run-progress-head">
                <div class="tfa-run-progress-summary">
                    <div class="tfa-run-progress-title">
                        <span class="tfa-icon-box text-sky-800">
                            <FaIcon Name="spinner" Class="tfa-icon fa-spin" />
                        </span>
                        <div class="tfa-run-progress-title-text">
                            <h2>分析の進捗</h2>
                            <div class="tfa-run-progress-meta">
                                <span class="@ProcessingStatePill">@ProcessingStateLabel</span>
                                <span class="tfa-status-pill border-slate-200 bg-white text-slate-700">@ProcessingStageLabel</span>
                                @if (!string.IsNullOrWhiteSpace(ProcessingRunId))
                                {
                                    <span class="tfa-run-progress-id">実行ID: @ProcessingRunId</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(ProcessingCurrentItem))
                                {
                                    <span class="tfa-run-progress-current-inline">処理中スレッド: @ProcessingCurrentItem</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="tfa-run-progress-rate">
                        <div class="tfa-run-progress-percent">@ProcessingProgressLabel</div>
                        <div class="tfa-run-progress-count">@ProcessingProgressCountLabel</div>
                    </div>
                </div>

                <div class="tfa-run-progress-bar-track"
                     role="progressbar"
                     aria-label="分析の進捗"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@ProcessingProgressAriaValue">
                    <div class="@ProcessingProgressBarClass" style="@ProcessingProgressBarStyle"></div>
                </div>
            </div>

            <div class="tfa-run-progress-body">
                <div class="tfa-run-metrics">
                    <div class="tfa-run-metric">
                        <div class="tfa-kicker">対象スレッド</div>
                        <div>@ProcessingTotalLabel</div>
                    </div>
                    <div class="tfa-run-metric">
                        <div class="tfa-kicker">処理済み</div>
                        <div>@ProcessingDoneLabel</div>
                    </div>
                    <div class="tfa-run-metric">
                        <div class="tfa-kicker">エラー</div>
                        <div>@ProcessingErrorLabel</div>
                    </div>
                    <div class="tfa-run-metric">
                        <div class="tfa-kicker">バッチ</div>
                        <div>@ProcessingBatchLabel</div>
                    </div>
                </div>
            </div>
        </section>
    }

    <div class="tfa-summary-grid">
        <section class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="tfa-kicker">取り込み済み</div>
                    <div class="mt-2 text-3xl font-semibold">@ImportedThreadCountLabel</div>
                </div>
                <span class="tfa-icon-box text-sky-800">
                    <FaIcon Name="comments" Class="tfa-icon" />
                </span>
            </div>
        </section>
    </div>

    <section class="tfa-card tfa-list-card mt-5 overflow-hidden">
        <div class="tfa-card-pad flex items-center justify-between gap-3 border-b border-line">
            <h2 class="flex items-center gap-2 text-lg font-semibold">
                <FaIcon Name="comments" Class="tfa-icon text-accent" />
                <span>アイテム一覧</span>
            </h2>
            <span class="text-sm text-slate-500">@ThreadListStatusLabel</span>
        </div>

        @if (ListBusy && Threads.Count == 0)
        {
            <div class="p-5 text-sm text-slate-600">
                <div class="flex items-center gap-3">
                    <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
                    <span>スレッドを読み込んでいます。</span>
                </div>
            </div>
        }
        else if (Threads.Count == 0)
        {
            <div class="p-5 text-sm text-slate-600">スレッドはありません。</div>
        }
        else
        {
            <div class="tfa-file-actionbar">
                <div class="tfa-file-actionbar-count">
                    <FaIcon Name="check-square" Class="tfa-icon text-slate-500" />
                    <span>@SelectionSummary</span>
                </div>
                <div class="tfa-file-actionbar-actions">
                    <button class="tfa-button-secondary gap-2" @onclick="OpenDeleteModal" disabled="@(ListBusy || !HasSelection || _downloading || _deleting || !SupportsGeneratedDelete)">
                        <FaIcon Name="trash-can" Class="tfa-icon" />
                        <span>生成物を削除</span>
                    </button>
                    <button class="tfa-button-secondary gap-2" @onclick="DownloadSelectedAsync" disabled="@(ListBusy || !HasSelection || _downloading || _deleting || !SupportsSelectedDownload)">
                        <FaIcon Name="@(_downloading ? "spinner" : "download")" Class="@($"tfa-icon {(_downloading ? "fa-spin" : "")}")" />
                        <span>ダウンロード</span>
                    </button>
                    <button class="tfa-button-secondary gap-2" @onclick="DownloadAllAsync" disabled="@(_loading || (Threads.Count == 0 && _threadTotal == 0) || _downloading || _deleting)">
                        <FaIcon Name="@(_downloading ? "spinner" : "download")" Class="@($"tfa-icon {(_downloading ? "fa-spin" : "")}")" />
                        <span>すべてダウンロード</span>
                    </button>
                    <button class="tfa-button-secondary gap-2" @onclick="ClearSelection" disabled="@(ListBusy || !HasSelection || _downloading || _deleting)">
                        <FaIcon Name="xmark" Class="tfa-icon" />
                        <span>選択解除</span>
                    </button>
                </div>
            </div>
            <div class="overflow-x-auto tfa-long-list-scroll tfa-list-scroll">
                <table class="tfa-table">
                    <thead>
                        <tr>
                            <th class="w-10">
                                <input type="checkbox"
                                       checked="@AllThreadsSelected"
                                       @onchange="ToggleAllThreads"
                                       disabled="@ListBusy"
                                       aria-label="すべてのスレッドを選択" />
                            </th>
                            <th>タイトル</th>
                            <th>メッセージ</th>
                            <th>文字数</th>
                            <th>概要生成</th>
                            <th>作成日時</th>
                            <th>更新日時</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var thread in Threads)
                        {
                            <tr>
                                <td class="w-10">
                                    <input type="checkbox"
                                           checked="@IsSelected(thread)"
                                           @onchange="(args) => ToggleThread(thread, IsChecked(args))"
                                           disabled="@ListBusy"
                                           aria-label="@($"{EmptyText(thread.Title)} を選択")" />
                                </td>
                                <td class="min-w-80">
                                    <a class="inline-flex items-center gap-1.5 font-medium text-accent underline underline-offset-2"
                                       href="@ThreadUrl(thread)">
                                        <span>@EmptyText(thread.Title)</span>
                                        <FaIcon Name="arrow-up-right-from-square" Class="tfa-icon !h-3 !w-3" />
                                    </a>
                                </td>
                                <td class="whitespace-nowrap">@thread.MessageCount 件</td>
                                <td class="whitespace-nowrap">@_itemSummaryList.TextCharCountLabel(thread.ItemId)</td>
                                <td class="whitespace-nowrap">
                                    <span class="@_itemSummaryList.SummaryStatusPillClass(thread.ItemId)">
                                        @_itemSummaryList.SummaryStatusLabel(thread.ItemId)
                                    </span>
                                </td>
                                <td class="whitespace-nowrap">@ShortDate(thread.CreatedAt)</td>
                                <td class="whitespace-nowrap">@ShortDate(thread.UpdatedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <PaginationControls CurrentPage="@_currentThreadPage"
                                PageSize="@ThreadPageSize"
                                TotalItems="@ThreadTotalItems"
                                Disabled="@ListBusy"
                                Label="スレッド一覧のページ移動"
                                PageChanged="ChangeThreadPageAsync" />
        }
    </section>

}

@if (_deleteModalOpen && SupportsGeneratedDelete)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4">
        <section class="w-full max-w-xl rounded-md bg-white shadow-xl">
            <div class="border-b border-line p-5">
                <h2 class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="trash-can" Class="tfa-icon text-danger" />
                    <span>生成物を削除</span>
                </h2>
            </div>
            <div class="p-5 text-sm text-slate-700">
                <p>選択中の @SelectedItemCount 件の生成物を削除します。</p>
                <p class="mt-2 text-slate-500">元の ChatGPT エクスポートZIPは削除しません。削除後にZIPをアップロードすると、生成物は再作成できます。</p>
            </div>
            <div class="flex flex-wrap justify-end gap-2 border-t border-line p-4">
                <button class="tfa-button-secondary gap-2" @onclick="CloseDeleteModal" disabled="@_deleting">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>キャンセル</span>
                </button>
                <button class="tfa-button-primary gap-2" @onclick="ConfirmDeleteSelectedAsync" disabled="@_deleting">
                    <FaIcon Name="@(_deleting ? "spinner" : "trash-can")" Class="@($"tfa-icon {(_deleting ? "fa-spin" : "")}")" />
                    <span>削除</span>
                </button>
            </div>
        </section>
    </div>
}
