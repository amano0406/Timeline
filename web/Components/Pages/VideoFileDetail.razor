@page "/video/file-detail"
@implements IAsyncDisposable
@inject TimelineHelperClient Timeline
@inject IJSRuntime JS

<PageTitle>動画詳細 - Timeline</PageTitle>

<TimelineBreadcrumbs>
    <a href="scan">スキャン</a>
    <span class="tfa-breadcrumb-separator">/</span>
    <a href="video">動画ファイル一覧</a>
    <span class="tfa-breadcrumb-separator">/</span>
    <span aria-current="page">動画詳細</span>
</TimelineBreadcrumbs>

<div class="mb-6">
    <h1 class="tfa-title flex items-center gap-2">
        <FaIcon Name="video" Class="tfa-icon text-accent" />
        <span>@(_detail?.File is { } file ? DisplayName(file) : "動画詳細")</span>
    </h1>
    @if (_detail?.File is { } loadedFile)
    {
        <p class="mt-2 break-all font-mono text-sm text-slate-600">@loadedFile.SourcePath</p>
    }
</div>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_loading)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">動画ファイルを読み込んでいます。</span>
    </section>
}
else if (_detail?.Available != true || _detail.File is null)
{
    <section class="tfa-card tfa-card-pad">
        <div class="flex items-start gap-3 text-sm text-slate-600">
            <FaIcon Name="circle-minus" Class="tfa-icon mt-0.5 text-slate-400" />
            <div>
                <div class="font-medium text-slate-900">動画ファイルを表示できません。</div>
                <div class="mt-1">@EmptyText(_detail?.Message)</div>
            </div>
        </div>
    </section>
}
else
{
    var videoFile = _detail.File!;

    <div class="tfa-video-detail-layout">
        <aside class="grid gap-4 content-start">
            <section class="tfa-card tfa-card-pad">
                <div class="flex items-start justify-between gap-3">
                    <h2 class="flex items-center gap-2 text-lg font-semibold">
                        <FaIcon Name="circle-info" Class="tfa-icon text-accent" />
                        <span>ファイル情報</span>
                    </h2>
                    <span class="@StatusPill(videoFile.Status)">
                        <FaIcon Name="@StatusIcon(videoFile.Status)" Class="tfa-icon !h-3 !w-3" />
                        <span>@StatusLabel(videoFile.Status)</span>
                    </span>
                </div>
                <dl class="mt-4 grid grid-cols-[max-content_minmax(0,1fr)] gap-x-4 gap-y-2 text-sm">
                    <dt class="text-slate-500">日時</dt>
                    <dd>@UiFormat.ShortDate(videoFile.ModifiedAt)</dd>
                    <dt class="text-slate-500">記録時間</dt>
                    <dd>@DurationLabel(videoFile.DurationSec)</dd>
                    <dt class="text-slate-500">サイズ</dt>
                    <dd>@UiFormat.Bytes(videoFile.SizeBytes)</dd>
                    <dt class="text-slate-500">形式</dt>
                    <dd>@EmptyText(videoFile.Extension)</dd>
                </dl>
            </section>

            <section class="tfa-card tfa-card-pad">
                <h2 class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="chart-simple" Class="tfa-icon text-accent" />
                    <span>取得データ</span>
                </h2>
                <div class="mt-4 grid grid-cols-2 gap-3">
                    <div class="tfa-video-metric">
                        <div class="tfa-video-metric-label">画面フレーム</div>
                        <div class="tfa-video-metric-value">@CountNumber(_detail.Frames.Count)</div>
                        <div class="tfa-video-metric-note">代表時刻</div>
                    </div>
                    <div class="tfa-video-metric">
                        <div class="tfa-video-metric-label">OCR文字</div>
                        <div class="tfa-video-metric-value">@CountNumber(videoFile.TextBlockCount)</div>
                        <div class="tfa-video-metric-note">フレーム合計</div>
                    </div>
                    <div class="tfa-video-metric">
                        <div class="tfa-video-metric-label">発話</div>
                        <div class="tfa-video-metric-value">@CountNumber(DisplayTurns.Count)</div>
                        <div class="tfa-video-metric-note">音声解析</div>
                    </div>
                    <div class="tfa-video-metric">
                        <div class="tfa-video-metric-label">発話候補</div>
                        <div class="tfa-video-metric-value">@CountNumber(videoFile.SpeechCandidateCount)</div>
                        <div class="tfa-video-metric-note">音声区間</div>
                    </div>
                </div>
            </section>

            <section class="tfa-card tfa-card-pad">
                <div class="flex items-center justify-between gap-3">
                    <h2 class="flex items-center gap-2 text-lg font-semibold">
                        <FaIcon Name="chart-simple" Class="tfa-icon text-accent" />
                        <span>活動区間</span>
                    </h2>
                    <span class="tfa-status-pill border-sky-200 bg-sky-50 text-sky-800">解析済み</span>
                </div>
                <div class="mt-4">
                    <div class="tfa-video-activity-bar" aria-label="活動区間">
                        <span class="tfa-video-activity-active" style="@ActivityActiveStyle"></span>
                        <span class="tfa-video-activity-inactive" style="@ActivityInactiveStyle"></span>
                    </div>
                    <div class="mt-2 flex justify-between gap-3 text-xs text-slate-500">
                        <span>活動 @DurationLabel(_detail.Activity.ActiveSec)</span>
                        <span>無活動 @DurationLabel(_detail.Activity.InactiveSec)</span>
                    </div>
                </div>
            </section>
        </aside>

        <main class="grid min-w-0 gap-4">
            <section class="tfa-card overflow-hidden">
                <div class="tfa-card-pad flex flex-col gap-3 border-b border-line lg:flex-row lg:items-center lg:justify-between">
                    <h2 class="flex items-center gap-2 text-lg font-semibold">
                        <FaIcon Name="play" Class="tfa-icon text-accent" />
                        <span>動画と全体フレーム</span>
                    </h2>
                    <div class="flex flex-wrap gap-2 text-xs">
                        <span class="tfa-status-pill border-teal-200 bg-teal-50 text-teal-800">動画</span>
                        <span class="tfa-status-pill border-teal-200 bg-teal-50 text-teal-800">音声</span>
                        <span class="tfa-status-pill border-teal-200 bg-teal-50 text-teal-800">OCR</span>
                    </div>
                </div>
                <div class="tfa-card-pad">
                    <div class="tfa-video-player-grid">
                        @if (_detail.VideoAvailable)
                        {
                            <video id="@VideoElementId" controls preload="metadata" class="tfa-video-player">
                                <source src="@VideoSourceUrl(videoFile)" />
                            </video>
                        }
                        else
                        {
                            <div class="tfa-video-player tfa-video-player-empty">動画プレビューは利用できません。</div>
                        }

                        <div class="grid gap-3 content-start">
                            @if (_detail.Artifacts.HasContactSheet)
                            {
                                <img src="@VideoArtifactUrl(_detail.Artifacts.ContactSheetPath)"
                                     alt="動画の代表フレーム一覧"
                                     class="tfa-video-contact-sheet" />
                            }
                            else
                            {
                                <div class="tfa-video-contact-sheet tfa-video-contact-sheet-empty">代表フレームはまだ作成されていません。</div>
                            }
                            <div class="tfa-video-compact-note">
                                代表フレームを時間軸に差し込み、発話と画面変化を同じ流れで確認できます。
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="tfa-card overflow-hidden">
                <div class="tfa-card-pad flex flex-col gap-2 border-b border-line sm:flex-row sm:items-center sm:justify-between">
                    <h2 class="flex items-center gap-2 text-lg font-semibold">
                        <FaIcon Name="language" Class="tfa-icon text-accent" />
                        <span>発話と画面の時間軸</span>
                    </h2>
                    <div class="flex flex-wrap gap-2 text-xs">
                        <span class="tfa-status-pill border-sky-200 bg-sky-50 text-sky-800">発話</span>
                        <span class="tfa-status-pill border-sky-200 bg-sky-50 text-sky-800">画面フレーム</span>
                        <span class="tfa-status-pill border-sky-200 bg-sky-50 text-sky-800">OCR確認</span>
                    </div>
                </div>
                <div id="@TranscriptScrollElementId" class="tfa-video-timeline-scroll">
                    @if (TimelineEntries.Count == 0)
                    {
                        <div class="p-5 text-sm text-slate-600">この動画で観察できる発話や画面フレームはまだありません。</div>
                    }
                    else
                    {
                        <div class="tfa-video-timeline">
                            @foreach (var entry in TimelineEntries)
                            {
                                if (entry.Turn is { } turn)
                                {
                                    <article class="@TranscriptEntryClass(turn)" data-turn-start="@TurnStartDataValue(turn.StartSec)">
                                        <button class="tfa-video-turn-play" type="button" title="この発話から再生" @onclick="() => SeekAsync(turn.StartSec)">
                                            <FaIcon Name="@PlaybackIcon(turn.StartSec)" Class="tfa-icon !h-3 !w-3" />
                                        </button>
                                        <div class="tfa-video-turn">
                                            <div class="font-mono text-xs text-slate-700">@TurnRangeLabel(turn)</div>
                                            <div>
                                                <span class="tfa-status-pill border-slate-200 bg-slate-50 text-slate-700">@SpeakerLabel(turn.Speaker)</span>
                                            </div>
                                            <div class="text-sm leading-7 text-slate-900">@ReadableText(turn)</div>
                                            <div class="font-mono text-xs text-slate-500">@ConfidenceLabel(turn.Confidence)</div>
                                        </div>
                                    </article>
                                }
                                else if (entry.Frame is { } frame)
                                {
                                    <article class="tfa-video-timeline-entry tfa-video-frame-entry">
                                        <div class="tfa-video-frame-card">
                                            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                                                <h3 class="text-base font-semibold">@DurationLabel(frame.TimeSec) の画面フレーム</h3>
                                                <div class="flex flex-wrap gap-2">
                                                    <button class="tfa-button-primary" type="button" @onclick="() => SeekAsync(frame.TimeSec)">この時刻を再生</button>
                                                    <button class="tfa-button-secondary" type="button" @onclick="() => OpenFrameModal(frame)">OCRを確認</button>
                                                </div>
                                            </div>
                                            @if (frame.HasArtifact)
                                            {
                                                <button type="button" class="tfa-video-frame-button" @onclick="() => OpenFrameModal(frame)">
                                                    <img src="@VideoArtifactUrl(frame.ArtifactPath)" alt="@($"{DurationLabel(frame.TimeSec)} の画面フレーム")" />
                                                </button>
                                            }
                                            <div class="mt-3 grid gap-2 text-xs text-slate-600 sm:grid-cols-4">
                                                <span>OCR @CountLabel(frame.Ocr.BlockCount)</span>
                                                <span>明るさ @LevelLabel(frame.Visual.BrightnessLevel)</span>
                                                <span>コントラスト @LevelLabel(frame.Visual.ContrastLevel)</span>
                                                <span>画面分割 @GridLabel(frame)</span>
                                            </div>
                                        </div>
                                    </article>
                                }
                            }
                        </div>
                    }
                </div>
            </section>
        </main>
    </div>
}

@if (_selectedFrame is { } selectedFrame)
{
    <div class="tfa-video-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="video-ocr-modal-title" @onclick="CloseFrameModal">
        <div class="tfa-video-modal" @onclick:stopPropagation="true">
            <div class="tfa-video-modal-head">
                <div>
                    <h2 id="video-ocr-modal-title" class="text-lg font-semibold">@DurationLabel(selectedFrame.TimeSec) のOCR確認</h2>
                    <p class="mt-1 text-sm text-slate-600">通常フレームとOCR検出枠付きフレームを並べて確認します。</p>
                </div>
                <button class="tfa-video-modal-close" type="button" aria-label="閉じる" @onclick="CloseFrameModal">×</button>
            </div>
            <div class="tfa-video-modal-body">
                <div class="tfa-video-modal-grid">
                    <figure class="tfa-video-modal-image-card">
                        @if (selectedFrame.HasArtifact)
                        {
                            <img src="@VideoArtifactUrl(selectedFrame.ArtifactPath)" alt="通常フレーム" />
                        }
                        <figcaption>
                            <span>通常フレーム</span>
                            <span>@EmptyText(selectedFrame.FrameId)</span>
                        </figcaption>
                    </figure>
                    <figure class="tfa-video-modal-image-card">
                        @if (selectedFrame.HasOcrOverlay)
                        {
                            <img src="@VideoArtifactUrl(selectedFrame.OcrOverlayPath)" alt="OCR検出枠付きフレーム" />
                        }
                        else
                        {
                            <div class="tfa-video-modal-image-empty">OCR検出枠付きフレームはありません。</div>
                        }
                        <figcaption>
                            <span>OCR検出枠</span>
                            <span>@CountLabel(selectedFrame.Ocr.BlockCount)</span>
                        </figcaption>
                    </figure>
                </div>
                <div class="mt-4 grid gap-3 sm:grid-cols-4">
                    <div class="tfa-video-modal-fact">
                        <div class="text-xs text-slate-500">明るさ</div>
                        <div class="mt-1 font-semibold">@LevelLabel(selectedFrame.Visual.BrightnessLevel)</div>
                    </div>
                    <div class="tfa-video-modal-fact">
                        <div class="text-xs text-slate-500">コントラスト</div>
                        <div class="mt-1 font-semibold">@LevelLabel(selectedFrame.Visual.ContrastLevel)</div>
                    </div>
                    <div class="tfa-video-modal-fact">
                        <div class="text-xs text-slate-500">色</div>
                        <div class="mt-2 flex gap-1">
                            @foreach (var color in selectedFrame.Visual.ColorPalette.Take(4))
                            {
                                <span class="tfa-video-color-swatch" style="@PaletteStyle(color)" title="@ColorLabel(color)"></span>
                            }
                        </div>
                    </div>
                    <div class="tfa-video-modal-fact">
                        <div class="text-xs text-slate-500">画面分割</div>
                        <div class="mt-1 font-semibold">@GridLabel(selectedFrame)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
