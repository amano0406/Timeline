@page "/video/file-detail"
@inject TimelineHelperClient Timeline
@inject IJSRuntime JS

<PageTitle>動画詳細 - Timeline</PageTitle>

<TimelineBreadcrumbs>
    <a href="scan">スキャン</a>
    <span class="tfa-breadcrumb-separator">/</span>
    <a href="video">動画ファイル一覧</a>
    <span class="tfa-breadcrumb-separator">/</span>
    <span aria-current="page">動画詳細</span>
</TimelineBreadcrumbs>

<div class="mb-6">
    <h1 class="tfa-title flex items-center gap-2">
        <FaIcon Name="video" Class="tfa-icon text-accent" />
        <span>@(_detail?.File is { } file ? DisplayName(file) : "動画詳細")</span>
    </h1>
    @if (_detail?.File is { } loadedFile)
    {
        <p class="mt-2 break-all font-mono text-sm text-slate-600">@loadedFile.SourcePath</p>
    }
</div>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_loading)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">動画ファイルを読み込んでいます。</span>
    </section>
}
else if (_detail?.Available != true || _detail.File is null)
{
    <section class="tfa-card tfa-card-pad">
        <div class="flex items-start gap-3 text-sm text-slate-600">
            <FaIcon Name="circle-minus" Class="tfa-icon mt-0.5 text-slate-400" />
            <div>
                <div class="font-medium text-slate-900">動画ファイルを表示できません。</div>
                <div class="mt-1">@EmptyText(_detail?.Message)</div>
            </div>
        </div>
    </section>
}
else
{
    var videoFile = _detail.File!;

    <div class="grid gap-5 xl:grid-cols-[420px_1fr]">
        <aside class="grid gap-5">
            <section class="tfa-card tfa-card-pad">
                <h2 class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="circle-info" Class="tfa-icon text-accent" />
                    <span>ファイル情報</span>
                </h2>
                <dl class="mt-4 grid grid-cols-2 gap-2 text-sm">
                    <dt class="text-slate-500">状態</dt>
                    <dd>
                        <span class="@StatusPill(videoFile.Status)">
                            <FaIcon Name="@StatusIcon(videoFile.Status)" Class="tfa-icon !h-3 !w-3" />
                            <span>@StatusLabel(videoFile.Status)</span>
                        </span>
                    </dd>
                    <dt class="text-slate-500">日時</dt>
                    <dd>@UiFormat.ShortDate(videoFile.ModifiedAt)</dd>
                    <dt class="text-slate-500">記録時間</dt>
                    <dd>@DurationLabel(videoFile.DurationSec)</dd>
                    <dt class="text-slate-500">サイズ</dt>
                    <dd>@UiFormat.Bytes(videoFile.SizeBytes)</dd>
                    <dt class="text-slate-500">形式</dt>
                    <dd>@EmptyText(videoFile.Extension)</dd>
                </dl>
            </section>

            <section class="tfa-card tfa-card-pad">
                <h2 class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="file-lines" Class="tfa-icon text-accent" />
                    <span>分析結果</span>
                </h2>
                <dl class="mt-4 grid grid-cols-2 gap-2 text-sm">
                    <dt class="text-slate-500">フレーム</dt>
                    <dd>@CountLabel(videoFile.FrameCount)</dd>
                    <dt class="text-slate-500">テキスト</dt>
                    <dd>@CountLabel(videoFile.TextBlockCount)</dd>
                    <dt class="text-slate-500">音声区間</dt>
                    <dd>@CountLabel(videoFile.TurnCount > 0 ? videoFile.TurnCount : videoFile.SpeechCandidateCount)</dd>
                    <dt class="text-slate-500">文字起こし</dt>
                    <dd>@VerbalizationLabel(_detail.AudioVerbalization)</dd>
                </dl>
            </section>
        </aside>

        <section class="grid gap-5">
            <section class="tfa-card overflow-hidden">
                <div class="tfa-card-pad border-b border-line">
                    <h2 class="flex items-center gap-2 text-lg font-semibold">
                        <FaIcon Name="play" Class="tfa-icon text-accent" />
                        <span>動画プレビュー</span>
                    </h2>
                </div>
                <div class="bg-slate-950 p-4">
                    <video id="@VideoElementId" controls preload="metadata" class="mx-auto max-h-[680px] w-full rounded-md bg-black">
                        <source src="@VideoSourceUrl(videoFile)" />
                    </video>
                </div>
            </section>

            @if (HasVerbalizedTurns)
            {
                <section class="tfa-card overflow-hidden">
                    <div class="tfa-card-pad border-b border-line">
                        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                            <h2 class="flex items-center gap-2 text-lg font-semibold">
                                <FaIcon Name="language" Class="tfa-icon text-accent" />
                                <span>文字起こし</span>
                            </h2>
                            <div class="flex flex-wrap gap-2 text-xs text-slate-500">
                                <span class="tfa-status-pill border-teal-200 bg-teal-50 text-teal-800">@_detail.AudioVerbalizationResult.Turns.Count 区間</span>
                                <span class="@VerbalizationPill(_detail.AudioVerbalization.State)">
                                    <FaIcon Name="@VerbalizationIcon(_detail.AudioVerbalization.State)" Class="tfa-icon !h-3 !w-3" />
                                    <span>@VerbalizationStateLabel(_detail.AudioVerbalization.State)</span>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="max-h-[680px] overflow-auto">
                        <table class="tfa-table">
                            <thead class="sticky top-0">
                                <tr>
                                    <th>再生</th>
                                    <th>時間</th>
                                    <th>話者</th>
                                    <th>内容</th>
                                    <th>確度</th>
                                    <th>状態</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var turn in _detail.AudioVerbalizationResult.Turns)
                                {
                                    <tr class="@ActiveTurnRowClass(turn.StartSec)">
                                        <td>
                                            <button class="tfa-icon-box text-accent" type="button" title="この位置から再生" @onclick="() => SeekAsync(turn.StartSec)">
                                                <FaIcon Name="play" Class="tfa-icon !h-3.5 !w-3.5" />
                                            </button>
                                        </td>
                                        <td class="whitespace-nowrap font-mono text-xs">
                                            @DurationLabel(turn.StartSec) - @DurationLabel(turn.EndSec)
                                        </td>
                                        <td>
                                            <span class="tfa-status-pill border-slate-200 bg-slate-50">@SpeakerLabel(turn.Speaker)</span>
                                        </td>
                                        <td class="max-w-[980px] whitespace-pre-wrap break-words text-sm leading-6 text-slate-900">
                                            @ReadableText(turn)
                                        </td>
                                        <td class="whitespace-nowrap font-mono text-xs text-slate-500">
                                            @ConfidenceLabel(turn.Confidence)
                                        </td>
                                        <td>
                                            <span class="@VerbalizedTurnPill(turn.Status)">@VerbalizedTurnLabel(turn.Status)</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
            else
            {
                <section class="tfa-card tfa-card-pad">
                    <h2 class="flex items-center gap-2 text-lg font-semibold">
                        <FaIcon Name="language" Class="tfa-icon text-accent" />
                        <span>文字起こし</span>
                    </h2>
                    <div class="mt-4 text-sm leading-6 text-slate-700">
                        この動画には文字起こし結果がまだありません。スキャンで音声解析が完了すると、ここに表示されます。
                    </div>
                </section>
            }
        </section>
    </div>
}
