@page "/timeline/launcher"
@inject TimelineLocalApiClient Timeline

<PageTitle>起動と復旧 - Timeline</PageTitle>

<div class="mb-6 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
    <div>
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="power-off" Class="tfa-icon text-accent" />
            <span>起動と復旧</span>
        </h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">
            Timeline 本体、Docker、自動処理、Ollama、サブ製品の状態をまとめて確認します。
        </p>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="tfa-button-secondary gap-2" @onclick="LoadAsync" disabled="@(_loading || _repairingWorker)">
            <FaIcon Name="@(_loading ? "spinner" : "rotate")" Class="@($"tfa-icon {(_loading ? "fa-spin" : "")}")" />
            <span>状態更新</span>
        </button>
        <a class="tfa-button-primary gap-2" href="scan">
            <FaIcon Name="arrows-rotate" Class="tfa-icon" />
            <span>スキャンを開く</span>
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="@(_repairingWorker ? "spinner" : "circle-info")" Class="@($"tfa-icon mt-0.5 {(_repairingWorker ? "fa-spin" : "")}")" />
        <span>@_message</span>
    </div>
}

@if (_loading && _status is null)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else if (_status is not null)
{
    <section class="tfa-card mb-5">
        <div class="tfa-card-pad border-b border-line">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div class="flex min-w-0 items-start gap-3">
                    <span class="@($"inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-md border {RuntimeIconBoxClass(_status.Severity)}")">
                        <FaIcon Name="@RuntimeSeverityIcon(_status.Severity)" Class="tfa-icon" />
                    </span>
                    <div class="min-w-0">
                        <h2 class="text-xl font-bold text-slate-950">@RuntimeOverallTitle(_status.Severity)</h2>
                        <p class="mt-1 text-sm leading-6 text-slate-600">@_status.Message</p>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2">
                    <span class="@RuntimePillClass(_status.Severity)">
                        <FaIcon Name="@RuntimeSeverityIcon(_status.Severity)" Class="tfa-icon !h-3 !w-3" />
                        <span>@RuntimeSeverityLabel(_status.Severity)</span>
                    </span>
                    <span class="tfa-status-pill border-slate-200 bg-slate-50 text-slate-700">更新 @FormatDateTime(_status.UpdatedAt)</span>
                </div>
            </div>
        </div>

        <div class="tfa-card-pad">
            <div class="grid gap-3 lg:grid-cols-2 xl:grid-cols-3">
                @foreach (var component in _status.Components)
                {
                    <article class="@($"rounded-md border p-4 {RuntimeComponentClass(component.Severity)}")">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex min-w-0 items-start gap-3">
                                <FaIcon Name="@RuntimeComponentIcon(component)" Class="tfa-icon mt-0.5 shrink-0" />
                                <div class="min-w-0">
                                    <h3 class="font-semibold">@component.Label</h3>
                                    <p class="mt-1 text-sm leading-6">@component.Message</p>
                                </div>
                            </div>
                            <span class="@RuntimePillClass(component.Severity)">@RuntimeStateLabel(component)</span>
                        </div>
                        @if (HasComponentAction(component))
                        {
                            <div class="mt-4">
                                @if (component.ActionKind == "worker-repair")
                                {
                                    <button class="tfa-button-primary gap-2" @onclick="RepairWorkerAsync" disabled="@(_repairingWorker || _loading)">
                                        <FaIcon Name="@(_repairingWorker ? "spinner" : "wrench")" Class="@($"tfa-icon {(_repairingWorker ? "fa-spin" : "")}")" />
                                        <span>@(_repairingWorker ? "復旧中" : component.ActionLabel)</span>
                                    </button>
                                }
                                else if (component.ActionKind == "products")
                                {
                                    <a class="tfa-button-secondary gap-2" href="#launcher-products">
                                        <FaIcon Name="arrow-down" Class="tfa-icon" />
                                        <span>@component.ActionLabel</span>
                                    </a>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="tfa-card mb-5">
        <div class="tfa-card-pad border-b border-line">
            <h2 class="flex items-center gap-2 text-xl font-bold text-slate-950">
                <FaIcon Name="terminal" Class="tfa-icon text-accent" />
                <span>本体の起動入口</span>
            </h2>
        </div>
        <div class="tfa-card-pad">
            <div class="grid gap-3 lg:grid-cols-3">
                <div class="rounded-md border border-line bg-slate-50 p-4">
                    <div class="text-sm font-semibold text-slate-500">通常入口</div>
                    <div class="mt-1 font-mono text-sm text-slate-900">Timeline Launcher</div>
                    <p class="mt-2 text-sm leading-6 text-slate-600">未起動なら起動し、起動済みなら画面を開きます。</p>
                </div>
                <div class="rounded-md border border-line bg-slate-50 p-4">
                    <div class="text-sm font-semibold text-slate-500">停止</div>
                    <div class="mt-1 font-mono text-sm text-slate-900">Timeline Launcher stop</div>
                    <button class="@(_confirmStopTimeline ? "tfa-button-danger mt-3 gap-2" : "tfa-button-secondary mt-3 gap-2")"
                            @onclick="StopTimelineAsync"
                            disabled="@(_stoppingTimeline || _loading)">
                        <FaIcon Name="@(_stoppingTimeline ? "spinner" : "power-off")" Class="@($"tfa-icon {(_stoppingTimeline ? "fa-spin" : "")}")" />
                        <span>@StopTimelineButtonText</span>
                    </button>
                </div>
                <div class="rounded-md border border-line bg-slate-50 p-4">
                    <div class="text-sm font-semibold text-slate-500">低レベル手段</div>
                    <div class="mt-1 font-mono text-sm text-slate-900">Legacy scripts</div>
                    <p class="mt-2 text-sm leading-6 text-slate-600">通常はランチャーを使い、切り分け時だけ使います。</p>
                    <a class="mt-1 inline-flex items-center gap-2 font-semibold text-accent underline" href="timeline/settings">
                        <FaIcon Name="sliders" Class="tfa-icon !h-4 !w-4" />
                        <span>OS起動時の設定を開く</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
}

<section id="launcher-products" class="tfa-card tfa-card-pad">
    <div class="mb-4 flex flex-col gap-2 lg:flex-row lg:items-start lg:justify-between">
        <div>
            <h2 class="flex items-center gap-2 text-xl font-bold text-slate-950">
                <FaIcon Name="boxes-stacked" Class="tfa-icon text-accent" />
                <span>サブ製品の起動状態</span>
            </h2>
            <p class="mt-1 text-sm leading-6 text-slate-600">素材を取り込む製品を起動、停止、再起動できます。</p>
        </div>
    </div>

    <ProductManagementModal Embedded="true" @ref="_productManagement" />
</section>
