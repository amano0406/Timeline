    }

    private async Task<AudioModelInventoryResult> LoadModelInventoryIfRunningAsync(
        string productId,
        string productName,
        Func<Task<AudioModelInventoryResult>> load)
    {
        if (!IsProductRunning(productId))
        {
            return ModelInventoryUnavailable(productName, $"{productName} は停止中です。起動後にモデル情報を確認できます。");
        }

        try
        {
            return await load();
        }
        catch (Exception ex)
        {
            return ModelInventoryUnavailable(productName, ex.Message);
        }
    }

    private static AudioModelInventoryResult ModelInventoryUnavailable(string pipelineName, string message) =>
        new()
