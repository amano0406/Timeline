        {
            if (!_launcherShortcutStatus.Supported || _launcherShortcutStatus.State.Equals("failed", StringComparison.OrdinalIgnoreCase))
            {
                return "triangle-exclamation";
            }

            return _launcherShortcutStatus.Registered ? "circle-check" : "circle-minus";
        }
    }

    private string LauncherShortcutStatusClass
    {
        get
        {
            if (!_launcherShortcutStatus.Supported)
            {
                return "tfa-status-pill border-amber-200 bg-amber-50 text-amber-900";
