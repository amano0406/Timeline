    private void ApplyManagedOutputDirectories()
    {
        var timelineDirectory = TrimTrailingDirectorySeparators(_timelineDirectory);
        if (string.IsNullOrWhiteSpace(timelineDirectory))
        {
            timelineDirectory = DefaultDataRoot;
        }

        _audioOutputRoot.Path = ManagedProductDataPath(timelineDirectory, "audio");
        _audioOutputRoot.DisplayName = string.IsNullOrWhiteSpace(_audioOutputRoot.DisplayName) ? "TimelineForAudio Master" : _audioOutputRoot.DisplayName;
        _audioOutputRoot.Enabled = true;
        _imageOutputRoot.Path = ManagedProductDataPath(timelineDirectory, "image");
        _imageOutputRoot.DisplayPath = _imageOutputRoot.Path;
        _imageOutputRoot.DisplayName = string.IsNullOrWhiteSpace(_imageOutputRoot.DisplayName) ? "Output" : _imageOutputRoot.DisplayName;
        _videoOutputRoot.Path = ManagedProductDataPath(timelineDirectory, "video");
        _videoOutputRoot.DisplayPath = _videoOutputRoot.Path;
        _videoOutputRoot.DisplayName = string.IsNullOrWhiteSpace(_videoOutputRoot.DisplayName) ? "Output" : _videoOutputRoot.DisplayName;
    }

    private async Task ValidateKnownDirectoryPathsAsync()
    {
        var paths = CurrentDirectoryPaths()
            .Where(path => !string.IsNullOrWhiteSpace(path))
            .Select(TrimTrailingDirectorySeparators)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        await Task.WhenAll(paths.Select(ValidateDirectoryPathAsync));
    }

    private IEnumerable<string?> CurrentDirectoryPaths()
    {
        yield return _timelineDirectory;

        foreach (var root in _audioInputRoots)
        {
            yield return root.Path;
        }
        yield return _audioOutputRoot.Path;

        foreach (var root in _imageInputRoots)
        {
            yield return DirectoryDisplay(root);
        }
        yield return _imageOutputRoot.Path;

        foreach (var root in _videoInputRoots)
        {
            yield return DirectoryDisplay(root);
        }
        yield return _videoOutputRoot.Path;

        foreach (var product in Products)
        {
            yield return ProductConfiguredPath(product, RuntimeFor(product.Id));
        }
    }

    private async Task ValidateDirectoryPathAsync(string? path)
    {
        var key = DirectoryStatusKey(path);
        if (string.IsNullOrWhiteSpace(key))
        {
            return;
        }
        if (_directoryStatusLoading.Contains(key))
        {
            return;
        }

        _directoryStatusLoading.Add(key);
        await InvokeAsync(StateHasChanged);
        try
        {
            _directoryStatusByPath[key] = await Timeline.GetPathStatusAsync(path ?? "", "directory");
        }
        finally
        {
            _directoryStatusLoading.Remove(key);
            await InvokeAsync(StateHasChanged);
        }
    }

