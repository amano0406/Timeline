        _tokenModalOpen = true;
    }

    private void ApplyCommonTokenToProducts()
    {
        if (!HasTokenApplyTargets)
        {
            return;
        }

        if (HasCommonTokenDraft || HasSavedCommonToken)
        {
            _applyCommonTokenToProducts = true;
            _saved = false;
            return;
        }

        OpenTokenModal(true);
    }

    private void OnTokenDraftInput(ChangeEventArgs args)
    {
        _tokenDraft = args.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(_tokenDraft))
        {
            _tokenValidationError = null;
            return;
        }

        _tokenValidationError = ValidateTokenFormat(_tokenDraft.Trim(), out var message)
            ? null
            : message;
    }

    private void CloseTokenModal()
    {
        _tokenModalOpen = false;
        _tokenDraft = null;
        _tokenDraftApplyToProducts = false;
        _tokenValidationError = null;
    }

    private void SaveTokenDraft()
    {
        var token = _tokenDraft?.Trim() ?? "";
        if (!ValidateTokenFormat(token, out var message))
        {
            _tokenValidationError = message;
            return;
        }

        _tokenToSave = token;
        _applyCommonTokenToProducts = _tokenDraftApplyToProducts;
        _tokenValidationError = null;
        _saved = false;
        CloseTokenModal();
    }

    private void OpenSaveConfirm()
    {
        _saved = false;
        _error = null;
        if (!ValidateBeforeSave(out var message))
        {
            _error = message;
            return;
        }

        _pendingSaveChanges = BuildSaveChanges().ToList();
        _restartNoticeProducts = BuildRestartNoticeProducts().ToList();
        _applySteps = BuildApplySteps().ToList();
        _saveConfirmOpen = true;
    }

    public bool HasUnsavedChanges() =>
        !_loading && BuildSaveChanges().Count > 0;

