    private void OpenTokenModal()
    {
        _tokenDraft = "";
        _tokenValidationError = null;
        _tokenModalOpen = true;
    }

    private void CloseTokenModal()
    {
        _tokenModalOpen = false;
        _tokenDraft = null;
        _tokenValidationError = null;
    }

    private void SaveTokenDraft()
    {
        var token = _tokenDraft?.Trim() ?? "";
        if (!ValidateTokenFormat(token, out var message))
        {
            _tokenValidationError = message;
            return;
        }

        _tokenToSave = token;
        _audioDirty = true;
        CloseTokenModal();
    }

    private void OpenSaveConfirm()
    {
        _saved = false;
        _error = null;
        if (!ValidateBeforeSave(out var message))
        {
            _error = message;
            return;
        }

        _pendingSaveChanges = BuildSaveChanges().ToList();
        _saveConfirmOpen = true;
    }

    public bool HasUnsavedChanges() =>
        !_loading && BuildSaveChanges().Count > 0;

    public Task OpenSaveConfirmAsync()
    {
        OpenSaveConfirm();
        return Task.CompletedTask;
    }

    private void CloseSaveConfirm()
    {
        if (_saving)
        {
            return;
        }

        _saveConfirmOpen = false;
    }

    private async Task ConfirmSaveAsync()
    {
        _saveConfirmOpen = false;
        await SaveAsync();
    }

    private bool ValidateBeforeSave(out string message)
    {
        if (string.IsNullOrWhiteSpace(_timelineDirectory))
        {
            message = "保存先を設定してください。";
            return false;
        }
        if (_tokenToSave is { Length: > 0 } && !ValidateTokenFormat(_tokenToSave, out message))
        {
            return false;
        }

        message = "";
        return true;
    }

    private List<SettingsChangeRow> BuildSaveChanges()
    {
        var changes = new List<SettingsChangeRow>();
        var currentTimelineDirectory = _settings is null
            ? DefaultDataRoot
            : TimelineDirectoryFromSettings(_settings);
        AddChange("データ保存先", currentTimelineDirectory, _timelineDirectory);
        AddChange("表示言語", LabelFor(DisplayLanguages, _settings?.DisplayLanguageId), LabelFor(DisplayLanguages, _displayLanguageId));
        AddChange("タイムゾーン", LabelFor(TimeZones, _settings?.TimeZoneId), LabelFor(TimeZones, _timeZoneId));
        AddChange("AI処理方法", ComputeModeLabel(_settings?.CommonAi.ComputeMode), ComputeModeLabel(_commonComputeMode));
        if (!string.IsNullOrWhiteSpace(_tokenToSave))
        {
            changes.Add(new SettingsChangeRow("Hugging Face トークン（Audio / Video）", TokenDisplay, MaskToken(_tokenToSave)));
        }

        if (_audioOverview?.ProductFound == true)
        {
            AddChange("音声入力ディレクトリ", JoinPaths(_audioOverview.InputRoots.Select(root => root.Path)), JoinPaths(_audioInputRoots.Select(root => root.Path)));
            AddChange("TimelineForAudio 生成データ", _audioOverview.OutputRoot?.Path, _audioOutputRoot.Path);
            var nextAudioComputeMode = _proMode ? _audioComputeMode : ResolveCommonComputeModeForProduct();
            AddChange("TimelineForAudio AI処理方法", ComputeModeLabel(_audioOverview.ComputeMode), ComputeModeLabel(nextAudioComputeMode));
        }

        if (_imageOverview?.ProductFound == true)
        {
            AddChange("画像入力ディレクトリ", JoinPaths((_imageOverview.Settings.InputRoots ?? []).Select(root => root.Path)), JoinPaths(_imageInputRoots.Select(root => root.Path)));
            AddChange("TimelineForImage 生成データ", _imageOverview.Settings.OutputRoot?.Path, _imageOutputRoot.Path);
        }

        if (_videoOverview?.ProductFound == true)
        {
            AddChange("動画入力ディレクトリ", JoinPaths((_videoOverview.Settings.InputRoots ?? []).Select(root => root.Path)), JoinPaths(_videoInputRoots.Select(root => root.Path)));
            AddChange("TimelineForVideo 生成データ", _videoOverview.Settings.OutputRoot?.Path, _videoOutputRoot.Path);
            AddChange("TimelineForVideo AI処理方法", ComputeModeLabel(_videoOverview.Settings.ComputeMode), ComputeModeLabel(ResolveCommonComputeModeForProduct()));
        }

        foreach (var product in Products)
        {
            var originalProduct = _settings?.ProductRegistry.Products.FirstOrDefault(item => item.Id.Equals(product.Id, StringComparison.OrdinalIgnoreCase));
            AddChange($"{DisplayName(product)} 製品配置先", originalProduct?.Path, product.Path);
        }

        return changes;

        void AddChange(string label, string? before, string? after)
        {
            var beforeValue = NormalizeChangeText(before);
            var afterValue = NormalizeChangeText(after);
            if (!beforeValue.Equals(afterValue, StringComparison.OrdinalIgnoreCase))
            {
                changes.Add(new SettingsChangeRow(label, beforeValue, afterValue));
            }
        }
    }

    private void OnCommonComputeModeChanged(ChangeEventArgs args)
    {
        _commonComputeMode = NormalizeCommonComputeMode(args.Value?.ToString());
        _audioComputeMode = ResolveCommonComputeModeForProduct();
        _audioDirty = true;
        _videoDirty = true;
        _saved = false;
    }

