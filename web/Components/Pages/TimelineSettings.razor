        {
            _videoOutputRoot.Path = ManagedProductDataPath(_timelineDirectory, "video");
            _videoOutputRoot.DisplayPath = _videoOutputRoot.Path;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _saved = false;
        _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_timelineDirectory))
            {
                throw new InvalidOperationException("保存先を設定してください。");
            }
            if (_tokenToSave is { Length: > 0 } && !ValidateTokenFormat(_tokenToSave, out var tokenMessage))
            {
                throw new InvalidOperationException(tokenMessage);
            }

            var timelineDirectory = TrimTrailingDirectorySeparators(_timelineDirectory);
            _settings = await Timeline.SaveTimelineSettingsAsync(new TimelineAppSettingsSaveRequest
            {
                DisplayLanguageId = _displayLanguageId,
                TimeZoneId = _timeZoneId,
                DataRoot = timelineDirectory,
                CommonAi = new TimelineCommonAiSettings { ComputeMode = _commonComputeMode },
                ProductRegistry = _registry,
            });

            if (_audioOverview?.ProductFound == true && (_audioDirty || !string.IsNullOrWhiteSpace(_tokenToSave)))
            {
                _audioOverview = await Timeline.SaveAudioSettingsAsync(new AudioSettingsSaveRequest
                {
                    Token = _tokenToSave ?? "",
                    ComputeMode = _proMode ? _audioComputeMode : ResolveCommonComputeModeForProduct(),
                    InputRoots = _audioInputRoots
                        .Where(root => !string.IsNullOrWhiteSpace(root.Path))
                        .Select(CloneRoot)
                        .ToList(),
                    OutputRoot = CloneRoot(_audioOutputRoot),
                    OutputPath = _audioOutputRoot.Path,
                });
                LoadAudioState(_audioOverview);
            }

            if (_imageOverview?.ProductFound == true && _imageDirty)
            {
                _imageOverview = await Timeline.SaveImageSettingsAsync(new ImageSettingsSaveRequest
                {
                    InputRoots = _imageInputRoots.Select(CloneRoot).ToList(),
                    OutputRoot = CloneRoot(_imageOutputRoot),
                    OutputRootPath = _imageOutputRoot.Path,
                });
                LoadImageState(_imageOverview);
            }

            if (_videoOverview?.ProductFound == true && (_videoDirty || !string.IsNullOrWhiteSpace(_tokenToSave)))
            {
                _videoOverview = await Timeline.SaveVideoSettingsAsync(new VideoSettingsSaveRequest
                {
                    InputRoots = _videoInputRoots.Select(CloneRoot).ToList(),
                    OutputRoot = CloneRoot(_videoOutputRoot),
                    OutputRootPath = _videoOutputRoot.Path,
                    Token = _tokenToSave ?? "",
                    ComputeMode = ResolveCommonComputeModeForProduct(),
                });
                LoadVideoState(_videoOverview);
            }

            _displayLanguageId = _settings.DisplayLanguageId;
            _timeZoneId = _settings.TimeZoneId;
            _timelineDirectory = TimelineDirectoryFromSettings(_settings);
            _registry = CloneRegistry(_settings.ProductRegistry);
            _runtime = await Timeline.GetProductRuntimeOverviewAsync();
            _tokenToSave = null;
            _audioDirty = false;
            _imageDirty = false;
            _videoDirty = false;
            _saved = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task PickTimelineDirectoryAsync()
    {
        var path = await PickDirectoryAsync("保存先を選択", _timelineDirectory);
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        _timelineDirectory = TrimTrailingDirectorySeparators(path);
        if (!_proMode)
        {
            ApplyManagedOutputDirectories();
        }
        _saved = false;
    }

    private async Task PickProductDirectoryAsync(TimelineProductRegistryProduct product)
    {
        var path = await PickDirectoryAsync($"{DisplayName(product)} の製品配置先を選択", ProductConfiguredPath(product, RuntimeFor(product.Id)));
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        product.Path = path;
        _saved = false;
    }

    private async Task AddAudioInputRootAsync()
    {
        var path = await PickDirectoryAsync("音声ディレクトリを選択", LastAudioInputPath());
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }
        if (_audioInputRoots.Any(root => root.Path.Equals(path, StringComparison.OrdinalIgnoreCase)))
        {
            _error = "同じ音声ディレクトリが既にあります。";
            return;
        }

        _audioInputRoots.Add(new RootRow
        {
            Id = NextAudioInputRootId(),
            DisplayName = DirectoryNameFromPath(path),
            Path = path,
            Enabled = true,
        });
        _audioDirty = true;
        _saved = false;
    }

    private void RemoveAudioInputRoot(string path)
    {
        if (_audioInputRoots.Count <= 1)
        {
            return;
        }

        var root = _audioInputRoots.FirstOrDefault(item => DirectoryDisplay(item.Path).Equals(path, StringComparison.OrdinalIgnoreCase));
        if (root is null)
        {
            return;
        }

        _audioInputRoots.Remove(root);
        _audioDirty = true;
        _saved = false;
    }

