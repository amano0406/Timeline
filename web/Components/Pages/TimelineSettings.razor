    private void MarkRunningApplyStepFailed(string message)
    {
        var running = _applySteps.FirstOrDefault(step => step.Status.Equals("running", StringComparison.OrdinalIgnoreCase));
        if (running is null)
        {
            return;
        }

        SetApplyStepStatus(running.Id, "failed", message);
    }

