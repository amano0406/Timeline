@inject TimelineLocalApiClient Timeline
@inject IJSRuntime Js
@using Microsoft.AspNetCore.Components.Routing

@if (!Embedded)
{
    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges()" OnBeforeInternalNavigation="@(async (LocationChangingContext context) => await ConfirmInternalNavigation(context))" />
}

@if (!Embedded)
{
    <PageTitle>設定 - Timeline</PageTitle>
}

@if (!Embedded)
{
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="sliders" Class="tfa-icon text-accent" />
            <span>設定</span>
        </h1>
    </div>
}

<div class="mb-5 flex flex-wrap gap-2" role="tablist" aria-label="設定モード">
    <button type="button"
            role="tab"
            class="@ModeButtonClass(false)"
            aria-selected="@NormalModeAriaSelected"
            @onclick="ShowNormalMode">
        <FaIcon Name="wand-magic-sparkles" Class="tfa-icon" />
        <span>基本設定</span>
    </button>
    <button type="button"
            role="tab"
            class="@ModeButtonClass(true)"
            aria-selected="@ProModeAriaSelected"
            @onclick="OpenProModeConfirm">
        <FaIcon Name="screwdriver-wrench" Class="tfa-icon" />
        <span>詳細カスタマイズ</span>
    </button>
</div>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_saved)
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="circle-check" Class="tfa-icon mt-0.5" />
        <span>設定を適用しました。</span>
    </div>
}

@if (_loading)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else if (_proMode)
{
    <section class="tfa-card tfa-card-pad">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="screwdriver-wrench" Class="tfa-icon text-accent" />
            <span>詳細カスタマイズ</span>
        </h2>
        <p class="mt-2 text-sm text-slate-600">
            基本設定と違う内容だけ、製品ごとに個別指定します。
        </p>
    </section>

    <section id="timeline-base-settings" class="tfa-card tfa-card-pad mt-5 scroll-mt-6">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="timeline" Class="tfa-icon text-accent" />
            <span>Timeline 本体</span>
        </h2>

        <div class="mt-4 grid gap-4">
            @TimelineDisplayControls()

            <div class="rounded-md border border-line bg-slate-50 p-4">
                <div class="mb-2 text-sm font-medium text-slate-700">保存先</div>
                <div class="grid gap-3 lg:grid-cols-[1fr_auto] lg:items-center">
                    <div class="min-w-0">
                        <div class="break-all font-mono text-sm text-slate-900">@EmptyText(_timelineDirectory)</div>
                        @DirectoryStatus(_timelineDirectory, canCreate: true)
                    </div>
                    <button class="tfa-button-secondary gap-2" @onclick="PickTimelineDirectoryAsync">
                        <FaIcon Name="folder-open" Class="tfa-icon" />
                        <span>変更</span>
                    </button>
                </div>
            </div>

            @TimelineStartupControls()

            @TimelineInstallPlanControls()

            @TimelineUninstallPlanControls()
        </div>
    </section>

    <section class="tfa-card tfa-card-pad mt-5">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="boxes-stacked" Class="tfa-icon text-accent" />
            <span>製品ごとの設定</span>
        </h2>

        @if (Products.Count == 0)
        {
            <div class="mt-4 rounded-md border border-line bg-slate-50 p-4 text-sm text-slate-600">
                製品は登録されていません。
            </div>
        }
        else if (SelectedProductSettingsProduct is { } selectedProduct)
        {
            var runtime = RuntimeFor(selectedProduct.Id);

            <div class="mt-4 flex flex-wrap gap-2" role="tablist" aria-label="製品ごとの設定">
                @foreach (var product in Products)
                {
                    var selected = string.Equals(_selectedProductSettingsId, product.Id, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            role="tab"
                            aria-selected="@(selected ? "true" : "false")"
                            class="@ProductSettingsTabClass(product.Id)"
                            @onclick="@(() => SelectProductSettings(product.Id))">
                        <FaIcon Name="@ProductIcon(product.Id)" Class="tfa-icon" />
                        <span>@DisplayName(product)</span>
                    </button>
                }
            </div>

            <div class="mt-4 rounded-md border border-line bg-white p-4">
                <div class="mb-4 rounded-md border border-line bg-slate-50 p-4">
                    <div class="mb-2 text-sm font-medium text-slate-700">製品配置先</div>
                    <div class="grid gap-3 lg:grid-cols-[1fr_auto] lg:items-center">
                        <div class="min-w-0">
                            <div class="break-all font-mono text-sm text-slate-900">@EmptyText(ProductConfiguredPath(selectedProduct, runtime))</div>
                            @DirectoryStatus(ProductConfiguredPath(selectedProduct, runtime))
                        </div>
                        <button class="tfa-button-secondary gap-2" @onclick="@(() => PickProductDirectoryAsync(selectedProduct))">
                            <FaIcon Name="folder-open" Class="tfa-icon" />
                            <span>変更</span>
                        </button>
                    </div>
                </div>

                @ProductSpecificSettings(selectedProduct.Id)
            </div>
        }
    </section>

    @if (!Embedded)
    {
    <div class="mt-5 flex flex-wrap gap-3">
        <button class="tfa-button-primary gap-2" @onclick="OpenSaveConfirm" disabled="@_saving">
            <FaIcon Name="@(_saving ? "spinner" : "clipboard-check")" Class="@($"tfa-icon {(_saving ? "fa-spin" : "")}")" />
            <span>確認</span>
        </button>
    </div>
    }
}
else
{
    <section id="timeline-save-location" class="tfa-card tfa-card-pad scroll-mt-6">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="database" Class="tfa-icon text-accent" />
            <span>データ保存先</span>
        </h2>

        <div class="mt-4 rounded-md border border-line bg-slate-50 p-4">
            <div class="grid gap-3 lg:grid-cols-[1fr_auto] lg:items-center">
                    <div class="min-w-0">
                        <div class="break-all font-mono text-sm text-slate-900">@EmptyText(_timelineDirectory)</div>
                        @DirectoryStatus(_timelineDirectory, canCreate: true)
                        <div class="mt-2 text-sm text-slate-600">作業データ、時間軸データ、各製品の生成データはこの中で管理します。</div>
                    </div>
                <div class="flex flex-wrap gap-2">
                    <button class="tfa-button-secondary gap-2" @onclick="PickTimelineDirectoryAsync">
                        <FaIcon Name="folder-open" Class="tfa-icon" />
                        <span>変更</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <section id="timeline-display-settings" class="tfa-card tfa-card-pad mt-5 scroll-mt-6">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="language" Class="tfa-icon text-accent" />
            <span>表示</span>
        </h2>
        <div class="mt-4 grid gap-4">
            @TimelineDisplayControls()
        </div>
    </section>

    <section id="timeline-startup-settings" class="tfa-card tfa-card-pad mt-5 scroll-mt-6">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="power-off" Class="tfa-icon text-accent" />
            <span>起動</span>
        </h2>
        <div class="mt-4">
            @TimelineStartupControls()
        </div>
        <div class="mt-4">
            @TimelineInstallPlanControls()
        </div>
    </section>

    <section id="timeline-uninstall-settings" class="tfa-card tfa-card-pad mt-5 scroll-mt-6">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="trash" Class="tfa-icon text-accent" />
            <span>削除時の影響範囲</span>
        </h2>
        <div class="mt-4">
            @TimelineUninstallPlanControls()
        </div>
    </section>

    @if (HasInstalledProducts)
    {
    <section id="timeline-ai-settings" class="tfa-card tfa-card-pad mt-5 scroll-mt-6">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="microchip" Class="tfa-icon text-accent" />
            <span>AI設定</span>
        </h2>

        <div class="mt-4 grid gap-4">
            <div class="rounded-md border border-line bg-slate-50 p-4">
                <h3 class="text-base font-semibold">Hugging Face トークン</h3>
                <div class="mt-3 grid gap-3 lg:grid-cols-[1fr_auto] lg:items-center">
                    <div>
                        <div class="inline-flex items-center gap-2 text-sm font-medium text-slate-700">
                            <FaIcon Name="@TokenStatusIcon"
                                    Class="@($"tfa-icon {TokenStatusIconClass}")" />
                            <span>@TokenStatusLabel</span>
                        </div>
                        <div class="mt-1 font-mono text-sm text-slate-900">@TokenDisplay</div>
                        @if (HasCommonTokenDraft || _applyCommonTokenToProducts)
                        {
                            <div class="mt-2 rounded-md border border-teal-200 bg-teal-50 p-3 text-sm text-teal-900">
                                @if (_applyCommonTokenToProducts)
                                {
                                    <span>適用時に、基本設定の標準トークンを対応製品にも反映します。</span>
                                }
                                else
                                {
                                    <span>適用時に、基本設定の標準トークンを更新します。個別設定は維持します。</span>
                                }
                            </div>
                        }
                        else if (HasTokenOverrides)
                        {
                            <div class="mt-2 rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
                                <div class="font-medium">一部の製品で個別設定があります</div>
                                <div class="mt-1">@TokenOverrideSummary</div>
                                @if (HasTokenApplyTargets)
                                {
                                    <button type="button" class="tfa-button-secondary mt-3 gap-2" @onclick="ApplyCommonTokenToProducts">
                                        <FaIcon Name="arrows-rotate" Class="tfa-icon" />
                                        <span>この設定を対応製品へ適用</span>
                                    </button>
                                }
                                else
                                {
                                    <div class="mt-2 text-sm">対応製品は停止中です。起動後に基本設定を適用できます。</div>
                                }
                            </div>
                        }
                    </div>
                    <button class="tfa-button-secondary gap-2" @onclick="@(() => OpenTokenModal(false))">
                        <FaIcon Name="key" Class="tfa-icon" />
                        <span>登録</span>
                    </button>
                </div>
            </div>

            <div class="rounded-md border border-line bg-slate-50 p-4">
                <h3 class="text-base font-semibold">AI処理方法</h3>
                <div class="mt-3 max-w-xl">
                    <select class="tfa-input" value="@_commonComputeMode" @onchange="OnCommonComputeModeChanged" aria-label="AI処理方法">
                        <option value="auto">@AutoComputeModeLabel</option>
                        <option value="gpu">GPU</option>
                        <option value="cpu">CPU</option>
                    </select>
                </div>
                <div class="mt-3 rounded-md border border-line bg-white p-3 text-sm text-slate-700">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-medium text-slate-900">現在の実行判定</span>
                        <span class="@EffectiveCommonComputeModePillClass">@EffectiveCommonComputeModeLabel</span>
                        <span class="tfa-status-pill border-slate-200 bg-slate-50 text-slate-700">@AiGpuDetectionLabel</span>
                    </div>
                    <div class="mt-2">@CommonComputeModeReason</div>
                </div>
                <div class="mt-3 grid gap-2 text-sm">
                    @DevicePreview("CPU", "microchip", CpuDevices)
                    @DevicePreview("GPU", "display", GpuDevices)
                </div>
                @if (ComputeOverrideProductNames.Count > 0)
                {
                    <div class="mt-3 rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
                        <div class="font-medium">一部の製品で個別設定があります</div>
                        <div class="mt-1">@string.Join("、", ComputeOverrideProductNames) は基本設定と違う処理方法を使っています。</div>
                        <button type="button" class="tfa-button-secondary mt-3 gap-2" @onclick="ApplyCommonComputeToProducts">
                            <FaIcon Name="arrows-rotate" Class="tfa-icon" />
                            <span>この設定をすべての製品に適用する</span>
                        </button>
                    </div>
                }
            </div>

            <div class="rounded-md border border-line bg-slate-50 p-4">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                    <h3 class="text-base font-semibold">モデル利用条件</h3>
                    @if (_modelsLoading)
                    {
                        <div class="inline-flex items-center gap-2 text-sm text-slate-500">
                            <FaIcon Name="spinner" Class="tfa-icon fa-spin !h-4 !w-4" />
                            <span>確認中</span>
                        </div>
                    }
                </div>

                @if (_modelsLoading)
                {
                    <div class="mt-3 text-sm text-slate-600">モデル情報を確認しています。</div>
                }
                else if (ModelDisplayRows.Count == 0 && ModelInventoryMessages.Count > 0)
                {
                    <div class="mt-3 grid gap-1 text-sm text-slate-600">
                        @foreach (var message in ModelInventoryMessages)
                        {
                            <div>@message</div>
                        }
                    </div>
                }
                else if (ModelDisplayRows.Count == 0)
                {
                    <div class="mt-3 text-sm text-slate-600">モデル情報は見つかりませんでした。</div>
                }
                else
                {
                    <div class="mt-3 grid gap-2">
                        @foreach (var row in ModelDisplayRows)
                        {
                            var model = row.Model;
                            <div class="grid gap-3 rounded-md border border-line bg-white p-3 lg:grid-cols-[1fr_auto] lg:items-center">
                                <div class="min-w-0">
                                    <div class="font-medium text-slate-900">@row.ProductName / @ModelRoleLabel(model)</div>
                                    <div class="mt-1 break-all font-mono text-xs text-slate-600">@model.ModelId</div>
                                    <div class="mt-2 flex flex-wrap gap-2">
                                        @if (model.Source.Equals("local", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="tfa-status-pill border-teal-200 bg-teal-50 text-teal-800">ローカル処理</span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(model.Source))
                                        {
                                            <span class="tfa-status-pill border-slate-200 bg-slate-50 text-slate-700">@ModelSourceLabel(model.Source)</span>
                                        }
                                        @if (model.RequiresHuggingFaceToken)
                                        {
                                            <span class="tfa-status-pill border-sky-200 bg-sky-50 text-sky-800">トークン</span>
                                        }
                                        @if (model.RequiresAccessApproval)
                                        {
                                            <span class="tfa-status-pill border-amber-200 bg-amber-50 text-amber-900">利用承認</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(model.License))
                                        {
                                            <span class="tfa-status-pill border-slate-200 bg-slate-50 text-slate-700">ライセンス: @model.License</span>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(model.Url))
                                {
                                    <a class="tfa-button-secondary gap-2" href="@model.Url" target="_blank" rel="noreferrer">
                                        <FaIcon Name="arrow-up-right-from-square" Class="tfa-icon" />
                                        <span>モデルページ</span>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <section id="timeline-input-settings" class="tfa-card tfa-card-pad mt-5 scroll-mt-6">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="folder" Class="tfa-icon text-accent" />
            <span>入力データ</span>
        </h2>

        <div class="mt-4 grid gap-4">
            @if (_audioSettingsLoading)
            {
                @InputRootLoadingSection("音声")
            }
            else
            {
                @InputRootSection("音声", _audioInputRoots.Select(root => root.Path).ToList(), "追加", AddAudioInputRootAsync, RemoveAudioInputRoot)
            }
            @if (_imageSettingsLoading)
            {
                @InputRootLoadingSection("画像")
            }
            else if (_imageOverview?.ProductFound != true)
            {
                @ProductInputUnavailableSection("画像", "TimelineForImage")
            }
            else
            {
                @InputRootSection("画像", _imageInputRoots.Select(DirectoryDisplay).ToList(), "追加", AddImageInputRootAsync, RemoveImageInputRootByDisplay)
            }
            @if (_videoSettingsLoading)
            {
                @InputRootLoadingSection("動画")
            }
            else
            {
                @InputRootSection("動画", _videoInputRoots.Select(DirectoryDisplay).ToList(), "追加", AddVideoInputRootAsync, RemoveVideoInputRootByDisplay)
            }
        </div>
    </section>
    }
    else
    {
    <section class="tfa-card tfa-card-pad mt-5">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="boxes-stacked" Class="tfa-icon text-accent" />
            <span>製品の追加</span>
        </h2>
        <div class="mt-3 rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
            製品をインストールすると、AI設定や入力データの設定をここで扱えます。
        </div>
        <div class="mt-4">
            <a class="tfa-button-primary gap-2" href="timeline/products">
                <FaIcon Name="boxes-stacked" Class="tfa-icon" />
                <span>製品管理を開く</span>
            </a>
        </div>
    </section>
    }

    @if (!Embedded)
    {
    <div class="mt-5 flex flex-wrap gap-3">
        <button class="tfa-button-primary gap-2" @onclick="OpenSaveConfirm" disabled="@_saving">
            <FaIcon Name="@(_saving ? "spinner" : "clipboard-check")" Class="@($"tfa-icon {(_saving ? "fa-spin" : "")}")" />
            <span>確認</span>
        </button>
    </div>
    }
}

@if (_saveConfirmOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4">
        <section class="tfa-settings-apply-dialog w-full max-w-3xl rounded-md bg-white shadow-xl"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="timeline-settings-save-confirm-title">
            <div class="flex items-center justify-between gap-3 border-b border-line p-5">
                <h2 id="timeline-settings-save-confirm-title" class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="clipboard-check" Class="tfa-icon text-accent" />
                    <span>設定を適用しますか？</span>
                </h2>
                <button type="button" class="tfa-button-secondary !min-h-9 !px-2" aria-label="閉じる" @onclick="CloseSaveConfirm">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                </button>
            </div>
            <div class="max-h-[52vh] overflow-auto p-5">
                @if (_pendingSaveChanges.Count == 0)
                {
                    <div class="rounded-md border border-line bg-slate-50 p-4 text-sm text-slate-700">
                        変更はありません。現在の内容で適用します。
                    </div>
                }
                else
                {
                    <div class="grid gap-3">
                        @foreach (var change in _pendingSaveChanges)
                        {
                            <article class="rounded-md border border-line bg-slate-50 p-3">
                                <div class="text-sm font-semibold text-slate-900">@change.Label</div>
                                <div class="mt-2 grid gap-2 text-sm lg:grid-cols-2">
                                    <div class="min-w-0">
                                        <div class="tfa-kicker">現在</div>
                                        <div class="mt-1 break-all font-mono text-slate-700">@EmptyText(change.Before)</div>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="tfa-kicker">適用後</div>
                                        <div class="mt-1 break-all font-mono text-slate-900">@EmptyText(change.After)</div>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
            @if (_restartNoticeProducts.Count > 0)
            {
                <div class="border-t border-line p-5">
                    <div class="rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
                        <div class="font-semibold">再起動が必要になる可能性があります</div>
                        <div class="mt-1">@string.Join("、", _restartNoticeProducts) の設定を変更します。</div>
                    </div>
                </div>
            }
            @if (_applySteps.Count > 0)
            {
                <div class="border-t border-line p-5">
                    <div class="mb-3 text-sm font-semibold text-slate-900">適用の進行状況</div>
                    <div class="grid gap-2">
                        @foreach (var step in _applySteps)
                        {
                            <div class="rounded-md border border-line bg-slate-50 px-3 py-2">
                                <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
                                    <div class="font-medium text-slate-900">@step.Label</div>
                                    <span class="@($"{ApplyStepStatusClass(step.Status)} shrink-0")">
                                        <FaIcon Name="@ApplyStepIcon(step.Status)" Class="@($"tfa-icon !h-3 !w-3 {ApplyStepSpinClass(step.Status)}")" />
                                        <span>@ApplyStepStatusLabel(step.Status)</span>
                                    </span>
                                </div>
                                <div class="min-w-0">
                                    @if (!string.IsNullOrWhiteSpace(step.Message))
                                    {
                                        <div class="mt-1 text-sm text-slate-600">@step.Message</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="flex flex-wrap justify-end gap-2 border-t border-line p-4">
                <button class="tfa-button-secondary gap-2" @onclick="CloseSaveConfirm" disabled="@_saving">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>キャンセル</span>
                </button>
                <button class="tfa-button-primary gap-2" @onclick="ConfirmSaveAsync" disabled="@_saving">
                    <FaIcon Name="@(_saving ? "spinner" : "circle-check")" Class="@($"tfa-icon {(_saving ? "fa-spin" : "")}")" />
                    <span>適用する</span>
                </button>
            </div>
        </section>
    </div>
}

@if (_tokenModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4">
        <section class="w-full max-w-xl rounded-md bg-white shadow-xl"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="timeline-settings-token-title">
            <div class="border-b border-line p-5">
                <h2 id="timeline-settings-token-title" class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="key" Class="tfa-icon text-accent" />
                    <span>Hugging Face トークンを登録</span>
                </h2>
            </div>
            <div class="p-5">
                @if (_tokenValidationError is not null)
                {
                    <div class="tfa-alert-danger mb-4 flex items-start gap-2">
                        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
                        <span>@_tokenValidationError</span>
                    </div>
                }
                <label class="tfa-label" for="token-modal-input">Hugging Face token</label>
                <input id="token-modal-input"
                       class="tfa-input font-mono"
                       type="password"
                       autocomplete="off"
                       placeholder="hf_..."
                       value="@_tokenDraft"
                       @oninput="OnTokenDraftInput" />
                @if (!string.IsNullOrWhiteSpace(_tokenDraft) && _tokenValidationError is null)
                {
                    <div class="tfa-alert-info mt-3 flex items-start gap-2">
                        <FaIcon Name="circle-check" Class="tfa-icon mt-0.5" />
                        <span>トークンの形式は問題ありません。</span>
                    </div>
                }
                <div class="mt-3 rounded-md border border-line bg-slate-50 p-3 text-sm text-slate-700">
                    @if (_tokenDraftApplyToProducts)
                    {
                        <span>基本設定として保存し、対応している製品にも同じトークンを反映します。</span>
                    }
                    else
                    {
                        <span>基本設定の標準トークンとして保存します。既に製品ごとに指定されているトークンは維持します。</span>
                    }
                </div>
                <div class="mt-3 text-sm text-slate-600">
                    <span class="font-medium">トークンの作成:</span>
                    <a class="text-accent underline" href="https://huggingface.co/settings/tokens" target="_blank" rel="noreferrer">Hugging Face tokens</a>
                </div>
            </div>
            <div class="flex flex-wrap justify-end gap-2 border-t border-line p-4">
                <button class="tfa-button-secondary gap-2" @onclick="CloseTokenModal">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>キャンセル</span>
                </button>
                <button class="tfa-button-primary gap-2" @onclick="SaveTokenDraft">
                    <FaIcon Name="circle-check" Class="tfa-icon" />
                    <span>OK</span>
                </button>
            </div>
        </section>
    </div>
}

@if (_proModeConfirmOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4">
        <section class="w-full max-w-xl rounded-md bg-white shadow-xl"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="timeline-settings-pro-mode-title">
            <div class="border-b border-line p-5">
                <h2 id="timeline-settings-pro-mode-title" class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="screwdriver-wrench" Class="tfa-icon text-accent" />
                    <span>詳細カスタマイズに切り替えますか？</span>
                </h2>
            </div>
            <div class="p-5 text-sm text-slate-700">
                <p>詳細カスタマイズでは、基本設定と違う内容だけを製品ごとに指定できます。</p>
                <p class="mt-2">個別指定した項目は、基本設定より優先されます。</p>
            </div>
            <div class="flex flex-wrap justify-end gap-2 border-t border-line p-4">
                <button class="tfa-button-secondary gap-2" @onclick="CloseProModeConfirm">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>キャンセル</span>
                </button>
                <button class="tfa-button-primary gap-2" @onclick="ConfirmProMode">
                    <FaIcon Name="circle-check" Class="tfa-icon" />
                    <span>続ける</span>
                </button>
            </div>
        </section>
    </div>
}

@code {
