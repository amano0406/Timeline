    private RenderFragment InputRootSection(string title, IReadOnlyList<string> roots, string addLabel, Func<Task> onAdd, Action<string> onRemove) => @<div class="rounded-md border border-line bg-slate-50 p-4">
        <h3 class="text-base font-semibold">@title</h3>
        <div class="mt-3 grid gap-2">
            @foreach (var root in roots)
            {
                <div class="grid gap-3 rounded-md border border-line bg-white p-3 lg:grid-cols-[1fr_auto] lg:items-center">
                    <div class="min-w-0 break-all font-mono text-sm text-slate-900">@EmptyText(root)</div>
                    <button class="tfa-button-secondary gap-2" @onclick="@(() => onRemove(root))" disabled="@(roots.Count <= 1)">
                        <FaIcon Name="xmark" Class="tfa-icon" />
                        <span>外す</span>
                    </button>
                </div>
            }
        </div>
        <div class="mt-3 flex justify-end">
            <button class="tfa-button-secondary gap-2" @onclick="onAdd">
                <FaIcon Name="plus" Class="tfa-icon" />
                <span>@addLabel</span>
            </button>
        </div>
    </div>;

