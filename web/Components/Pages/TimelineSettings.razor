    private RenderFragment DirectoryStatus(string? path, bool canCreate = false) => @<div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
        @{
            var key = DirectoryStatusKey(path);
        }
        @if (string.IsNullOrWhiteSpace(key))
        {
            <span class="tfa-status-pill border-amber-200 bg-amber-50 text-amber-900">未設定</span>
        }
        else if (_directoryStatusLoading.Contains(key))
        {
            <span class="tfa-status-pill border-sky-200 bg-sky-50 text-sky-800">
                <FaIcon Name="spinner" Class="tfa-icon fa-spin !h-3 !w-3" />
                <span>確認中</span>
            </span>
        }
        else if (_directoryStatusByPath.TryGetValue(key, out var status))
        {
            @if (status.MatchesKind)
            {
                <span class="tfa-status-pill border-teal-200 bg-teal-50 text-teal-800">
                    <FaIcon Name="circle-check" Class="tfa-icon !h-3 !w-3" />
                    <span>確認済み</span>
                </span>
            }
            else if (canCreate && !status.Exists)
            {
                <span class="tfa-status-pill border-amber-200 bg-amber-50 text-amber-900">
                    <FaIcon Name="folder-plus" Class="tfa-icon !h-3 !w-3" />
                    <span>保存時に作成予定</span>
                </span>
            }
            else
            {
                <span class="tfa-status-pill border-red-200 bg-red-50 text-red-800">
                    <FaIcon Name="triangle-exclamation" Class="tfa-icon !h-3 !w-3" />
                    <span>見つかりません</span>
                </span>
            }
        }
        else
        {
            <span class="tfa-status-pill border-slate-200 bg-slate-50 text-slate-600">未確認</span>
        }
    </div>;

    private List<string> InputRootValidationMessages(IReadOnlyList<string> roots)
    {
        var messages = new List<string>();
        var values = roots
            .Select(TrimTrailingDirectorySeparators)
            .Where(path => !string.IsNullOrWhiteSpace(path))
            .ToList();

        if (values.Count == 0)
        {
            messages.Add("読み込み場所を追加してください。");
            return messages;
        }

        var duplicatePaths = values
            .GroupBy(path => path, StringComparer.OrdinalIgnoreCase)
            .Where(group => group.Count() > 1)
            .Select(group => group.Key)
            .ToList();
        foreach (var path in duplicatePaths)
        {
            messages.Add($"同じ読み込み場所が重複しています: {path}");
        }

        foreach (var path in values)
        {
            var key = DirectoryStatusKey(path);
            if (_directoryStatusByPath.TryGetValue(key, out var status) && !status.MatchesKind)
            {
                messages.Add($"読み込み場所が見つかりません: {path}");
            }
        }

        return messages;
    }

    private RenderFragment InputRootSection(string title, IReadOnlyList<string> roots, string addLabel, Func<Task> onAdd, Action<string> onRemove) => @<div class="rounded-md border border-line bg-slate-50 p-4">
        <h3 class="text-base font-semibold">@title</h3>
        <div class="mt-3 grid gap-2">
            @foreach (var root in roots)
            {
                <div class="grid gap-3 rounded-md border border-line bg-white p-3 lg:grid-cols-[1fr_auto] lg:items-center">
                    <div class="min-w-0">
                        <div class="break-all font-mono text-sm text-slate-900">@EmptyText(root)</div>
                        @DirectoryStatus(root)
                    </div>
                    <button class="tfa-button-secondary gap-2" @onclick="@(() => onRemove(root))" disabled="@(roots.Count <= 1)">
                        <FaIcon Name="xmark" Class="tfa-icon" />
                        <span>外す</span>
                    </button>
                </div>
            }
        </div>
        @if (InputRootValidationMessages(roots) is { Count: > 0 } messages)
        {
            <div class="mt-3 grid gap-2">
                @foreach (var message in messages)
                {
                    <div class="rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">@message</div>
                }
            </div>
        }
        <div class="mt-3 flex justify-end">
            <button class="tfa-button-secondary gap-2" @onclick="onAdd">
                <FaIcon Name="plus" Class="tfa-icon" />
                <span>@addLabel</span>
            </button>
        </div>
    </div>;

