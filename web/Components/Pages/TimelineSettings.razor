    private static string TimelineDirectoryFromSettings(TimelineAppSettings settings)
    {
        if (!string.IsNullOrWhiteSpace(settings.ResolvedDataRoot))
        {
            return settings.ResolvedDataRoot;
        }

        if (!string.IsNullOrWhiteSpace(settings.DataRoot))
        {
            return settings.DataRoot;
        }

        return TimelineDirectoryFromLegacySettings(settings.WorkDirectory, settings.StoreDirectory);
    }

    private static string TimelineDirectoryFromLegacySettings(string? workDirectory, string? storeDirectory)
    {
        var workParent = ParentForNamedChild(workDirectory, "work");
        var storeParent = ParentForNamedChild(storeDirectory, "to_timeline");
        if (string.IsNullOrWhiteSpace(storeParent))
        {
            storeParent = ParentForNamedChild(storeDirectory, "store");
        }
        if (!string.IsNullOrWhiteSpace(workParent)
            && !string.IsNullOrWhiteSpace(storeParent)
            && string.Equals(workParent, storeParent, StringComparison.OrdinalIgnoreCase))
        {
            return workParent;
        }

        if (!string.IsNullOrWhiteSpace(storeParent))
        {
            return storeParent;
        }

        if (!string.IsNullOrWhiteSpace(workParent))
        {
            return workParent;
        }

        return DefaultDataRoot;
    }

    private static string ParentForNamedChild(string? path, string childName)
    {
        var trimmed = TrimTrailingDirectorySeparators(path);
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return "";
        }

        var separator = Math.Max(trimmed.LastIndexOf('\\'), trimmed.LastIndexOf('/'));
        if (separator < 0 || separator + 1 >= trimmed.Length)
        {
            return "";
        }

        var name = trimmed[(separator + 1)..];
        if (!string.Equals(name, childName, StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }

        return TrimTrailingDirectorySeparators(trimmed[..separator]);
    }

    private static string CombineWindowsPath(string basePath, string childName)
    {
        var trimmed = TrimTrailingDirectorySeparators(basePath);
        return string.IsNullOrWhiteSpace(trimmed) ? childName : $"{trimmed}\\{childName}";
    }

    private static string TrimTrailingDirectorySeparators(string? path) =>
        (path ?? "").Trim().TrimEnd('\\', '/');

    private string ResolveCommonComputeModeForProduct() =>
        _commonComputeMode == "auto" ? ResolveAutoComputeMode() : NormalizeProductComputeMode(_commonComputeMode);

