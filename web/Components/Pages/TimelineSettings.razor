    private async ValueTask ConfirmInternalNavigation(LocationChangingContext context)
    {
        if (!HasUnsavedChanges())
        {
            return;
        }

        var confirmed = await Js.InvokeAsync<bool>(
            "confirm",
            "変更がまだ適用されていません。このまま移動すると、変更内容は失われます。移動しますか？");
        if (!confirmed)
        {
            context.PreventNavigation();
        }
    }

    private bool ValidateBeforeSave(out string message)
    {
        if (string.IsNullOrWhiteSpace(_timelineDirectory))
        {
            message = "保存先を設定してください。";
            return false;
        }
        if (_tokenToSave is { Length: > 0 } && !ValidateTokenFormat(_tokenToSave, out message))
        {
            return false;
        }
        if (_audioOverview?.ProductFound == true
            && !ValidateDirectorySettings(
                "音声",
                _audioInputRoots.Select(root => root.Path),
                _audioOutputRoot.Path,
                out message))
        {
            return false;
        }
        if (_imageOverview?.ProductFound == true
            && !ValidateDirectorySettings(
                "画像",
                _imageInputRoots.Select(root => root.Path),
                _imageOutputRoot.Path,
                out message))
        {
            return false;
        }
        if (_videoOverview?.ProductFound == true
            && !ValidateDirectorySettings(
                "動画",
                _videoInputRoots.Select(root => root.Path),
                _videoOutputRoot.Path,
                out message))
        {
            return false;
        }

        message = "";
        return true;
    }

    private static bool ValidateDirectorySettings(
        string label,
        IEnumerable<string?> inputPaths,
        string? outputPath,
        out string message)
    {
        if (!inputPaths.Any(path => !string.IsNullOrWhiteSpace(path)))
        {
            message = $"{label}の読み込み場所を設定してください。";
            return false;
        }
        if (string.IsNullOrWhiteSpace(outputPath))
        {
            message = $"{label}の生成データ保存先を設定してください。";
            return false;
        }

        message = "";
        return true;
    }

    private List<SettingsChangeRow> BuildSaveChanges()
    {
        var changes = new List<SettingsChangeRow>();
        var currentTimelineDirectory = string.IsNullOrWhiteSpace(_timelineDraftBaseline.DataDirectory)
            ? DefaultDataRoot
            : _timelineDraftBaseline.DataDirectory;
        AddChange("データ保存先", currentTimelineDirectory, _timelineDirectory);
        AddChange("表示言語", LabelFor(DisplayLanguages, _timelineDraftBaseline.DisplayLanguageId), LabelFor(DisplayLanguages, _displayLanguageId));
        AddChange("タイムゾーン", LabelFor(TimeZones, _timelineDraftBaseline.TimeZoneId), LabelFor(TimeZones, _timeZoneId));
        AddChange("OS起動時の自動起動", StartupToggleLabel(_timelineDraftBaseline.StartWithOperatingSystem), StartupToggleLabel(_startWithOperatingSystem));
        AddChange("AI処理方法", ComputeModeLabel(_timelineDraftBaseline.CommonComputeMode), ComputeModeLabel(_commonComputeMode));
        var currentCommonTokenSignature = CurrentCommonTokenSignature();
        if (HasCommonTokenDraft || !_timelineDraftBaseline.CommonTokenSignature.Equals(currentCommonTokenSignature, StringComparison.OrdinalIgnoreCase))
        {
            changes.Add(new SettingsChangeRow(
                "Hugging Face トークン（基本設定）",
                DisplayTokenSignature(_timelineDraftBaseline.CommonTokenSignature),
                DisplayTokenSignature(currentCommonTokenSignature)));
        }
        if (_applyCommonTokenToProducts)
        {
            var applyTargetSummary = string.IsNullOrWhiteSpace(TokenApplyTargetSummary)
                ? "対象なし"
                : TokenApplyTargetSummary;
            changes.Add(new SettingsChangeRow(
                "Hugging Face トークン反映範囲",
                string.IsNullOrWhiteSpace(TokenOverrideSummary) ? "個別設定なし" : TokenOverrideSummary,
                $"{applyTargetSummary} に基本設定を適用"));
        }

        if (_audioOverview?.ProductFound == true)
        {
            AddChange("音声入力ディレクトリ", _audioDraftBaseline.InputRootsSignature, JoinPaths(_audioInputRoots.Select(root => root.Path)));
            AddChange("TimelineForAudio 生成データ", _audioDraftBaseline.OutputRootPath, _audioOutputRoot.Path);
            AddChange("TimelineForAudio AI処理方法", ComputeModeLabel(_audioDraftBaseline.ComputeMode), ComputeModeLabel(_audioComputeMode));
        }

        if (_imageOverview?.ProductFound == true)
        {
            AddChange("画像入力ディレクトリ", _imageDraftBaseline.InputRootsSignature, JoinPaths(_imageInputRoots.Select(DirectoryDisplay)));
            AddChange("TimelineForImage 生成データ", _imageDraftBaseline.OutputRootPath, _imageOutputRoot.Path);
            AddChange("TimelineForImage AI処理方法", ComputeModeLabel(_imageDraftBaseline.ComputeMode), ComputeModeLabel(_imageComputeMode));
        }

        if (_videoOverview?.ProductFound == true)
        {
            AddChange("動画入力ディレクトリ", _videoDraftBaseline.InputRootsSignature, JoinPaths(_videoInputRoots.Select(DirectoryDisplay)));
            AddChange("TimelineForVideo 生成データ", _videoDraftBaseline.OutputRootPath, _videoOutputRoot.Path);
            AddChange("TimelineForVideo AI処理方法", ComputeModeLabel(_videoDraftBaseline.ComputeMode), ComputeModeLabel(_videoComputeMode));
        }

        foreach (var product in Products)
        {
            var originalProduct = _settings?.ProductRegistry.Products.FirstOrDefault(item => item.Id.Equals(product.Id, StringComparison.OrdinalIgnoreCase));
            AddChange($"{DisplayName(product)} 製品配置先", originalProduct?.Path, product.Path);
        }

        return changes;

        void AddChange(string label, string? before, string? after)
        {
            var beforeValue = NormalizeChangeText(before);
            var afterValue = NormalizeChangeText(after);
            if (!beforeValue.Equals(afterValue, StringComparison.OrdinalIgnoreCase))
            {
                changes.Add(new SettingsChangeRow(label, beforeValue, afterValue));
            }
        }
    }

