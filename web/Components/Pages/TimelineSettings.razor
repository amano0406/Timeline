    private void LoadAudioState(TimelineProductOverview? overview)
    {
        _audioComputeMode = string.IsNullOrWhiteSpace(overview?.ComputeMode) ? "cpu" : overview.ComputeMode;
        _audioInputRoots.Clear();
        _audioInputRoots.AddRange((overview?.InputRoots ?? []).Select(CloneRoot));
        if (_audioInputRoots.Count == 0)
        {
            _audioInputRoots.Add(new RootRow { Id = "audio-1", DisplayName = "Audio", Enabled = true });
        }

        _audioOutputRoot = CloneRoot(overview?.OutputRoot ?? new RootRow
        {
            Id = "master",
            DisplayName = "TimelineForAudio Master",
            Path = ManagedProductDataPath(_timelineDirectory, "audio"),
            Enabled = true,
        });
        if (string.IsNullOrWhiteSpace(_audioOutputRoot.Path))
        {
            _audioOutputRoot.Path = ManagedProductDataPath(_timelineDirectory, "audio");
        }
    }

    private void LoadImageState(ImageOverview? overview)
    {
        _imageInputRoots.Clear();
        foreach (var root in overview?.Settings.InputRoots ?? [])
        {
            _imageInputRoots.Add(CloneRoot(root));
        }

        if (_imageInputRoots.Count == 0)
        {
            _imageInputRoots.Add(new ImageInputRoot
            {
                Id = "input-1",
                DisplayName = "Input",
                Enabled = true,
            });
        }

        _imageOutputRoot = CloneRoot(overview?.Settings.OutputRoot ?? new ImageDirectoryRoot
        {
            Id = "output",
            DisplayName = "Output",
            Path = ManagedProductDataPath(_timelineDirectory, "image"),
            DisplayPath = ManagedProductDataPath(_timelineDirectory, "image"),
        });
        if (string.IsNullOrWhiteSpace(_imageOutputRoot.Path))
        {
            _imageOutputRoot.Path = ManagedProductDataPath(_timelineDirectory, "image");
            _imageOutputRoot.DisplayPath = _imageOutputRoot.Path;
        }
    }

    private void LoadVideoState(VideoOverview? overview)
    {
        _videoInputRoots.Clear();
        foreach (var root in overview?.Settings.InputRoots ?? [])
        {
            _videoInputRoots.Add(CloneRoot(root));
        }

        if (_videoInputRoots.Count == 0)
        {
            _videoInputRoots.Add(new VideoInputRoot
            {
                Id = "input-1",
                DisplayName = "Input",
                Enabled = true,
            });
        }

        _videoOutputRoot = CloneRoot(overview?.Settings.OutputRoot ?? new VideoDirectoryRoot
        {
            Id = "output",
            DisplayName = "Output",
            Path = ManagedProductDataPath(_timelineDirectory, "video"),
