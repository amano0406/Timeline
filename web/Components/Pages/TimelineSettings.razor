    private async Task SaveAsync()
    {
        _saving = true;
        _saved = false;
        _error = null;
        if (_applySteps.Count == 0)
        {
            _applySteps = BuildApplySteps().ToList();
        }
        SetAllPendingApplySteps();
        try
        {
            if (string.IsNullOrWhiteSpace(_timelineDirectory))
            {
                throw new InvalidOperationException("保存先を設定してください。");
            }
            if (_tokenToSave is { Length: > 0 } && !ValidateTokenFormat(_tokenToSave, out var tokenMessage))
            {
                throw new InvalidOperationException(tokenMessage);
            }

            var timelineDirectory = TrimTrailingDirectorySeparators(_timelineDirectory);
            var shouldSaveAudioSettings = ShouldSaveAudioSettings();
            var shouldSaveImageSettings = ShouldSaveImageSettings();
            var shouldSaveVideoSettings = ShouldSaveVideoSettings();
            var shouldApplyCommonTokenToAudio = ShouldApplyCommonTokenToAudio();
            var shouldApplyCommonTokenToVideo = ShouldApplyCommonTokenToVideo();
            SetApplyStepStatus("timeline", "running", "Timeline 本体の設定を書き込んでいます。");
            _settings = await Timeline.SaveTimelineSettingsAsync(new TimelineAppSettingsSaveRequest
            {
                DisplayLanguageId = _displayLanguageId,
                TimeZoneId = _timeZoneId,
                DataRoot = timelineDirectory,
                Startup = new TimelineStartupSettings
                {
                    StartWithOperatingSystem = _startWithOperatingSystem,
                },
                CommonAi = new TimelineCommonAiSettings
                {
                    ComputeMode = _commonComputeMode,
                    HuggingFaceToken = _tokenToSave,
                    ApplyHuggingFaceTokenToProducts = _applyCommonTokenToProducts,
                },
                ProductRegistry = _registry,
            });
            SetApplyStepStatus("timeline", "completed", "Timeline 本体の設定を適用しました。");

            if (shouldApplyCommonTokenToAudio && !shouldSaveAudioSettings)
            {
                SetApplyStepStatus("audio", "running", "TimelineForAudio に基本設定のトークンを反映しています。");
                _audioOverview = await Timeline.GetAudioOverviewAsync();
                LoadAudioState(_audioOverview);
                SetApplyStepStatus("audio", "completed", "TimelineForAudio に基本設定のトークンを反映しました。");
            }

            if (shouldApplyCommonTokenToVideo && !shouldSaveVideoSettings)
            {
                SetApplyStepStatus("video", "running", "TimelineForVideo に基本設定のトークンを反映しています。");
                _videoOverview = await Timeline.GetVideoOverviewAsync();
                LoadVideoState(_videoOverview);
                SetApplyStepStatus("video", "completed", "TimelineForVideo に基本設定のトークンを反映しました。");
            }

            if (shouldSaveAudioSettings)
            {
                SetApplyStepStatus("audio", "running", "TimelineForAudio の設定を書き込んでいます。");
                _audioOverview = await Timeline.SaveAudioSettingsAsync(new AudioSettingsSaveRequest
                {
                    ComputeMode = _audioComputeMode,
                    InputRoots = _audioInputRoots
                        .Where(root => !string.IsNullOrWhiteSpace(root.Path))
                        .Select(CloneRoot)
                        .ToList(),
                    OutputRoot = CloneRoot(_audioOutputRoot),
                    OutputPath = _audioOutputRoot.Path,
                });
                LoadAudioState(_audioOverview);
                SetApplyStepStatus("audio", "completed", "TimelineForAudio の設定を適用しました。");
            }

            if (shouldSaveImageSettings)
            {
                SetApplyStepStatus("image", "running", "TimelineForImage の設定を書き込んでいます。");
                _imageOverview = await Timeline.SaveImageSettingsAsync(new ImageSettingsSaveRequest
                {
                    ComputeMode = _imageComputeMode,
                    InputRoots = _imageInputRoots.Select(CloneRoot).ToList(),
                    OutputRoot = CloneRoot(_imageOutputRoot),
                    OutputRootPath = _imageOutputRoot.Path,
                });
                LoadImageState(_imageOverview);
                SetApplyStepStatus("image", "completed", "TimelineForImage の設定を適用しました。");
            }

            if (shouldSaveVideoSettings)
            {
                SetApplyStepStatus("video", "running", "TimelineForVideo の設定を書き込んでいます。");
                _videoOverview = await Timeline.SaveVideoSettingsAsync(new VideoSettingsSaveRequest
                {
                    InputRoots = _videoInputRoots.Select(CloneRoot).ToList(),
                    OutputRoot = CloneRoot(_videoOutputRoot),
                    OutputRootPath = _videoOutputRoot.Path,
                    ComputeMode = _videoComputeMode,
                });
                LoadVideoState(_videoOverview);
                SetApplyStepStatus("video", "completed", "TimelineForVideo の設定を適用しました。");
            }

            _displayLanguageId = _settings.DisplayLanguageId;
            _timeZoneId = _settings.TimeZoneId;
            _timelineDirectory = TimelineDirectoryFromSettings(_settings);
            _startWithOperatingSystem = _settings.Startup.StartWithOperatingSystem;
            _registry = CloneRegistry(_settings.ProductRegistry);
            _runtime = await Timeline.GetProductRuntimeOverviewAsync();
            _tokenToSave = null;
            _applyCommonTokenToProducts = false;
            CaptureTimelineDraftBaseline();
            if (_audioOverview?.ProductFound == true)
            {
                CaptureAudioDraftBaseline();
            }
            if (_imageOverview?.ProductFound == true)
            {
                CaptureImageDraftBaseline();
            }
            if (_videoOverview?.ProductFound == true)
            {
                CaptureVideoDraftBaseline();
            }
            _saved = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            MarkRunningApplyStepFailed(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

