                <div class="mt-4 rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
                    <div class="font-semibold">先に設計上の注意があります</div>
                    <div class="mt-2 grid gap-1">
                        @foreach (var warning in plan.Warnings)
                        {
                            <div>@TimelineUninstallWarningText(warning)</div>
                        }
                    </div>
                </div>
            }

            @if (selectedLevel is not null)
            {
                <div class="mt-4 rounded-md border border-line bg-white p-3 text-sm text-slate-700">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-semibold text-slate-900">選択中: @selectedLevel.Name</span>
                        @if (selectedLevel.RequiresStrongConfirmation)
                        {
                            <span class="tfa-status-pill border-amber-200 bg-amber-50 text-amber-900">削除実行時は再確認が必要</span>
                        }
                        else
                        {
                            <span class="tfa-status-pill border-teal-200 bg-teal-50 text-teal-800">既定案</span>
                        }
                    </div>
                    <div class="mt-2">
                        ここでは影響範囲の比較だけを行います。実際の削除処理はまだ実装していないため、この選択だけでファイルやDockerリソースは削除されません。
                    </div>
                </div>
            }

            <div class="mt-4 grid gap-3 xl:grid-cols-2">
                @foreach (var level in plan.Levels)
                {
                    var selected = string.Equals(level.Id, _timelineUninstallSelectedLevelId, StringComparison.OrdinalIgnoreCase);
                    <div class="@TimelineUninstallLevelCardClass(level, selected)">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <div class="flex flex-wrap items-center gap-2">
                                <div class="font-semibold text-slate-900">@level.Name</div>
                                @if (selected)
                                {
                                    <span class="tfa-status-pill border-sky-200 bg-sky-50 text-sky-800">選択中</span>
                                }
                            </div>
                            <button type="button"
                                    class="tfa-button-secondary !min-h-8 !px-3 !py-1 text-xs"
                                    disabled="@selected"
                                    @onclick="@(() => SelectTimelineUninstallLevel(level.Id))">
                                選択
                            </button>
                        </div>
                        <div class="mt-2 flex flex-wrap items-center gap-2">
                            @if (level.RecommendedDefault)
                            {
                                <span class="tfa-status-pill border-teal-200 bg-teal-50 text-teal-800">推奨</span>
                            }
                            @if (level.RequiresStrongConfirmation)
                            {
                                <span class="tfa-status-pill border-amber-200 bg-amber-50 text-amber-900">強い確認が必要</span>
                            }
                        </div>
                        <p class="mt-2 text-sm text-slate-600">@level.Description</p>
                        <div class="mt-3 flex flex-wrap gap-2 text-xs">
                            <span class="tfa-status-pill border-slate-200 bg-white text-slate-700">対象 @TimelineUninstallDefaultDeleteCount(level) 件</span>
                            <span class="tfa-status-pill border-slate-200 bg-white text-slate-700">存在確認 @TimelineUninstallExistingCount(level) 件</span>
                            <span class="@TimelineUninstallRiskClass(level)">@TimelineUninstallRiskLabel(level)</span>
                        </div>
                        @if (TimelineUninstallPreviewItems(level).Count > 0)
                        {
                            <div class="mt-3 grid gap-1">
                                @foreach (var item in TimelineUninstallPreviewItems(level))
                                {
                                    <div class="truncate rounded border border-line bg-white px-2 py-1 font-mono text-xs text-slate-500" title="@item.Path">
                                        @TimelineUninstallItemKindLabel(item) / @item.Path
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>;

    private static string TimelineInstallPlanModeLabel(TimelineInstallPlan plan)
    {
        if (!plan.CanExecute)
        {
            return "計画表示のみ";
        }

        return plan.Mode.Equals("read_only", StringComparison.OrdinalIgnoreCase)
            ? "確認のみ"
            : "実行可能";
    }

    private static string TimelineInstallWarningText(TimelineInstallPlanMessage warning) => warning.Code switch
    {
        "data_inside_app_root" => "Timelineデータがアプリ本体の中にあります。インストール/削除では、ユーザーデータを誤って消さない設計が必要です。",
        "settings_inside_app_root" => "settings.json がアプリ本体の中にあります。再インストール後も設定を使う場合は保持が必要です。",
        "developer_launcher_fallback" => "現在の入口は開発用の起動方法に寄っています。製品配布時は常駐ランチャー実行ファイルを直接起動する必要があります。",
        "local_api_unreachable" => string.IsNullOrWhiteSpace(warning.Message) ? "操作機能に接続できないため、インストール計画を確認できません。" : warning.Message,
        _ => string.IsNullOrWhiteSpace(warning.Message) ? warning.Code : warning.Message,
    };

    private static string TimelineInstallRegistrationCardClass(TimelineInstallPlanRegistration target)
    {
        if (!target.Supported)
        {
            return "rounded-md border border-amber-200 bg-white p-4";
        }

        return target.Implemented
            ? "rounded-md border border-teal-200 bg-white p-4"
            : "rounded-md border border-line bg-white p-4";
    }

    private static string TimelineInstallRegistrationPillClass(TimelineInstallPlanRegistration target)
    {
        if (!target.Supported)
        {
            return "tfa-status-pill border-amber-200 bg-amber-50 text-amber-900";
        }

        if (target.Implemented && target.State.Equals("registered", StringComparison.OrdinalIgnoreCase))
        {
            return "tfa-status-pill border-teal-200 bg-teal-50 text-teal-800";
        }

        return target.Implemented
            ? "tfa-status-pill border-slate-200 bg-white text-slate-700"
            : "tfa-status-pill border-sky-200 bg-sky-50 text-sky-800";
    }

    private static string TimelineInstallRegistrationStateLabel(TimelineInstallPlanRegistration target)
    {
        if (!target.Supported)
        {
            return "未対応";
        }

        if (!target.Implemented)
        {
            return target.Required ? "今後必要" : "任意";
        }

        return target.State switch
        {
            "registered" => "登録済み",
            "not_registered" => "未登録",
            "registered_with_different_target" => "更新が必要",
            "failed" => "確認できません",
            _ => string.IsNullOrWhiteSpace(target.State) ? "確認対象" : target.State,
        };
    }

    private static string TimelineInstallRegistrationMessage(TimelineInstallPlanRegistration target)
    {
        if (!string.IsNullOrWhiteSpace(target.Message))
        {
            return target.Message;
        }

        return target.Required
            ? "TimelineをOS上のアプリとして扱うために必要な登録です。"
            : "ユーザー設定に応じて使う登録です。";
    }

    private TimelineUninstallLevel? TimelineUninstallRecommendedLevel =>
        _timelineUninstallPlan?.Levels.FirstOrDefault(level => level.RecommendedDefault)
        ?? _timelineUninstallPlan?.Levels.FirstOrDefault();

    private TimelineUninstallLevel? TimelineUninstallSelectedLevel =>
        _timelineUninstallPlan?.Levels.FirstOrDefault(level => level.Id.Equals(_timelineUninstallSelectedLevelId, StringComparison.OrdinalIgnoreCase))
        ?? TimelineUninstallRecommendedLevel;

    private void EnsureTimelineUninstallSelectedLevel()
    {
        if (_timelineUninstallPlan is null || _timelineUninstallPlan.Levels.Count == 0)
        {
            _timelineUninstallSelectedLevelId = "";
            return;
        }

        if (_timelineUninstallPlan.Levels.Any(level => level.Id.Equals(_timelineUninstallSelectedLevelId, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        _timelineUninstallSelectedLevelId = TimelineUninstallRecommendedLevel?.Id ?? _timelineUninstallPlan.Levels[0].Id;
    }

    private void SelectTimelineUninstallLevel(string levelId)
    {
        _timelineUninstallSelectedLevelId = levelId;
    }

