    private bool HasCommonTokenDraft => _tokenToSave is { Length: > 0 };

    private bool HasSavedCommonToken => _settings?.CommonAi.HasHuggingFaceToken == true;

    private string SavedCommonTokenDisplay =>
        HasSavedCommonToken
            ? EmptyText(_settings?.CommonAi.HuggingFaceTokenPreview)
            : "未設定";

    private string TokenDisplay =>
        HasCommonTokenDraft
            ? MaskToken(_tokenToSave!)
            : SavedCommonTokenDisplay;

    private string TokenStatusLabel =>
        HasCommonTokenDraft
            ? "未適用"
            : HasTokenOverrides
                ? HasSavedCommonToken ? "設定済み（個別設定あり）" : "未設定（個別設定あり）"
                : HasSavedCommonToken ? "設定済み" : "未設定";

    private string TokenStatusIcon =>
        HasCommonTokenDraft || HasSavedCommonToken
            ? "circle-check"
            : HasTokenOverrides ? "triangle-exclamation" : "circle-minus";

    private string TokenStatusIconClass =>
        HasTokenOverrides && !HasCommonTokenDraft
            ? "text-amber-700"
            : HasCommonTokenDraft || HasSavedCommonToken
            ? "text-teal-700"
            : "text-slate-400";

    private bool HasTokenOverrides
    {
        get
        {
            return TokenCapableProductTokens().Any(ProductTokenUsesOverride);
        }
    }

    private string TokenOverrideSummary =>
        string.Join("、", TokenCapableProductTokens()
            .Where(ProductTokenUsesOverride)
            .Select(row => $"{row.ProductName}: {(row.HasToken ? "個別設定あり" : "未設定")}"));

    private bool HasTokenApplyTargets =>
        TokenCapableProductTokens().Any(row => ProductTokenUsesOverride(row) && ProductTokenCanApply(row));

    private string TokenApplyTargetSummary =>
        string.Join("、", TokenCapableProductTokens()
            .Where(row => ProductTokenUsesOverride(row) && ProductTokenCanApply(row))
            .Select(row => row.ProductName));

    private string SavedCommonTokenSignature =>
        HasSavedCommonToken ? NormalizeChangeText(_settings?.CommonAi.HuggingFaceTokenPreview) : "-";

    private string CurrentCommonTokenSignature() =>
        HasCommonTokenDraft ? NormalizeChangeText(MaskToken(_tokenToSave!)) : SavedCommonTokenSignature;

    private static string ProductTokenSignature(ProductTokenRow row) =>
        row.HasToken ? NormalizeChangeText(row.Preview) : "-";

    private bool ProductTokenUsesOverride(ProductTokenRow row) =>
        !ProductTokenSignature(row).Equals(CurrentCommonTokenSignature(), StringComparison.OrdinalIgnoreCase);

    private bool ProductTokenCanApply(ProductTokenRow row) =>
        IsProductRunning(row.ProductId);

    private bool ProductTokenWillApply(string productId) =>
        _applyCommonTokenToProducts && IsProductRunning(productId);

    private static string DisplayTokenSignature(string signature) =>
        signature.Equals("-", StringComparison.OrdinalIgnoreCase) ? "未設定" : signature;

    private static string StartupToggleLabel(bool enabled) =>
        enabled ? "自動起動する" : "自動起動しない";

    private IReadOnlyList<string> ComputeOverrideProductNames
    {
        get
        {
            var productMode = ResolveCommonComputeModeForProduct();
            var names = new List<string>();
            if (ProductComputeModeNeedsAttention(_audioOverview?.ProductFound == true, _audioComputeModeKnown, _audioComputeMode, productMode))
            {
                names.Add("TimelineForAudio");
            }
            if (ProductComputeModeNeedsAttention(_imageOverview?.ProductFound == true, _imageComputeModeKnown, _imageComputeMode, productMode))
            {
                names.Add("TimelineForImage");
            }
            if (ProductComputeModeNeedsAttention(_videoOverview?.ProductFound == true, _videoComputeModeKnown, _videoComputeMode, productMode))
            {
                names.Add("TimelineForVideo");
            }
            return names;
        }
    }

    private IEnumerable<ProductTokenRow> TokenCapableProductTokens()
    {
        if (_audioOverview?.ProductFound == true)
        {
            yield return new ProductTokenRow("audio", "TimelineForAudio", _audioOverview.HasToken, _audioOverview.TokenPreview);
        }
        if (_videoOverview?.ProductFound == true)
        {
            yield return new ProductTokenRow("video", "TimelineForVideo", _videoOverview.Settings.HasToken, _videoOverview.Settings.TokenPreview);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (TryNormalizeProductId(ProductId, out var productId))
        {
            _selectedProductSettingsId = productId;
            _proMode = true;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _saved = false;
        _error = null;
        _modelsLoading = true;
        _audioSettingsLoading = true;
        _imageSettingsLoading = true;
        _videoSettingsLoading = true;
        _timelineInstallPlanLoading = true;
        _timelineInstallPlanError = null;
        _timelineUninstallPlanLoading = true;
        _timelineUninstallPlanError = null;
        try
        {
            var settingsTask = Timeline.GetTimelineSettingsAsync();
            var runtimeTask = Timeline.GetProductRuntimeOverviewAsync();
            var launcherShortcutTask = Timeline.GetLauncherShortcutStatusAsync();
            var installPlanTask = Timeline.GetTimelineInstallPlanAsync();
            var uninstallPlanTask = Timeline.GetTimelineUninstallPlanAsync();

            await Task.WhenAll(settingsTask, runtimeTask, launcherShortcutTask, installPlanTask, uninstallPlanTask);

            _settings = await settingsTask;
            _runtime = await runtimeTask;
            _launcherShortcutStatus = await launcherShortcutTask;
            _timelineInstallPlan = await installPlanTask;
            _timelineUninstallPlan = await uninstallPlanTask;
            EnsureTimelineUninstallSelectedLevel();

            _displayLanguageId = string.IsNullOrWhiteSpace(_settings.DisplayLanguageId) ? "ja-JP" : _settings.DisplayLanguageId;
            _timeZoneId = string.IsNullOrWhiteSpace(_settings.TimeZoneId) ? "Asia/Tokyo" : _settings.TimeZoneId;
            _timelineDirectory = TimelineDirectoryFromSettings(_settings);
            _startWithOperatingSystem = _settings.Startup.StartWithOperatingSystem;
            _commonComputeMode = NormalizeCommonComputeMode(_settings.CommonAi.ComputeMode);
            _registry = CloneRegistry(_settings.ProductRegistry);
            _tokenToSave = null;
            _applyCommonTokenToProducts = false;
            _tokenDraftApplyToProducts = false;
            CaptureTimelineDraftBaseline();

            _audioInputRoots.Clear();
            _imageInputRoots.Clear();
            _videoInputRoots.Clear();
            EnsureSelectedProductSettings();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _modelsLoading = false;
            _audioSettingsLoading = false;
            _imageSettingsLoading = false;
            _videoSettingsLoading = false;
            _timelineInstallPlanLoading = false;
            _timelineInstallPlanError = ex.Message;
            _timelineUninstallPlanLoading = false;
            _timelineUninstallPlanError = ex.Message;
        }
        finally
        {
            _loading = false;
            _timelineInstallPlanLoading = false;
            _timelineUninstallPlanLoading = false;
            await InvokeAsync(StateHasChanged);
        }

        if (_settings is not null && HasInstalledProducts)
        {
            _ = LoadAudioOverviewLaterAsync();
            _ = LoadImageOverviewLaterAsync();
            _ = LoadVideoOverviewLaterAsync();
            _ = LoadModelInventoriesLaterAsync();
        }
        else
        {
            _modelsLoading = false;
            _audioSettingsLoading = false;
            _imageSettingsLoading = false;
            _videoSettingsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAudioOverviewLaterAsync()
    {
        try
        {
            _audioOverview = await Timeline.GetAudioOverviewAsync();
            LoadAudioState(_audioOverview);
            CaptureAudioDraftBaseline();
            await ValidateKnownDirectoryPathsAsync();
        }
        catch (Exception ex)
        {
            _error ??= ex.Message;
        }
        finally
        {
            _audioSettingsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadImageOverviewLaterAsync()
    {
        try
        {
            _imageOverview = await Timeline.GetImageOverviewAsync();
            LoadImageState(_imageOverview);
            CaptureImageDraftBaseline();
            await ValidateKnownDirectoryPathsAsync();
        }
        catch (Exception ex)
        {
            _error ??= ex.Message;
        }
        finally
        {
            _imageSettingsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadVideoOverviewLaterAsync()
    {
        try
        {
            _videoOverview = await Timeline.GetVideoOverviewAsync();
            LoadVideoState(_videoOverview);
            CaptureVideoDraftBaseline();
            await ValidateKnownDirectoryPathsAsync();
        }
        catch (Exception ex)
        {
            _error ??= ex.Message;
        }
        finally
        {
            _videoSettingsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadModelInventoriesLaterAsync()
    {
        _audioModels = await LoadModelInventoryIfRunningAsync(
            "audio",
            "TimelineForAudio",
            () => Timeline.GetAudioModelsAsync());
        _imageModels = await LoadModelInventoryIfRunningAsync(
            "image",
            "TimelineForImage",
            () => Timeline.GetImageModelsAsync());
        _modelsLoading = false;
