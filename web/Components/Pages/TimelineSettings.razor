    private void SetApplyStepStatus(string id, string status, string message)
    {
        _applySteps = _applySteps
            .Select(step => step.Id.Equals(id, StringComparison.OrdinalIgnoreCase)
                ? step with { Status = status, Message = message }
                : step)
            .ToList();
        _ = InvokeAsync(StateHasChanged);
