        "settings_inside_app_root" => "settings.json がアプリ本体の中にあります。再インストール後も設定を使う場合は保持が必要です。",
        "local_api_unreachable" => string.IsNullOrWhiteSpace(warning.Message) ? "操作機能に接続できないため、削除対象を確認できません。" : warning.Message,
