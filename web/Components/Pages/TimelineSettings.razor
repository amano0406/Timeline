    private bool HasAiGpuDeviceForDisplay =>
        _settings?.CommonAi.AiGpuAvailable == true
        || ComputeModeResolver.HasAiGpuDevice(GpuDevices);

    private string CommonComputeModeReason => _commonComputeMode switch
    {
        "gpu" => "手動でGPUを選択しています。対応製品へ適用すると、AI処理はGPU利用を前提に動きます。",
        "cpu" => "手動でCPUを選択しています。対応製品へ適用すると、GPUがあってもCPU利用を前提に動きます。",
