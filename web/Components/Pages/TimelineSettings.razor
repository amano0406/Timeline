    private static string JoinPaths(IEnumerable<string?> paths)
    {
        var values = paths
            .Select(NormalizeChangeText)
            .Where(value => value != "-")
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return values.Count == 0 ? "-" : string.Join(" / ", values);
    }

    private static string PathListSignature(IEnumerable<string?> paths) =>
        JoinPaths(paths);

    private static string ProductRegistrySignature(TimelineProductRegistry registry)
    {
        var products = registry.Products ?? [];
        return string.Join(
            "\n",
            products
                .OrderBy(product => product.Id, StringComparer.OrdinalIgnoreCase)
                .Select(product => string.Join(
                    "|",
                    NormalizeChangeText(product.Id),
                    NormalizeChangeText(product.DisplayName),
                    NormalizePathForCompare(product.Path),
                    NormalizeChangeText(product.SourceType),
                    NormalizeChangeText(product.SourceUrl),
                    NormalizeChangeText(product.Version),
                    product.Enabled ? "enabled" : "disabled",
                    product.Required ? "required" : "optional")));
    }

    private static string NormalizeChangeText(string? value)
    {
        var text = TrimTrailingDirectorySeparators(value);
        return string.IsNullOrWhiteSpace(text) ? "-" : text;
    }

    private static string NormalizePathForCompare(string? value) =>
        NormalizeChangeText(value);

    private static string DirectoryStatusKey(string? value)
