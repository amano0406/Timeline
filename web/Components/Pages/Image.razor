@page "/image"
@inject TimelineLocalApiClient Timeline
@inject IJSRuntime Js

<PageTitle>画像ファイル一覧 - Timeline</PageTitle>

<TimelineBreadcrumbs>
    <a href="scan">スキャン</a>
    <span class="tfa-breadcrumb-separator">/</span>
    <span aria-current="page">画像ファイル一覧</span>
</TimelineBreadcrumbs>

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="image" Class="tfa-icon text-accent" />
            <span>画像ファイル一覧</span>
        </h1>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="tfa-button-secondary gap-2" @onclick="LoadAsync" disabled="@Busy">
            <FaIcon Name="rotate" Class="@($"tfa-icon {(_loading ? "fa-spin" : "")}")" />
            <span>一覧更新</span>
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_operationMessage is not null)
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="circle-info" Class="tfa-icon mt-0.5" />
        <span>@_operationMessage</span>
    </div>
}

@if (_loading && _overview is null)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else if (_overview is not null)
{
    @if (!_overview.ProductFound)
    {
        <div class="tfa-alert-danger mb-5 flex items-start gap-2">
            <FaIcon Name="folder-open" Class="tfa-icon mt-0.5" />
            <span>TimelineForImage が見つかりません。</span>
        </div>
    }
    else if (!_overview.SettingsValid)
    {
        <div class="tfa-alert-warn mb-5 flex items-start gap-2">
            <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
            <span>@EmptyText(_overview.Message)</span>
        </div>
    }

    @if (ShowInputDirectoryWarning)
    {
        <div class="tfa-alert-warn mb-5 flex items-start gap-2">
            <FaIcon Name="folder-open" Class="tfa-icon mt-0.5" />
            <div>
                <div>@InputDirectoryWarningTitle</div>
                <div class="mt-1 break-all font-mono text-xs">@InputDirectoryWarningDetail</div>
            </div>
        </div>
    }

    <div class="tfa-summary-grid">
        <section class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="tfa-kicker">取り込み済み</div>
                    <div class="mt-2 text-3xl font-semibold">@ImportedFileCountLabel</div>
                </div>
                <span class="tfa-icon-box text-emerald-700">
                    <FaIcon Name="images" Class="tfa-icon" />
                </span>
            </div>
        </section>
    </div>

    <section class="tfa-card tfa-list-card mt-5 overflow-hidden">
        <div class="tfa-card-pad flex items-center justify-between gap-3 border-b border-line">
            <h2 class="flex items-center gap-2 text-lg font-semibold">
                <FaIcon Name="images" Class="tfa-icon text-accent" />
                <span>アイテム一覧</span>
            </h2>
        </div>

        @if (_loadingMore)
        {
            <div class="p-5 text-sm text-slate-600">
                <div class="flex items-center gap-3">
                    <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
                    <span>読み込み中</span>
                </div>
            </div>
        }
        else if (Items.Count == 0)
        {
            <div class="p-5 text-sm text-slate-600">画像はありません。</div>
        }
        else
        {
            <div class="tfa-file-actionbar">
                <div class="tfa-file-actionbar-count">
                    <FaIcon Name="check-square" Class="tfa-icon text-slate-500" />
                    <span>@SelectionSummary</span>
                </div>
                <div class="tfa-file-actionbar-actions">
                    <button class="tfa-button-secondary gap-2" @onclick="DeleteSelectedAsync" disabled="@(Busy || !HasGeneratedSelection)">
                        <FaIcon Name="@(_deleting ? "spinner" : "trash-can")" Class="@($"tfa-icon {(_deleting ? "fa-spin" : "")}")" />
                        <span>生成物を削除</span>
                    </button>
                    <button class="tfa-button-secondary gap-2" @onclick="DownloadSelectedAsync" disabled="@(Busy || !HasGeneratedSelection)">
                        <FaIcon Name="@(_downloading ? "spinner" : "download")" Class="@($"tfa-icon {(_downloading ? "fa-spin" : "")}")" />
                        <span>ダウンロード</span>
                    </button>
                    <button class="tfa-button-secondary gap-2" @onclick="DownloadAllAsync" disabled="@(Busy || _overview.ItemCount == 0)">
                        <FaIcon Name="@(_downloading ? "spinner" : "download")" Class="@($"tfa-icon {(_downloading ? "fa-spin" : "")}")" />
                        <span>すべてダウンロード</span>
                    </button>
                    <button class="tfa-button-secondary gap-2" @onclick="ClearSelection" disabled="@(Busy || !HasSelection)">
                        <FaIcon Name="xmark" Class="tfa-icon" />
                        <span>選択解除</span>
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto tfa-long-list-scroll tfa-list-scroll">
                <div class="tfa-file-tree tfa-file-tree-image" role="treegrid" aria-label="画像アイテム一覧">
                    <div class="tfa-file-tree-header" role="row">
                        <div class="tfa-file-tree-select" role="columnheader">
                            <input type="checkbox"
                                   checked="@AllSelected"
                                   @onchange="ToggleAll"
                                   disabled="@Busy"
                                   aria-label="すべての画像を選択" />
                        </div>
                        <div role="columnheader">名前</div>
                        <div role="columnheader">日時</div>
                        <div role="columnheader">サイズ</div>
                        <div role="columnheader">生成物</div>
                    </div>

                    @foreach (var row in BuildTreeRows(Items))
                    {
                        <div class="@TreeRowClass(row)" role="row">
                            <div class="tfa-file-tree-select" role="gridcell">
                                <span class="tfa-file-tree-check">
                                    <input type="checkbox"
                                           checked="@IsTreeRowSelected(row)"
                                           @onchange="args => ToggleTreeRow(row, IsChecked(args))"
                                           disabled="@(Busy || row.ItemIds.Count == 0)"
                                           aria-label="@SelectionLabel(row)" />
                                    @if (IsTreeRowPartiallySelected(row))
                                    {
                                        <span class="tfa-file-tree-check-partial"></span>
                                    }
                                </span>
                            </div>
                            <div class="tfa-file-tree-name" role="gridcell">
                                <span class="tfa-file-tree-indent" style="@TreeIndentStyle(row.Depth)"></span>
                                <FaIcon Name="@(row.File is null ? "folder" : "image")"
                                        Class="@($"tfa-icon {(row.File is null ? "text-slate-500" : "text-accent")}")" />
                                @if (row.File is null)
                                {
                                    <span class="tfa-file-tree-directory-name">@row.Name</span>
                                }
                                else
                                {
                                    <a class="tfa-file-tree-file-name" href="@DetailHref(row.File)" title="画像詳細を開く">
                                        @row.Name
                                    </a>
                                }
                            </div>

                            @if (row.File is null)
                            {
                                <div role="gridcell"></div>
                                <div role="gridcell"></div>
                                <div role="gridcell"></div>
                            }
                            else
                            {
                                var item = row.File;
                                <div class="tfa-file-tree-meta" role="gridcell">@ShortDate(item.ModifiedAt)</div>
                                <div class="tfa-file-tree-meta" role="gridcell">@FormatBytes(item.SizeBytes)</div>
                                <div class="tfa-file-tree-meta" role="gridcell">
                                    <span class="@ArtifactPillClass(item)">
                                        <FaIcon Name="file-lines" Class="tfa-icon !h-3 !w-3" />
                                        <span>@ArtifactLabel(item)</span>
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <PaginationControls CurrentPage="@_currentPage"
                                PageSize="@PageSize"
                                TotalItems="@ListTotalItems"
                                Disabled="@Busy"
                                Label="画像ファイル一覧のページ移動"
                                PageChanged="ChangePageAsync" />
        }
    </section>
}
