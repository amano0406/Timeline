@page "/"
@using System.Globalization
@inject TimelineHelperClient Timeline
@implements IDisposable

<PageTitle>Timeline</PageTitle>

<div class="mb-6 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
    <div>
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="gauge-high" Class="tfa-icon text-accent" />
            <span>ダッシュボード</span>
        </h1>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="tfa-button-secondary gap-2" @onclick="LoadAsync" disabled="@(_loading || _loadingDetails)">
            <FaIcon Name="rotate" Class="@($"tfa-icon {((_loading || _loadingDetails) ? "fa-spin" : "")}")" />
            <span>状態更新</span>
        </button>
        <a class="tfa-button-primary gap-2" href="scan">
            <FaIcon Name="arrows-rotate" Class="tfa-icon" />
            <span>スキャンを開く</span>
        </a>
    </div>
</div>

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_loading && _store is null)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else
{
    <section class="@($"tfa-card tfa-card-pad mb-5 border-l-4 {DashboardToneClass}")">
        <div class="grid gap-5 xl:grid-cols-[minmax(0,1.5fr)_minmax(280px,.8fr)] xl:items-center">
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-3">
                    <span class="@($"tfa-icon-box {DashboardIconToneClass}")">
                        <FaIcon Name="@DashboardIcon" Class="tfa-icon" />
                    </span>
                    <div>
                        <div class="text-sm font-semibold text-slate-500">今日の状態</div>
                        <div class="text-2xl font-bold text-slate-950">@DashboardHeadline</div>
                    </div>
                </div>
                <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600">@DashboardMessage</p>
            </div>

            <div class="rounded-md border border-line bg-slate-50 p-4">
                <div class="text-sm font-semibold text-slate-500">次のおすすめ</div>
                <div class="mt-1 text-lg font-bold text-slate-950">@NextActionTitle</div>
                <p class="mt-2 text-sm leading-6 text-slate-600">@NextActionText</p>
                <div class="mt-4">
                    @if (NextActionKind == "settings")
                    {
                        <a class="tfa-button-primary gap-2" href="timeline/settings">
                            <FaIcon Name="sliders" Class="tfa-icon" />
                            <span>@NextActionButton</span>
                        </a>
                    }
                    else if (NextActionKind == "products")
                    {
                        <a class="tfa-button-primary gap-2" href="timeline/products">
                            <FaIcon Name="boxes-stacked" Class="tfa-icon" />
                            <span>@NextActionButton</span>
                        </a>
                    }
                    else
                    {
                        <a class="tfa-button-primary gap-2" href="@NextActionHref">
                            <FaIcon Name="arrow-right" Class="tfa-icon" />
                            <span>@NextActionButton</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="mb-5 grid gap-5 xl:grid-cols-3">
        <div class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="text-sm font-semibold text-slate-500">時間軸イベント</div>
                    <div class="mt-2 text-3xl font-bold text-slate-950">@FormatNumber(_store?.EventCount ?? 0)</div>
                    <div class="mt-1 text-sm text-slate-500">項目 @FormatNumber(_store?.ItemCount ?? 0) 件</div>
                </div>
                <span class="tfa-icon-box text-teal-700">
                    <FaIcon Name="timeline" Class="tfa-icon" />
                </span>
            </div>
        </div>

        <div class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="text-sm font-semibold text-slate-500">取り込み済み素材</div>
                    <div class="mt-2 text-3xl font-bold text-slate-950">@FormatNumber(TotalImportedItems)</div>
                    <div class="mt-1 text-sm text-slate-500">サブ製品 @FormatNumber(AvailableProductCount) / @FormatNumber(TotalProductCount)</div>
                </div>
                <span class="tfa-icon-box text-indigo-700">
                    <FaIcon Name="database" Class="tfa-icon" />
                </span>
            </div>
        </div>

        <div class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="text-sm font-semibold text-slate-500">言語化待ち</div>
                    <div class="mt-2 text-3xl font-bold text-slate-950">@VerbalizationTargetDisplay</div>
                    <div class="mt-1 text-sm text-slate-500">@VerbalizationStateLabel</div>
                </div>
                <span class="tfa-icon-box text-amber-700">
                    <FaIcon Name="language" Class="tfa-icon" />
                </span>
            </div>
        </div>
    </section>

    <div class="grid gap-5 xl:grid-cols-[minmax(0,1.05fr)_minmax(0,.95fr)]">
        <section class="tfa-card">
            <div class="tfa-card-pad border-b border-line">
                <h2 class="flex items-center gap-2 text-xl font-bold text-slate-950">
                    <FaIcon Name="list-check" Class="tfa-icon text-accent" />
                    <span>確認が必要なこと</span>
                </h2>
            </div>
            <div class="tfa-card-pad">
                @if (_alerts.Count == 0)
                {
                    <div class="rounded-md border border-teal-200 bg-teal-50 p-4 text-sm text-teal-900">
                        すぐに対応が必要な項目はありません。
                    </div>
                }
                else
                {
                    <div class="grid gap-3">
                        @foreach (var alert in _alerts)
                        {
                            <div class="@($"rounded-md border p-4 {AlertClass(alert.Severity)}")">
                                <div class="flex items-start gap-3">
                                    <FaIcon Name="@AlertIcon(alert.Severity)" Class="tfa-icon mt-0.5 shrink-0" />
                                    <div class="min-w-0">
                                        <div class="font-semibold">@alert.Title</div>
                                        <div class="mt-1 text-sm leading-6">@alert.Message</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="tfa-card">
            <div class="tfa-card-pad border-b border-line">
                <h2 class="flex items-center gap-2 text-xl font-bold text-slate-950">
                    <FaIcon Name="chart-line" Class="tfa-icon text-accent" />
                    <span>Timeline の成長</span>
                </h2>
            </div>
            <div class="tfa-card-pad">
                @if (ProductContributions.Count == 0)
                {
                    <div class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
                        時間軸データはまだ作成されていません。
                    </div>
                }
                else
                {
                    <div class="grid gap-4">
                        @foreach (var product in ProductContributions)
                        {
                            <div>
                                <div class="mb-1 flex items-center justify-between gap-3 text-sm">
                                    <span class="font-semibold text-slate-700">@DisplayProductName(product.ProductId, product.DisplayName)</span>
                                    <span class="text-slate-500">@FormatNumber(product.EventCount) 件</span>
                                </div>
                                <div class="h-3 overflow-hidden rounded-full bg-slate-200">
                                    <div class="h-full rounded-full bg-teal-600 transition-[width]" style="@ContributionBarStyle(product.EventCount)"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="mt-5 rounded-md border border-line bg-slate-50 p-3 text-sm text-slate-600">
                    最終構築: @FormatDateTime(_store?.CreatedAt)
                </div>
            </div>
        </section>
    </div>

    <section class="tfa-card mt-5">
        <div class="tfa-card-pad border-b border-line">
            <h2 class="flex items-center gap-2 text-xl font-bold text-slate-950">
                <FaIcon Name="layer-group" Class="tfa-icon text-accent" />
                <span>素材別の状況</span>
            </h2>
        </div>
        @if (DataSources.Count == 0)
        {
            <div class="p-4">
                <div class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
                    製品をインストールすると、取り込み状況をここで確認できます。
                </div>
            </div>
        }
        else
        {
            <div class="grid gap-4 p-4 lg:grid-cols-2">
                @foreach (var source in DataSources)
                {
                    <div class="rounded-md border border-line bg-slate-50 p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2 font-bold text-slate-950">
                                    <FaIcon Name="@source.Icon" Class="tfa-icon text-accent" />
                                    <span>@source.Name</span>
                                </div>
                                <div class="mt-2 text-sm text-slate-500">@source.Description</div>
                            </div>
                            <span class="@($"tfa-status-pill {SourceStateClass(source)}")">@source.StateLabel</span>
                        </div>
                        <div class="mt-4 grid grid-cols-2 gap-3">
                            @foreach (var metric in source.Metrics)
                            {
                                <div class="rounded-md border border-line bg-white p-3">
                                    <div class="text-xs font-semibold text-slate-500">@metric.Label</div>
                                    <div class="mt-1 text-lg font-bold text-slate-950">@metric.Value</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}
