    private static string ContentPreview(string value)
    {
        var text = (value ?? "").Trim();
        if (string.IsNullOrWhiteSpace(text))
        {
            return "-";
        }
        const int limit = 600;
        return text.Length <= limit ? text : $"{text[..limit]}...";
    }

    private static string EmptyText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string LlmPreviewMessageLabel(string message) =>
        message switch
        {
            "Timeline LLM input preview reached the scan limit before scanning all matching events." => "一部だけ確認しています。正確な全件処理は専用ジョブで扱います。",
            "Timeline LLM input preview reached the scan limit before filling the page." => "一部だけ確認しています。正確な全件処理は専用ジョブで扱います。",
            _ => message,
        };

    private static string LlmPreviewNoteLabel(string note)
    {
        if (note.StartsWith("Audio phone tokens were verbalized by Timeline. Status:", StringComparison.OrdinalIgnoreCase))
        {
            var status = note.Split(':', StringSplitOptions.TrimEntries).LastOrDefault()?.TrimEnd('.') ?? "";
            return $"音声言語化: {AudioVerbalizationCandidateStatusLabel(status)}";
        }

        if (note.StartsWith("Audio verbalization confidence:", StringComparison.OrdinalIgnoreCase))
        {
            var value = note.Split(':', StringSplitOptions.TrimEntries).LastOrDefault()?.TrimEnd('.') ?? "";
            return $"信頼度: {value}";
        }

        if (note.Equals("Text was truncated for preview.", StringComparison.OrdinalIgnoreCase))
        {
            return "一部表示";
        }

        return note;
    }

    private static string AudioVerbalizationCandidateStatusLabel(string status) =>
        status.ToLowerInvariant() switch
        {
            "candidate" => "候補",
            "needs_review" => "要確認",
            "stale" => "再言語化必要",
            "completed" => "完了",
            _ => string.IsNullOrWhiteSpace(status) ? "-" : status,
        };

    private static string DownloadFileUrl(string archivePath) =>
        $"api/download/file?path={Uri.EscapeDataString(archivePath)}";

    private static string ArchiveFileName(string archivePath, string fallback)
    {
        var text = (archivePath ?? "").Trim().Replace('\\', '/');
        var fileName = text.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
        return string.IsNullOrWhiteSpace(fileName) ? fallback : fileName;
    }

    public void Dispose()
    {
        _operationMessageAutoClearCts?.Cancel();
        _operationMessageAutoClearCts?.Dispose();
        _pollingCts?.Cancel();
        _pollingCts?.Dispose();
    }
}
