@page "/scan"
@page "/timeline"
@inject TimelineHelperClient Timeline
@inject TimelineStoreExportService TimelineExport
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>スキャン - Timeline</PageTitle>

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="timeline" Class="tfa-icon text-accent" />
            <span>スキャン</span>
        </h1>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="tfa-button-secondary gap-2" @onclick="LoadAsync" disabled="@Busy">
            <FaIcon Name="rotate" Class="@($"tfa-icon {(_loading ? "fa-spin" : "")}")" />
            <span>状態更新</span>
        </button>
        <button class="tfa-button-primary gap-2" @onclick="OpenScanStartModal" disabled="@(_loading || _downloading || ScanActive)">
            <FaIcon Name="@ScanButtonIcon" Class="@($"tfa-icon {ScanButtonIconSpin}")" />
            <span>@ScanButtonLabel</span>
        </button>
        @if (ScanActive)
        {
            <button class="tfa-button-secondary gap-2" @onclick="CancelScanAsync" disabled="@(!CanCancelScan)">
                <FaIcon Name="@(_cancelingScan ? "spinner" : "stop")" Class="@($"tfa-icon {(_cancelingScan ? "fa-spin" : "")}")" />
                <span>@(_cancelingScan ? "停止中" : "停止")</span>
            </button>
        }
        <button class="tfa-button-secondary gap-2" @onclick="DownloadAsync" disabled="@(!CanDownload || Busy)">
            <FaIcon Name="@(_downloading ? "spinner" : "download")" Class="@($"tfa-icon {(_downloading ? "fa-spin" : "")}")" />
            <span>@(_downloading ? "作成中" : "ダウンロード")</span>
        </button>
    </div>
</div>

@if (_scanStartModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4" role="dialog" aria-modal="true" aria-labelledby="scan-start-title" @onclick="CloseScanStartModal">
        <section class="tfa-scan-start-dialog tfa-card" @onclick:stopPropagation="true">
            <div class="tfa-scan-start-head">
                <div class="flex min-w-0 items-center gap-3">
                    <span class="tfa-icon-box text-teal-800">
                        <FaIcon Name="timeline" Class="tfa-icon" />
                    </span>
                    <div class="min-w-0">
                        <h2 id="scan-start-title" class="text-lg font-semibold text-slate-950">スキャンを開始しますか？</h2>
                        <p class="mt-1 text-sm text-slate-600">各サブ製品のデータを取り込み、Timeline の時間軸を作成します。</p>
                    </div>
                </div>
                <button type="button" class="tfa-button-secondary tfa-scan-start-close" aria-label="閉じる" @onclick="CloseScanStartModal">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                </button>
            </div>
            <div class="tfa-scan-start-body">
                <label class="tfa-scan-chatgpt-option">
                    <input type="checkbox" @bind="_includeChatGptExportInScan" />
                    <span class="tfa-scan-chatgpt-option-text">
                        <strong>ChatGPT エクスポートZIPも取り込む</strong>
                        <span>ChatGPT の履歴を更新してから時間軸へ反映します。ZIPは読み取り専用で扱い、元ファイルは変更しません。</span>
                    </span>
                </label>

                @if (_includeChatGptExportInScan)
                {
                    <div class="tfa-scan-chatgpt-picker">
                        <div class="min-w-0">
                            <div class="tfa-kicker">選択中のZIP</div>
                            <div class="tfa-scan-chatgpt-path">@ChatGptExportZipLabel</div>
                        </div>
                        <button type="button" class="tfa-button-secondary shrink-0 gap-2" @onclick="PickChatGptExportZipAsync">
                            <FaIcon Name="file-zipper" Class="tfa-icon" />
                            <span>ZIPを選択</span>
                        </button>
                    </div>
                    @if (ScanStartNeedsChatGptZip)
                    {
                        <div class="tfa-alert-warn mt-3">ChatGPT を取り込む場合は、エクスポートZIPを選択してください。</div>
                    }
                }
            </div>
            <div class="tfa-scan-start-foot">
                <button type="button" class="tfa-button-secondary gap-2" @onclick="CloseScanStartModal">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>キャンセル</span>
                </button>
                <button type="button" class="tfa-button-primary gap-2" @onclick="ConfirmScanStartAsync" disabled="@ScanStartNeedsChatGptZip">
                    <FaIcon Name="arrows-rotate" Class="tfa-icon" />
                    <span>スキャンを始める</span>
                </button>
            </div>
        </section>
    </div>
}

@if (_error is not null && !ScanFailed)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (ScanFailed)
{
    <section class="tfa-scan-failed-panel mb-5" role="alert">
        <div class="flex items-start gap-3">
            <span class="tfa-scan-failed-icon" aria-hidden="true">
                <FaIcon Name="triangle-exclamation" Class="tfa-icon" />
            </span>
            <div class="min-w-0">
                <div class="text-sm font-semibold">スキャンが停止しました</div>
                <div class="mt-1 text-sm leading-6">@(_workerStatus?.Message ?? "自動処理に失敗しました。")</div>
            </div>
        </div>
        <div class="tfa-scan-failure-details">
            <div class="tfa-scan-failure-row">
                <span>失敗した工程</span>
                <strong>@ScanFailurePhaseTitle</strong>
            </div>
            <div class="tfa-scan-failure-row">
                <span>原因</span>
                <strong>@ScanFailureCause</strong>
            </div>
            <div class="tfa-scan-failure-help">@ScanFailureHelp</div>
        </div>
        @if (_workerStatus?.ProductJob is { } failedProductJob)
        {
            <div class="mt-4 rounded-md border border-red-200 bg-white/80 p-4">
                <div class="flex flex-wrap items-center gap-2 text-sm font-semibold text-slate-900">
                    <FaIcon Name="list-check" Class="tfa-icon text-red-700" />
                    <span>@ProductJobProductLabel(failedProductJob) の処理状況</span>
                    <span class="@StepPillClass(failedProductJob.State)">@ProductJobStateLabel(failedProductJob.State)</span>
                </div>
                <div class="mt-1 text-sm leading-6 text-slate-700">
                    @FormatProductJobStatusLine(failedProductJob)
                </div>
                @if (!string.IsNullOrWhiteSpace(failedProductJob.Error))
                {
                    <div class="mt-2 text-sm leading-6 text-red-800">@failedProductJob.Error</div>
                }
            </div>
        }
    </section>
}
else if (ShouldShowOperationMessage && ScanActive)
{
    var remainingItems = RemainingScanPhaseItems;
    var productJob = ActiveProductJob;
    <section class="tfa-scan-running-panel mb-5" role="status" aria-live="polite">
        <div class="flex items-start gap-3">
            <span class="tfa-scan-running-spinner" aria-hidden="true">
                <FaIcon Name="spinner" Class="tfa-icon fa-spin" />
            </span>
            <div class="min-w-0">
                <div class="text-sm font-semibold">@ScanOperationTitle</div>
                <div class="mt-1 text-sm leading-6">@_operationMessage</div>
            </div>
        </div>
        <div class="tfa-scan-running-meter" aria-hidden="true">
            <span></span>
        </div>
        @if (ShouldShowProductJobProgress && productJob is not null)
        {
            <div class="mt-4 rounded-md border border-sky-200 bg-white/80 p-4">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2 text-sm font-semibold text-slate-900">
                            <FaIcon Name="list-check" Class="tfa-icon text-sky-700" />
                            <span>@ProductJobTitle</span>
                            <span class="@StepPillClass(productJob.State)">@ProductJobStateLabel(productJob.State)</span>
                        </div>
                        <div class="mt-1 text-sm leading-6 text-slate-600">@ProductJobStatusLine</div>
                    </div>
                    <div class="font-mono text-lg font-bold text-slate-900">@ProgressLabel(productJob.Progress.Percent)</div>
                </div>
                <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-200" role="progressbar"
                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ProgressAriaValue(productJob.Progress.Percent)">
                    <div class="h-full rounded-full bg-sky-600 transition-all" style="@ProgressBarStyle(productJob.Progress.Percent)"></div>
                </div>
            </div>
        }
        @if (remainingItems.Count > 0)
        {
            <div class="tfa-scan-remaining">
                <div class="tfa-scan-remaining-title">残っている処理</div>
                <div class="tfa-scan-remaining-list">
                    @foreach (var item in remainingItems)
                    {
                        <div class="@ScanPhaseRemainingItemClass(item.Phase)">
                            <span class="tfa-scan-remaining-icon" aria-hidden="true">
                                <FaIcon Name="@item.Icon" Class="tfa-icon" />
                            </span>
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="font-semibold">@item.Label</span>
                                    <span class='@ScanPhasePillClass(item.Phase)'>@ScanPhaseStateLabel(item.Phase)</span>
                                </div>
                                <div class="mt-1 text-sm leading-6">@ScanPhaseDetail(item.Phase)</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </section>
}
else if (ShouldShowOperationMessage)
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="circle-info" Class="tfa-icon mt-0.5" />
        <span>@_operationMessage</span>
    </div>
}

@if (_loading && _overview is null)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else
{
    @if (_overview?.Available != true && !ScanActive)
    {
        <section class="tfa-card tfa-card-pad tfa-scan-empty mb-5">
            <div class="flex items-start gap-4">
                <span class="tfa-icon-box text-teal-700">
                    <FaIcon Name="timeline" Class="tfa-icon" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-xl font-bold text-slate-950">まずスキャンを始めてください</h2>
                    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">@StoreMessage</p>
                    <div class="mt-5 flex">
                        <button class="tfa-button-primary tfa-scan-empty-action gap-2"
                            @onclick="OpenScanStartModal"
                            disabled="@(_loading || _downloading || ScanActive)">
                            <FaIcon Name="@ScanButtonIcon" Class="@($"tfa-icon {ScanButtonIconSpin}")" />
                            <span>@(ScanActive ? "処理中" : "スキャンを始める")</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>
    }

    <section class="mb-5 grid gap-4 md:grid-cols-3">
        <div class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                    <div class="text-sm font-semibold text-slate-500">時間軸イベント</div>
                    <div class="mt-2 text-3xl font-bold text-slate-950">
                        @(_overview?.Available == true ? FormatNumber(_overview.EventCount) : "-")
                    </div>
                    <div class="mt-1 text-sm text-slate-500">項目 @(_overview?.Available == true ? FormatNumber(_overview.ItemCount) : "-") 件</div>
                </div>
                <span class="tfa-icon-box text-teal-700">
                    <FaIcon Name="timeline" Class="tfa-icon" />
                </span>
            </div>
        </div>
        <div class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                    <div class="text-sm font-semibold text-slate-500">取り込み済み素材</div>
                    <div class="mt-2 text-3xl font-bold text-slate-950">@FormatNumber(ScanTotalImportedItems)</div>
                    <div class="mt-1 text-sm text-slate-500">サブ製品 @FormatNumber(ScanAvailableProductCount) / @FormatNumber(ScanTotalProductCount)</div>
                </div>
                <span class="tfa-icon-box text-slate-700">
                    <FaIcon Name="database" Class="tfa-icon" />
                </span>
            </div>
        </div>
        <div class="tfa-card tfa-card-pad">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                    <div class="text-sm font-semibold text-slate-500">言語化待ち</div>
                    <div class="mt-2 text-3xl font-bold text-slate-950">@ScanVerbalizationTargetDisplay</div>
                    <div class="mt-1 text-sm text-slate-500">@ScanVerbalizationStateLabel</div>
                </div>
                <span class="tfa-icon-box text-orange-700">
                    <FaIcon Name="language" Class="tfa-icon" />
                </span>
            </div>
        </div>
    </section>

    <section class="tfa-card mb-5">
        <div class="tfa-card-pad border-b border-line">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900">
                    <FaIcon Name="list-check" Class="tfa-icon text-accent" />
                    <span>素材別の確認</span>
                </h2>
                @if (_loadingScanDataSources)
                {
                    <span class="inline-flex items-center gap-2 text-sm text-slate-500">
                        <FaIcon Name="spinner" Class="tfa-icon fa-spin" />
                        <span>確認中</span>
                    </span>
                }
            </div>
        </div>
        <div class="tfa-card-pad">
            @if (ScanDataSources.Count == 0)
            {
                <div class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
                    素材の状態を確認しています。
                </div>
            }
            else
            {
                <div class="grid gap-3 lg:grid-cols-2">
                    @foreach (var source in ScanDataSources)
                    {
                        <div class="rounded-md border border-line bg-slate-50 p-4">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <h3 class="flex items-center gap-2 font-semibold text-slate-950">
                                        <FaIcon Name="@source.Icon" Class="tfa-icon text-accent" />
                                        <span>@source.Name</span>
                                    </h3>
                                    <p class="mt-1 text-sm text-slate-500">@source.Description</p>
                                </div>
                                <span class="@($"tfa-status-pill {ScanSourceStateClass(source)}")">@source.StateLabel</span>
                            </div>
                            <div class="mt-4 grid gap-2 sm:grid-cols-2">
                                @foreach (var metric in source.Metrics)
                                {
                                    <div class="rounded-md border border-line bg-white p-3">
                                        <div class="text-xs font-semibold text-slate-500">@metric.Label</div>
                                        <div class="mt-1 text-lg font-semibold text-slate-950">@metric.Value</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="tfa-card tfa-card-pad">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div class="min-w-0">
                <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900">
                    <FaIcon Name="server" Class="tfa-icon text-accent" />
                    <span>自動処理の状態</span>
                </h2>
                <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-slate-600">
                    <span class="@DockerWorkerStatusPillClass">
                        <FaIcon Name="@DockerWorkerStatusIcon" Class="tfa-icon !h-3 !w-3" />
                        <span>@DockerWorkerStatusLabel</span>
                    </span>
                    <span>最終確認: @DockerWorkerUpdatedLabel</span>
                    <span>ストア: @DockerWorkerStoreLabel</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_dockerWorkerStatus?.Message))
                {
                    <div class="mt-2 text-sm text-slate-600">@_dockerWorkerStatus.Message</div>
                }
            </div>
        </div>
        @if (ScanActive)
        {
            <div class="tfa-scan-current-phase mt-4">
                <div class="flex items-start gap-3">
                    <span class="tfa-scan-current-phase-icon" aria-hidden="true">
                        <FaIcon Name="spinner" Class="tfa-icon fa-spin" />
                    </span>
                    <div class="min-w-0">
                        <div class="text-sm font-semibold">現在の工程</div>
                        <div class="mt-1 text-lg font-bold">@CurrentScanPhaseTitle</div>
                        <div class="mt-1 text-sm leading-6">@CurrentScanPhaseDetail</div>
                    </div>
                </div>
            </div>
        }
        <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-5">
            <div class="rounded-md border border-line bg-slate-50 p-3">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2 font-semibold text-slate-900">
                        <FaIcon Name="folder-open" Class="tfa-icon text-accent" />
                        <span>製品データ取得</span>
                    </div>
                    <span class='@ScanPhasePillClass("collect")'>@ScanPhaseStateLabel("collect")</span>
                </div>
                <div class="mt-2 text-sm text-slate-600">@ScanPhaseDetail("collect")</div>
            </div>
            <div class="rounded-md border border-line bg-slate-50 p-3">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2 font-semibold text-slate-900">
                        <FaIcon Name="shuffle" Class="tfa-icon text-accent" />
                        <span>正規化</span>
                    </div>
                    <span class='@ScanPhasePillClass("normalize")'>@ScanPhaseStateLabel("normalize")</span>
                </div>
                <div class="mt-2 text-sm text-slate-600">@ScanPhaseDetail("normalize")</div>
            </div>
            <div class="rounded-md border border-line bg-slate-50 p-3">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2 font-semibold text-slate-900">
                        <FaIcon Name="timeline" Class="tfa-icon text-accent" />
                        <span>時間軸保存</span>
                    </div>
                    <span class='@ScanPhasePillClass("publish")'>@ScanPhaseStateLabel("publish")</span>
                </div>
                <div class="mt-2 text-sm text-slate-600">@ScanPhaseDetail("publish")</div>
            </div>
            <div class="rounded-md border border-line bg-slate-50 p-3">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2 font-semibold text-slate-900">
                        <FaIcon Name="language" Class="tfa-icon text-accent" />
                        <span>文字起こし補正</span>
                    </div>
                    <span class='@ScanPhasePillClass("verbalize")'>@ScanPhaseStateLabel("verbalize")</span>
                </div>
                <div class="mt-2 text-sm text-slate-600">@ScanPhaseDetail("verbalize")</div>
            </div>
            <div class="rounded-md border border-line bg-slate-50 p-3">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2 font-semibold text-slate-900">
                        <FaIcon Name="file-lines" Class="tfa-icon text-accent" />
                        <span>素材概要生成</span>
                    </div>
                    <span class='@ScanPhasePillClass("summarize")'>@ScanPhaseStateLabel("summarize")</span>
                </div>
                <div class="mt-2 text-sm text-slate-600">@ScanPhaseDetail("summarize")</div>
                @if (ItemSummaryActive || _summarizing)
                {
                    <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-200" role="progressbar"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ProgressAriaValue(ItemSummaryProgressPercent)">
                        <div class="h-full rounded-full bg-teal-600 transition-all" style="@ProgressBarStyle(ItemSummaryProgressPercent)"></div>
                    </div>
                    <div class="mt-2 text-xs font-semibold text-slate-600">@ItemSummaryProgressCountLabel</div>
                }
            </div>
        </div>
    </section>

    @if (ShouldShowAudioVerbalizationProgress)
    {
        <section class="tfa-card tfa-run-progress mt-5">
            <div class="tfa-run-progress-head">
                <div class="tfa-run-progress-summary">
                    <div class="tfa-run-progress-title">
                        <span class="tfa-icon-box text-sky-800">
                            <FaIcon Name="@AudioVerbalizationIcon" Class="@($"tfa-icon {AudioVerbalizationIconSpin}")" />
                        </span>
                        <div class="tfa-run-progress-title-text">
                            <h2>文字起こし補正の進捗</h2>
                            <div class="tfa-run-progress-meta">
                                <span class="@AudioVerbalizationStatePill">@AudioVerbalizationStateLabel</span>
                                @if (!string.IsNullOrWhiteSpace(_audioVerbalizationStatus?.JobId))
                                {
                                    <span class="tfa-run-progress-id">実行ID: @_audioVerbalizationStatus.JobId</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(AudioVerbalizationCurrentFile))
                                {
                                    <span class="tfa-run-progress-current-inline">処理中ファイル: @AudioVerbalizationCurrentFile</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="tfa-run-progress-rate">
                        <div class="tfa-run-progress-percent">@ProgressLabel(AudioVerbalizationProgressPercent)</div>
                        <div class="tfa-run-progress-count">@AudioVerbalizationProgressCountLabel</div>
                    </div>
                </div>

                <div class="tfa-run-progress-bar-track"
                     role="progressbar"
                     aria-label="文字起こし補正の進捗"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@ProgressAriaValue(AudioVerbalizationProgressPercent)">
                    <div class="tfa-run-progress-bar" style="@ProgressBarStyle(AudioVerbalizationProgressPercent)"></div>
                </div>
            </div>

            <div class="tfa-run-progress-body">
                <div class="tfa-run-progress-actions">
                    <button type="button"
                            class="tfa-run-progress-toggle"
                            @onclick="ToggleAudioVerbalizationDetails"
                            aria-expanded="@_audioVerbalizationDetailsOpen">
                        <FaIcon Name="@(_audioVerbalizationDetailsOpen ? "chevron-up" : "chevron-down")" Class="tfa-icon !h-3 !w-3" />
                        <span>@(_audioVerbalizationDetailsOpen ? "詳細を閉じる" : "詳細を表示")</span>
                    </button>
                </div>

                @if (_audioVerbalizationDetailsOpen && _audioVerbalizationStatus is not null)
                {
                    <div class="tfa-run-metrics">
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">候補あり</div>
                            <div>@_audioVerbalizationStatus.ReviewItems 件</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">失敗</div>
                            <div>@_audioVerbalizationStatus.FailedItems 件</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">スキップ</div>
                            <div>@_audioVerbalizationStatus.SkippedItems 件</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">補正済み区間</div>
                            <div>@_audioVerbalizationStatus.VerbalizedTurns / @_audioVerbalizationStatus.TotalTurns</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">未解決区間</div>
                            <div>@_audioVerbalizationStatus.UnresolvedTurns 件</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">残り目安</div>
                            <div>@RunDurationLabel(_audioVerbalizationStatus.EstimatedRemainingSec)</div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
}
