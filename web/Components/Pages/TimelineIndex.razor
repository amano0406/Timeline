@page "/scan"
@page "/timeline"
@inject TimelineHelperClient Timeline
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>スキャン - Timeline</PageTitle>

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="timeline" Class="tfa-icon text-accent" />
            <span>スキャン</span>
        </h1>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="tfa-button-secondary gap-2" @onclick="LoadAsync" disabled="@Busy">
            <FaIcon Name="rotate" Class="@($"tfa-icon {(_loading ? "fa-spin" : "")}")" />
            <span>状態更新</span>
        </button>
        <button class="tfa-button-primary gap-2" @onclick="ScanAsync" disabled="@(_loading || _downloading || ScanActive)">
            <FaIcon Name="@ScanButtonIcon" Class="@($"tfa-icon {ScanButtonIconSpin}")" />
            <span>@ScanButtonLabel</span>
        </button>
        <button class="tfa-button-secondary gap-2" @onclick="DownloadAsync" disabled="@(!CanDownload || Busy)">
            <FaIcon Name="@(_downloading ? "spinner" : "download")" Class="@($"tfa-icon {(_downloading ? "fa-spin" : "")}")" />
            <span>@(_downloading ? "作成中" : "ダウンロード")</span>
        </button>
    </div>
</div>

@if (_error is not null && !ScanFailed)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (ScanFailed)
{
    <section class="tfa-scan-failed-panel mb-5" role="alert">
        <div class="flex items-start gap-3">
            <span class="tfa-scan-failed-icon" aria-hidden="true">
                <FaIcon Name="triangle-exclamation" Class="tfa-icon" />
            </span>
            <div class="min-w-0">
                <div class="text-sm font-semibold">スキャンが停止しました</div>
                <div class="mt-1 text-sm leading-6">@(_workerStatus?.Message ?? "自動処理に失敗しました。")</div>
            </div>
        </div>
        <div class="tfa-scan-failure-details">
            <div class="tfa-scan-failure-row">
                <span>失敗した工程</span>
                <strong>@ScanFailurePhaseTitle</strong>
            </div>
            <div class="tfa-scan-failure-row">
                <span>原因</span>
                <strong>@ScanFailureCause</strong>
            </div>
            <div class="tfa-scan-failure-help">@ScanFailureHelp</div>
        </div>
    </section>
}
else if (ShouldShowOperationMessage && ScanActive)
{
    var remainingItems = RemainingScanPhaseItems;
    <section class="tfa-scan-running-panel mb-5" role="status" aria-live="polite">
        <div class="flex items-start gap-3">
            <span class="tfa-scan-running-spinner" aria-hidden="true">
                <FaIcon Name="spinner" Class="tfa-icon fa-spin" />
            </span>
            <div class="min-w-0">
                <div class="text-sm font-semibold">スキャンを実行中です</div>
                <div class="mt-1 text-sm leading-6">@_operationMessage</div>
            </div>
        </div>
        <div class="tfa-scan-running-meter" aria-hidden="true">
            <span></span>
        </div>
        @if (remainingItems.Count > 0)
        {
            <div class="tfa-scan-remaining">
                <div class="tfa-scan-remaining-title">残っている処理</div>
                <div class="tfa-scan-remaining-list">
                    @foreach (var item in remainingItems)
                    {
                        <div class="@ScanPhaseRemainingItemClass(item.Phase)">
                            <span class="tfa-scan-remaining-icon" aria-hidden="true">
                                <FaIcon Name="@item.Icon" Class="tfa-icon" />
                            </span>
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="font-semibold">@item.Label</span>
                                    <span class='@ScanPhasePillClass(item.Phase)'>@ScanPhaseStateLabel(item.Phase)</span>
                                </div>
                                <div class="mt-1 text-sm leading-6">@ScanPhaseDetail(item.Phase)</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </section>
}
else if (ShouldShowOperationMessage)
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="circle-info" Class="tfa-icon mt-0.5" />
        <span>@_operationMessage</span>
    </div>
}

@if (_loading && _overview is null)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else
{
    @if (_overview?.Available != true && !ScanActive)
    {
        <section class="tfa-card tfa-card-pad tfa-scan-empty mb-5">
            <div class="flex items-start gap-4">
                <span class="tfa-icon-box text-teal-700">
                    <FaIcon Name="timeline" Class="tfa-icon" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-xl font-bold text-slate-950">まずスキャンを始めてください</h2>
                    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">@StoreMessage</p>
                    <div class="mt-5 flex">
                        <button class="tfa-button-primary tfa-scan-empty-action gap-2"
                            @onclick="ScanAsync"
                            disabled="@(_loading || _downloading || ScanActive)">
                            <FaIcon Name="@ScanButtonIcon" Class="@($"tfa-icon {ScanButtonIconSpin}")" />
                            <span>@(ScanActive ? "処理中" : "スキャンを始める")</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>
    }

    <section class="tfa-card tfa-card-pad">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div class="min-w-0">
                <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900">
                    <FaIcon Name="server" Class="tfa-icon text-accent" />
                    <span>自動処理の状態</span>
                </h2>
                <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-slate-600">
                    <span class="@DockerWorkerStatusPillClass">
                        <FaIcon Name="@DockerWorkerStatusIcon" Class="tfa-icon !h-3 !w-3" />
                        <span>@DockerWorkerStatusLabel</span>
                    </span>
                    <span>最終確認: @DockerWorkerUpdatedLabel</span>
                    <span>ストア: @DockerWorkerStoreLabel</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_dockerWorkerStatus?.Message))
                {
                    <div class="mt-2 text-sm text-slate-600">@_dockerWorkerStatus.Message</div>
                }
            </div>
        </div>
        @if (ScanActive)
        {
            <div class="tfa-scan-current-phase mt-4">
                <div class="flex items-start gap-3">
                    <span class="tfa-scan-current-phase-icon" aria-hidden="true">
                        <FaIcon Name="spinner" Class="tfa-icon fa-spin" />
                    </span>
                    <div class="min-w-0">
                        <div class="text-sm font-semibold">現在の工程</div>
                        <div class="mt-1 text-lg font-bold">@CurrentScanPhaseTitle</div>
                        <div class="mt-1 text-sm leading-6">@CurrentScanPhaseDetail</div>
                    </div>
                </div>
            </div>
        }
        <div class="mt-4 grid gap-3 md:grid-cols-4">
            <div class="rounded-md border border-line bg-slate-50 p-3">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2 font-semibold text-slate-900">
                        <FaIcon Name="folder-open" Class="tfa-icon text-accent" />
                        <span>製品データ取得</span>
                    </div>
                    <span class='@ScanPhasePillClass("collect")'>@ScanPhaseStateLabel("collect")</span>
                </div>
                <div class="mt-2 text-sm text-slate-600">@ScanPhaseDetail("collect")</div>
            </div>
            <div class="rounded-md border border-line bg-slate-50 p-3">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2 font-semibold text-slate-900">
                        <FaIcon Name="shuffle" Class="tfa-icon text-accent" />
                        <span>正規化</span>
                    </div>
                    <span class='@ScanPhasePillClass("normalize")'>@ScanPhaseStateLabel("normalize")</span>
                </div>
                <div class="mt-2 text-sm text-slate-600">@ScanPhaseDetail("normalize")</div>
            </div>
            <div class="rounded-md border border-line bg-slate-50 p-3">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2 font-semibold text-slate-900">
                        <FaIcon Name="timeline" Class="tfa-icon text-accent" />
                        <span>時間軸保存</span>
                    </div>
                    <span class='@ScanPhasePillClass("publish")'>@ScanPhaseStateLabel("publish")</span>
                </div>
                <div class="mt-2 text-sm text-slate-600">@ScanPhaseDetail("publish")</div>
            </div>
            <div class="rounded-md border border-line bg-slate-50 p-3">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2 font-semibold text-slate-900">
                        <FaIcon Name="language" Class="tfa-icon text-accent" />
                        <span>文字起こし補正</span>
                    </div>
                    <span class='@ScanPhasePillClass("verbalize")'>@ScanPhaseStateLabel("verbalize")</span>
                </div>
                <div class="mt-2 text-sm text-slate-600">@ScanPhaseDetail("verbalize")</div>
            </div>
        </div>
    </section>

    @if (InstalledMaterialLinks.Count > 0)
    {
    <section class="tfa-card tfa-card-pad mt-5">
        <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900">
                <FaIcon Name="list-check" Class="tfa-icon text-accent" />
                <span>素材別の確認</span>
            </h2>
            <span class="text-sm text-slate-500">取り込み状況を詳しく見たいときだけ開きます</span>
        </div>
        <div class="grid gap-4 lg:grid-cols-2">
            @foreach (var link in InstalledMaterialLinks)
            {
                <a class="rounded-md border border-line bg-slate-50 p-4 text-slate-900 hover:border-teal-300 hover:bg-teal-50"
                   href="@link.Href">
                    <div class="flex flex-wrap items-center gap-2 font-semibold">
                        <FaIcon Name="@link.Icon" Class="tfa-icon text-teal-700" />
                        <span>@link.Label</span>
                        <span class='@MaterialProductPillClass(link.ProductId)'>@MaterialProductStatusLabel(link.ProductId)</span>
                    </div>
                    <div class="mt-2 text-sm text-slate-600">@link.Description</div>
                </a>
            }
        </div>
    </section>
    }

    @if (ShouldShowAudioVerbalizationProgress)
    {
        <section class="tfa-card tfa-run-progress mt-5">
            <div class="tfa-run-progress-head">
                <div class="tfa-run-progress-summary">
                    <div class="tfa-run-progress-title">
                        <span class="tfa-icon-box text-sky-800">
                            <FaIcon Name="@AudioVerbalizationIcon" Class="@($"tfa-icon {AudioVerbalizationIconSpin}")" />
                        </span>
                        <div class="tfa-run-progress-title-text">
                            <h2>文字起こし補正の進捗</h2>
                            <div class="tfa-run-progress-meta">
                                <span class="@AudioVerbalizationStatePill">@AudioVerbalizationStateLabel</span>
                                @if (!string.IsNullOrWhiteSpace(_audioVerbalizationStatus?.JobId))
                                {
                                    <span class="tfa-run-progress-id">実行ID: @_audioVerbalizationStatus.JobId</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(AudioVerbalizationCurrentFile))
                                {
                                    <span class="tfa-run-progress-current-inline">処理中ファイル: @AudioVerbalizationCurrentFile</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="tfa-run-progress-rate">
                        <div class="tfa-run-progress-percent">@ProgressLabel(AudioVerbalizationProgressPercent)</div>
                        <div class="tfa-run-progress-count">@AudioVerbalizationProgressCountLabel</div>
                    </div>
                </div>

                <div class="tfa-run-progress-bar-track"
                     role="progressbar"
                     aria-label="文字起こし補正の進捗"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@ProgressAriaValue(AudioVerbalizationProgressPercent)">
                    <div class="tfa-run-progress-bar" style="@ProgressBarStyle(AudioVerbalizationProgressPercent)"></div>
                </div>
            </div>

            <div class="tfa-run-progress-body">
                <div class="tfa-run-progress-actions">
                    <button type="button"
                            class="tfa-run-progress-toggle"
                            @onclick="ToggleAudioVerbalizationDetails"
                            aria-expanded="@_audioVerbalizationDetailsOpen">
                        <FaIcon Name="@(_audioVerbalizationDetailsOpen ? "chevron-up" : "chevron-down")" Class="tfa-icon !h-3 !w-3" />
                        <span>@(_audioVerbalizationDetailsOpen ? "詳細を閉じる" : "詳細を表示")</span>
                    </button>
                </div>

                @if (_audioVerbalizationDetailsOpen && _audioVerbalizationStatus is not null)
                {
                    <div class="tfa-run-metrics">
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">候補あり</div>
                            <div>@_audioVerbalizationStatus.ReviewItems 件</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">失敗</div>
                            <div>@_audioVerbalizationStatus.FailedItems 件</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">スキップ</div>
                            <div>@_audioVerbalizationStatus.SkippedItems 件</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">補正済み区間</div>
                            <div>@_audioVerbalizationStatus.VerbalizedTurns / @_audioVerbalizationStatus.TotalTurns</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">未解決区間</div>
                            <div>@_audioVerbalizationStatus.UnresolvedTurns 件</div>
                        </div>
                        <div class="tfa-run-metric">
                            <div class="tfa-kicker">残り目安</div>
                            <div>@RunDurationLabel(_audioVerbalizationStatus.EstimatedRemainingSec)</div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
}
