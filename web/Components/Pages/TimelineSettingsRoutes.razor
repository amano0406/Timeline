@page "/timeline/products"
@page "/timeline/settings"
@page "/audio/settings"
@page "/windows-codex/settings"
@page "/chatgpt/settings"
@page "/image/settings"
@page "/video/settings"
@page "/pc/settings"
@inject NavigationManager Navigation
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing

@if (IsProductManagementRoute)
{
    <PageTitle>製品管理 - Timeline</PageTitle>

    <div class="mb-6 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="boxes-stacked" Class="tfa-icon text-accent" />
            <span>製品管理</span>
        </h1>
    </div>

    <ProductManagementModal />
}
else
{
    <TimelineSettings ProductId="@ProductId" />
}
