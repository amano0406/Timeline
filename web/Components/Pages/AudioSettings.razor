@inject TimelineLocalApiClient Timeline
@inject IJSRuntime Js

@if (!Embedded)
{
    <PageTitle>TimelineForAudio 設定 - Timeline</PageTitle>

    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <h1 class="tfa-title flex items-center gap-2">
            <FaIcon Name="gear" Class="tfa-icon text-accent" />
            <span>TimelineForAudio 設定</span>
        </h1>
        <a class="tfa-button-secondary gap-2" href="audio/files">
            <FaIcon Name="arrow-left" Class="tfa-icon" />
            <span>一覧に戻る</span>
        </a>
    </div>
}

@if (_error is not null)
{
    <div class="tfa-alert-danger mb-5 flex items-start gap-2">
        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
        <span>@_error</span>
    </div>
}

@if (_saved)
{
    <div class="tfa-alert-info mb-5 flex items-start gap-2">
        <FaIcon Name="circle-check" Class="tfa-icon mt-0.5" />
        <span>設定を保存しました。</span>
    </div>
    <div class="tfa-alert-warn mb-5 flex items-start gap-2">
        <FaIcon Name="rotate" Class="tfa-icon mt-0.5" />
        <span>AI処理方法とディレクトリの反映にはTimelineの再起動が必要な場合があります。</span>
    </div>
}

@if (_loading)
{
    <section class="tfa-card tfa-card-pad flex items-center gap-3">
        <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
        <span class="text-sm text-slate-600">読み込み中</span>
    </section>
}
else
{
    <section class="tfa-card tfa-card-pad">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="key" Class="tfa-icon text-accent" />
            <span>Hugging Face トークン</span>
        </h2>

        @if (_overview is null || !_overview.HasToken && string.IsNullOrWhiteSpace(_tokenToSave))
        {
            <div class="tfa-alert-danger mt-4 flex items-start gap-2">
                <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
                <span>Hugging Face トークンが未設定です。</span>
            </div>
        }

        <div class="mt-4 rounded-md border border-line bg-slate-50 p-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <div class="flex items-center gap-2 text-sm font-medium text-slate-700">
                        <FaIcon Name="@((_overview?.HasToken == true || !string.IsNullOrWhiteSpace(_tokenToSave)) ? "circle-check" : "circle-minus")"
                                Class="@($"tfa-icon {((_overview?.HasToken == true || !string.IsNullOrWhiteSpace(_tokenToSave)) ? "text-teal-700" : "text-slate-400")}")" />
                        <span>@((_overview?.HasToken == true || !string.IsNullOrWhiteSpace(_tokenToSave)) ? "設定済み" : "未設定")</span>
                    </div>
                    <div class="mt-1 pl-7 font-mono text-sm text-slate-900">@TokenDisplay</div>
                </div>
                <button class="tfa-button-secondary gap-2" @onclick="OpenTokenModal">
                    <FaIcon Name="key" Class="tfa-icon" />
                    <span>登録</span>
                </button>
            </div>
        </div>

        <div class="mt-4 grid gap-3 text-sm text-slate-700">
            <div>
                <span class="font-medium">トークンの作成:</span>
                <a class="text-accent underline" href="https://huggingface.co/settings/tokens" target="_blank" rel="noreferrer">Hugging Face tokens</a>
            </div>

            <div class="rounded-md border border-line bg-slate-50 p-3">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                    <div class="font-medium text-slate-900">モデル利用条件</div>
                    @if (_modelsLoading)
                    {
                        <div class="inline-flex items-center gap-2 text-slate-500">
                            <FaIcon Name="spinner" Class="tfa-icon fa-spin !h-4 !w-4" />
                            <span>確認中</span>
                        </div>
                    }
                </div>

                @if (!_modelsLoading && _modelInventory is { Available: false })
                {
                    <div class="mt-3 text-sm text-slate-600">@_modelInventory.Message</div>
                }
                else if (!_modelsLoading && HuggingFaceModels.Count == 0)
                {
                    <div class="mt-3 text-sm text-slate-600">Hugging Face モデルは見つかりませんでした。</div>
                }
                else
                {
                    <div class="mt-3 grid gap-2">
                        @foreach (var model in HuggingFaceModels)
                        {
                            <div class="grid gap-3 rounded-md border border-line bg-white p-3 lg:grid-cols-[1fr_auto] lg:items-center">
                                <div class="min-w-0">
                                    <div class="font-medium text-slate-900">@ModelRoleLabel(model)</div>
                                    <div class="mt-1 break-all font-mono text-xs text-slate-600">@model.ModelId</div>
                                    <div class="mt-2 flex flex-wrap gap-2">
                                        @if (model.RequiresHuggingFaceToken)
                                        {
                                            <span class="tfa-status-pill border-sky-200 bg-sky-50 text-sky-800">トークン</span>
                                        }
                                        @if (model.RequiresAccessApproval)
                                        {
                                            <span class="tfa-status-pill border-amber-200 bg-amber-50 text-amber-900">利用承認</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(model.License))
                                        {
                                            <span class="tfa-status-pill border-slate-200 bg-slate-50 text-slate-700">ライセンス: @model.License</span>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(model.Url))
                                {
                                    <a class="tfa-button-secondary gap-2" href="@model.Url" target="_blank" rel="noreferrer">
                                        <FaIcon Name="arrow-up-right-from-square" Class="tfa-icon" />
                                        <span>モデルページ</span>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="tfa-card tfa-card-pad mt-5">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="microchip" Class="tfa-icon text-accent" />
            <span>AI処理方法</span>
        </h2>

        <div class="mt-4 max-w-xl">
            <select id="compute" class="tfa-input" @bind="_computeMode" aria-label="AI処理方法">
                <option value="cpu">CPU</option>
                <option value="gpu">GPU</option>
            </select>

            <div class="mt-3 grid gap-2 text-sm">
                <div class="grid gap-1 rounded-md border border-line bg-slate-50 p-3">
                    <div class="inline-flex items-center gap-2 font-medium text-slate-700">
                        <FaIcon Name="microchip" Class="tfa-icon !h-4 !w-4 text-slate-500" />
                        <span>CPU</span>
                    </div>
                    @if (!HardwareDevicesLoaded)
                    {
                        <span class="text-slate-500">確認中</span>
                    }
                    else if (CpuDevices.Count == 0)
                    {
                        <span class="text-slate-500">取得できませんでした</span>
                    }
                    else
                    {
                        @foreach (var device in CpuDevices)
                        {
                            <span class="text-slate-900">@device</span>
                        }
                    }
                </div>

                <div class="grid gap-1 rounded-md border border-line bg-slate-50 p-3">
                    <div class="inline-flex items-center gap-2 font-medium text-slate-700">
                        <FaIcon Name="display" Class="tfa-icon !h-4 !w-4 text-slate-500" />
                        <span>GPU</span>
                    </div>
                    @if (!HardwareDevicesLoaded)
                    {
                        <span class="text-slate-500">確認中</span>
                    }
                    else if (GpuDevices.Count == 0)
                    {
                        <span class="text-slate-500">取得できませんでした</span>
                    }
                    else
                    {
                        @foreach (var device in GpuDevices)
                        {
                            <span class="text-slate-900">@device</span>
                        }
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="tfa-card tfa-card-pad mt-5">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="folder" Class="tfa-icon text-accent" />
            <span>入力ディレクトリ</span>
        </h2>

        <div class="mt-4 grid gap-3">
            @foreach (var root in _inputRoots)
            {
                <div class="rounded-md border border-line p-3">
                    <div class="grid gap-3 lg:grid-cols-[1fr_auto] lg:items-center">
                        <div class="flex min-h-10 min-w-0 items-center">
                            <div class="break-all font-mono text-sm text-slate-900">@DirectoryDisplay(root.Path)</div>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <button class="tfa-button-secondary gap-2" @onclick="() => AskRemoveInputRoot(root)" disabled="@(_inputRoots.Count <= 1)">
                                <FaIcon Name="xmark" Class="tfa-icon" />
                                <span>外す</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-3 flex justify-end">
            <button class="tfa-button-secondary gap-2" @onclick="OpenAddInputDirectory">
                <FaIcon Name="plus" Class="tfa-icon" />
                <span>追加</span>
            </button>
        </div>
    </section>

    <section class="tfa-card tfa-card-pad mt-5">
        <h2 class="flex items-center gap-2 text-lg font-semibold">
            <FaIcon Name="folder-open" Class="tfa-icon text-accent" />
            <span>出力ディレクトリ</span>
        </h2>

        <div class="mt-4 rounded-md border border-line p-3">
            <div class="grid gap-3 lg:grid-cols-[1fr_auto] lg:items-center">
                <div class="min-w-0 break-all font-mono text-sm text-slate-900">@DirectoryDisplay(_outputRoot.Path)</div>
                <button class="tfa-button-secondary gap-2" @onclick="OpenOutputDirectory">
                    <FaIcon Name="folder-open" Class="tfa-icon" />
                    <span>変更</span>
                </button>
            </div>
        </div>
    </section>

    <div class="mt-5 flex flex-wrap gap-3">
        <button class="tfa-button-primary gap-2" @onclick="SaveAsync" disabled="@_saving">
            <FaIcon Name="@(_saving ? "spinner" : "floppy-disk")" Class="@($"tfa-icon {(_saving ? "fa-spin" : "")}")" />
            <span>保存</span>
        </button>
    </div>
}

@if (_tokenModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4">
        <section class="w-full max-w-xl rounded-md bg-white shadow-xl">
            <div class="border-b border-line p-5">
                <h2 class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="key" Class="tfa-icon text-accent" />
                    <span>Hugging Face トークンを登録</span>
                </h2>
            </div>
            <div class="p-5">
                @if (_tokenValidationError is not null)
                {
                    <div class="tfa-alert-danger mb-4 flex items-start gap-2">
                        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
                        <span>@_tokenValidationError</span>
                    </div>
                }
                <label class="tfa-label" for="token-modal-input">Hugging Face token</label>
                <input id="token-modal-input"
                       class="tfa-input font-mono"
                       type="password"
                       autocomplete="off"
                       placeholder="hf_..."
                       @bind="_tokenDraft" />
            </div>
            <div class="flex flex-wrap justify-end gap-2 border-t border-line p-4">
                <button class="tfa-button-secondary gap-2" @onclick="CloseTokenModal">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>キャンセル</span>
                </button>
                <button class="tfa-button-primary gap-2" @onclick="SaveTokenDraft">
                    <FaIcon Name="circle-check" Class="tfa-icon" />
                    <span>OK</span>
                </button>
            </div>
        </section>
    </div>
}

@if (_removeTarget is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4">
        <section class="w-full max-w-xl rounded-md bg-white shadow-xl">
            <div class="border-b border-line p-5">
                <h2 class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="folder-minus" Class="tfa-icon text-accent" />
                    <span>入力ディレクトリを外す</span>
                </h2>
            </div>
            <div class="p-5">
                <p class="break-all font-mono text-sm text-slate-900">@_removeTarget.Path</p>
                <p class="mt-3 text-sm text-slate-600">
                    この入力ディレクトリを処理対象から外します。元の音声ファイルと生成済みデータは削除されません。
                </p>
            </div>
            <div class="flex flex-wrap justify-end gap-2 border-t border-line p-4">
                <button class="tfa-button-secondary gap-2" @onclick="CancelRemoveInputRoot">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>キャンセル</span>
                </button>
                <button class="tfa-button-primary gap-2" @onclick="ConfirmRemoveInputRoot">
                    <FaIcon Name="circle-check" Class="tfa-icon" />
                    <span>外す</span>
                </button>
            </div>
        </section>
    </div>
}
