@inherits LayoutComponentBase
@rendermode InteractiveServer

<div class="@ShellClass">
    <button type="button"
            class="tfa-sidebar-backdrop"
            aria-label="メニューを閉じる"
            @onclick="CloseSidebar"></button>

    <NavMenu IsCollapsed="@_desktopSidebarCollapsed"
             OnToggleCollapsed="ToggleDesktopSidebar"
             OnNavigate="CloseSidebar" />

    <header class="tfa-mobile-topbar">
        <button type="button"
                class="tfa-sidebar-toggle"
                aria-controls="timeline-sidebar"
                aria-expanded="@_sidebarOpen"
                @onclick="ToggleSidebar">
            <FaIcon Name="bars" Class="tfa-icon" />
            <span>メニュー</span>
        </button>
        <a class="tfa-mobile-brand" href="">
            <FaIcon Name="timeline" Class="tfa-icon text-accent" />
            <span>Timeline</span>
        </a>
    </header>

    <main class="tfa-main">
        @Body
    </main>

    <InitialProductSetup />
</div>

@code {
    private bool _sidebarOpen;
    private bool _desktopSidebarCollapsed;

    private string ShellClass =>
        $"tfa-shell{(_sidebarOpen ? " tfa-shell-sidebar-open" : "")}{(_desktopSidebarCollapsed ? " tfa-shell-sidebar-collapsed" : "")}";

    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
    }

    private void CloseSidebar()
    {
        _sidebarOpen = false;
    }

    private void ToggleDesktopSidebar()
    {
        _desktopSidebarCollapsed = !_desktopSidebarCollapsed;
    }
}
