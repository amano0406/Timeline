@inherits LayoutComponentBase
@inject TimelineSettingsDialogService SettingsDialog
@inject TimelineProductsDialogService ProductsDialog
@inject IJSRuntime Js
@implements IDisposable

<div class="@ShellClass">
    <button type="button"
            class="tfa-sidebar-backdrop"
            aria-label="メニューを閉じる"
            @onclick="CloseSidebar"></button>

    <NavMenu OnNavigate="CloseSidebar" SettingsOpen="_settingsOpen" ProductsOpen="_productsOpen" />

    <header class="tfa-mobile-topbar">
        <button type="button"
                class="tfa-sidebar-toggle"
                aria-controls="timeline-sidebar"
                aria-expanded="@_sidebarOpen"
                @onclick="ToggleSidebar">
            <FaIcon Name="bars" Class="tfa-icon" />
            <span>メニュー</span>
        </button>
        <a class="tfa-mobile-brand" href="">
            <FaIcon Name="timeline" Class="tfa-icon text-accent" />
            <span>Timeline</span>
        </a>
    </header>

    <main class="tfa-main">
        @Body
    </main>
</div>

@if (_settingsOpen)
{
    <div id="timeline-settings-modal"
         class="tfa-twe-modal"
         data-twe-modal-init
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="設定"
         data-timeline-modal-root
         @onkeydown="HandleSettingsModalKeyDown">
        <button type="button"
                class="tfa-twe-modal-backdrop"
                aria-label="設定を閉じる"
                @onclick="CloseSettings"></button>
        <div class="tfa-twe-modal-dialog"
             data-twe-modal-dialog-ref
             data-timeline-modal-dialog
             @onclick:stopPropagation="true">
            <section class="tfa-twe-modal-content" @onclick:stopPropagation="true">
                <header class="tfa-twe-modal-header" data-timeline-modal-drag-handle>
                    <div class="tfa-twe-modal-title">
                        <FaIcon Name="sliders" Class="tfa-icon text-accent" />
                        <span class="truncate">設定</span>
                    </div>
                    <button type="button"
                            class="tfa-twe-modal-close"
                            data-twe-modal-dismiss
                            aria-label="設定を閉じる"
                            @onclick="CloseSettings">
                        <FaIcon Name="xmark" Class="tfa-icon" />
                    </button>
                </header>
                <div class="tfa-twe-modal-body">
                    <TimelineSettings Embedded="true"
                                      @ref="_settingsComponent"
                                      ProductId="@_settingsProductId" />
                </div>
                <footer class="tfa-twe-modal-footer">
                    <div class="tfa-twe-modal-footer-note">
                        設定内容を保存すると、変更内容の確認画面を表示します。
                    </div>
                    <div class="tfa-twe-modal-footer-actions">
                        <button type="button"
                                class="tfa-button-secondary gap-2"
                                @onclick="CloseSettings">
                            <FaIcon Name="xmark" Class="tfa-icon" />
                            <span>閉じる</span>
                        </button>
                        <button type="button"
                                class="tfa-button-primary gap-2"
                                @onclick="OpenSettingsSaveConfirm"
                                disabled="@(_settingsComponent?.IsBusy == true)">
                            <FaIcon Name="@(_settingsComponent?.IsSaving == true ? "spinner" : "floppy-disk")"
                                    Class="@($"tfa-icon {(_settingsComponent?.IsSaving == true ? "fa-spin" : "")}")" />
                            <span>保存</span>
                        </button>
                    </div>
                </footer>
            </section>
        </div>
    </div>
}

@if (_productsOpen)
{
    <div id="timeline-products-modal"
         class="tfa-twe-modal"
         data-twe-modal-init
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="製品管理"
         data-timeline-modal-root
         @onkeydown="HandleProductsModalKeyDown">
        <button type="button"
                class="tfa-twe-modal-backdrop"
                aria-label="製品管理を閉じる"
                @onclick="CloseProducts"></button>
        <div class="tfa-twe-modal-dialog"
             data-twe-modal-dialog-ref
             data-timeline-modal-dialog
             @onclick:stopPropagation="true">
            <section class="tfa-twe-modal-content" @onclick:stopPropagation="true">
                <header class="tfa-twe-modal-header" data-timeline-modal-drag-handle>
                    <div class="tfa-twe-modal-title">
                        <FaIcon Name="boxes-stacked" Class="tfa-icon text-accent" />
                        <span class="truncate">製品管理</span>
                    </div>
                    <button type="button"
                            class="tfa-twe-modal-close"
                            data-twe-modal-dismiss
                            aria-label="製品管理を閉じる"
                            @onclick="CloseProducts">
                        <FaIcon Name="xmark" Class="tfa-icon" />
                    </button>
                </header>
                <div class="tfa-twe-modal-body">
                    <ProductManagementModal @ref="_productsComponent" Embedded="true" />
                </div>
                <footer class="tfa-twe-modal-footer">
                    <div class="tfa-twe-modal-footer-note">
                        起動状態を確認し、必要な製品だけ起動・停止します。
                    </div>
                    <div class="tfa-twe-modal-footer-actions">
                        <button type="button"
                                class="tfa-button-secondary gap-2"
                                @onclick="RefreshProductsAsync"
                                disabled="@(_productsComponent?.IsLoading == true)">
                            <FaIcon Name="@(_productsComponent?.IsLoading == true ? "spinner" : "rotate")"
                                    Class="@($"tfa-icon {(_productsComponent?.IsLoading == true ? "fa-spin" : "")}")" />
                            <span>状態更新</span>
                        </button>
                        <button type="button"
                                class="tfa-button-primary gap-2"
                                @onclick="CloseProducts">
                            <FaIcon Name="xmark" Class="tfa-icon" />
                            <span>閉じる</span>
                        </button>
                    </div>
                </footer>
            </section>
        </div>
    </div>
}

@if (_settingsCloseConfirmOpen)
{
    <div class="fixed inset-0 z-[1070] flex items-center justify-center bg-slate-950/60 p-4">
        <section class="w-full max-w-xl rounded-md bg-white shadow-xl"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="settings-close-confirm-title">
            <div class="border-b border-line p-5">
                <h2 id="settings-close-confirm-title" class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="triangle-exclamation" Class="tfa-icon text-warning" />
                    <span>変更を破棄しますか？</span>
                </h2>
            </div>
            <div class="p-5 text-sm text-slate-700">
                保存していない設定があります。閉じると、今回の変更は保存されません。
            </div>
            <div class="flex flex-wrap justify-end gap-2 border-t border-line p-4">
                <button class="tfa-button-secondary gap-2" @onclick="CancelSettingsClose">
                    <FaIcon Name="arrow-left" Class="tfa-icon" />
                    <span>戻る</span>
                </button>
                <button class="tfa-button-primary gap-2" @onclick="DiscardSettingsAndClose">
                    <FaIcon Name="circle-check" Class="tfa-icon" />
                    <span>閉じる</span>
                </button>
            </div>
        </section>
    </div>
}

@code {
    private bool _sidebarOpen;
    private bool _settingsOpen;
    private bool _productsOpen;
    private bool _settingsCloseConfirmOpen;
    private string? _settingsProductId;
    private TimelineSettings? _settingsComponent;
    private ProductManagementModal? _productsComponent;

    private string ShellClass =>
        _sidebarOpen ? "tfa-shell tfa-shell-sidebar-open" : "tfa-shell";

    protected override void OnInitialized()
    {
        SettingsDialog.OpenRequested += HandleSettingsOpenRequested;
        ProductsDialog.OpenRequested += HandleProductsOpenRequested;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_settingsOpen || _productsOpen)
        {
            await Js.InvokeVoidAsync("timelineModal.enhance");
        }
    }

    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
    }

    private void CloseSidebar()
    {
        _sidebarOpen = false;
    }

    private void CloseSettings()
    {
        if (_settingsComponent?.HasUnsavedChanges() == true)
        {
            _settingsCloseConfirmOpen = true;
            return;
        }

        CloseSettingsCore();
    }

    private void CloseSettingsCore()
    {
        _settingsOpen = false;
        _settingsCloseConfirmOpen = false;
        _settingsProductId = null;
        _settingsComponent = null;
    }

    private void CancelSettingsClose()
    {
        _settingsCloseConfirmOpen = false;
    }

    private void DiscardSettingsAndClose()
    {
        CloseSettingsCore();
    }

    private void CloseProducts()
    {
        _productsOpen = false;
        _productsComponent = null;
    }

    private void HandleSettingsModalKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            CloseSettings();
        }
    }

    private void HandleProductsModalKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            CloseProducts();
        }
    }

    private async Task OpenSettingsSaveConfirm()
    {
        if (_settingsComponent is null)
        {
            return;
        }

        await _settingsComponent.OpenSaveConfirmAsync();
    }

    private async Task RefreshProductsAsync()
    {
        if (_productsComponent is null)
        {
            return;
        }

        await _productsComponent.RefreshAsync();
    }

    private void HandleSettingsOpenRequested(string? productId)
    {
        _ = InvokeAsync(() =>
        {
            _settingsProductId = productId;
            _settingsOpen = true;
            _productsOpen = false;
            _settingsCloseConfirmOpen = false;
            _sidebarOpen = false;
            StateHasChanged();
        });
    }

    private void HandleProductsOpenRequested()
    {
        _ = InvokeAsync(() =>
        {
            _productsOpen = true;
            _settingsOpen = false;
            _settingsCloseConfirmOpen = false;
            _sidebarOpen = false;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        SettingsDialog.OpenRequested -= HandleSettingsOpenRequested;
        ProductsDialog.OpenRequested -= HandleProductsOpenRequested;
    }
}
