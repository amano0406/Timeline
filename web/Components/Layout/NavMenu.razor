@inject NavigationManager Navigation
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing

<aside id="timeline-sidebar" class="tfa-sidebar">
    <div class="flex h-full flex-col">
        <div class="tfa-sidebar-header">
            <a class="tfa-sidebar-brand" href="" title="Timeline" aria-label="Timeline" @onclick="NotifyNavigateAsync">
                <FaIcon Name="timeline" Class="tfa-icon text-teal-300" />
                <span class="tfa-sidebar-label">Timeline</span>
            </a>
            <button type="button"
                    class="tfa-sidebar-collapse-button"
                    title="@CollapseButtonText"
                    aria-label="@CollapseButtonText"
                    aria-expanded="@(!IsCollapsed)"
                    @onclick="ToggleCollapsedAsync">
                <FaIcon Name="@CollapseButtonIcon" Class="tfa-icon" />
            </button>
        </div>

        <nav class="flex flex-col gap-4 p-3 text-sm">
            <div class="grid gap-1">
                <a class="@LinkClass("")"
                   href=""
                   title="ダッシュボード"
                   @onclick="NotifyNavigateAsync">
                    <FaIcon Name="gauge" Class="tfa-icon" />
                    <span class="tfa-sidebar-label">ダッシュボード</span>
                </a>
                <a class="@ScanLinkClass()"
                   href="scan"
                   title="スキャン"
                   @onclick="NotifyNavigateAsync">
                    <FaIcon Name="arrows-rotate" Class="tfa-icon" />
                    <span class="tfa-sidebar-label">スキャン</span>
                </a>
            </div>

            <div class="grid gap-1">
                <div class="tfa-sidebar-label px-3 pt-2 text-xs font-semibold text-slate-400">
                    素材別の確認
                </div>
                @foreach (var link in MaterialLinks)
                {
                    <a class="@MaterialLinkClass(link)"
                       href="@link.Href"
                       title="@link.Label"
                       @onclick="NotifyNavigateAsync">
                        <FaIcon Name="@link.Icon" Class="tfa-icon" />
                        <span class="tfa-sidebar-label">@link.Label</span>
                    </a>
                }
            </div>
        </nav>

        <div class="mt-auto border-t border-white/10 p-3 text-sm">
            <a class="@ProductsLinkClass()"
               href="timeline/products"
               title="製品管理"
               @onclick="NotifyNavigateAsync">
                <FaIcon Name="boxes-stacked" Class="tfa-icon" />
                <span class="tfa-sidebar-label">製品管理</span>
            </a>
            <a class="@SettingsLinkClass()"
               href="timeline/settings"
               title="設定"
               @onclick="NotifyNavigateAsync">
                <FaIcon Name="sliders" Class="tfa-icon" />
                <span class="tfa-sidebar-label">設定</span>
            </a>
        </div>
    </div>
</aside>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapsed { get; set; }

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private const string NavItemClass = "flex w-full items-center gap-2 rounded-md px-3 py-2 text-left hover:bg-white/10 hover:text-white";

    private static readonly MaterialNavLink[] MaterialLinks =
    [
        new("音声ファイル", "file-audio", "audio/files", ["audio/files", "audio/file-detail"]),
        new("動画ファイル", "video", "video", ["video", "video/*"]),
        new("画像ファイル", "image", "image", ["image", "image/file-detail"]),
        new("ChatGPT", "comments", "chatgpt", ["chatgpt", "chatgpt/thread/*"]),
        new("Windows Codex", "terminal", "windows-codex", ["windows-codex", "windows-codex/thread/*"]),
        new("PC状態", "desktop", "pc", ["pc", "pc/*"]),
    ];

    private string CurrentPath
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            var markerIndex = path.IndexOfAny(new[] { '?', '#' });
            if (markerIndex >= 0) {
                path = path[..markerIndex];
            }

            return path.Trim('/');
        }
    }

    private string LinkClass(params string[] activePaths)
        => IsActive(activePaths)
            ? $"{NavItemClass} bg-white/15 text-white"
            : $"{NavItemClass} text-slate-200";

    private string ScanLinkClass()
        => LinkClass(
            "scan",
            "timeline");

    private string MaterialLinkClass(MaterialNavLink link)
        => LinkClass(link.ActivePaths);

    private string SettingsLinkClass()
        => LinkClass(
            "timeline/settings",
            "audio/settings",
            "windows-codex/settings",
            "chatgpt/settings",
            "image/settings",
            "video/settings",
            "pc/settings");

    private string ProductsLinkClass()
        => LinkClass("timeline/products");

    private string CollapseButtonText =>
        IsCollapsed ? "メニューを開く" : "メニューを閉じる";

    private string CollapseButtonIcon =>
        IsCollapsed ? "angles-right" : "angles-left";

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private bool IsActive(params string[] activePaths)
    {
        var currentPath = CurrentPath;
        foreach (var activePath in activePaths) {
            var normalizedPath = activePath.Trim('/');
            if (normalizedPath.EndsWith("/*", StringComparison.Ordinal)) {
                var prefix = normalizedPath[..^2];
                if (string.Equals(currentPath, prefix, StringComparison.OrdinalIgnoreCase)
                    || currentPath.StartsWith($"{prefix}/", StringComparison.OrdinalIgnoreCase)) {
                    return true;
                }
                continue;
            }

            if (string.Equals(currentPath, normalizedPath, StringComparison.OrdinalIgnoreCase)) {
                return true;
            }
        }

        return false;
    }

    private Task NotifyNavigateAsync() => OnNavigate.InvokeAsync();

    private Task ToggleCollapsedAsync() => OnToggleCollapsed.InvokeAsync();

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private sealed record MaterialNavLink(
        string Label,
        string Icon,
        string Href,
        string[] ActivePaths);
}
