@inject NavigationManager Navigation
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing

<aside id="timeline-sidebar" class="tfa-sidebar">
    <div class="flex h-full flex-col">
        <div class="border-b border-white/10 p-5">
            <a class="flex items-center gap-2 text-lg font-semibold text-white" href="" @onclick="NotifyNavigateAsync">
                <FaIcon Name="timeline" Class="tfa-icon text-teal-300" />
                <span>Timeline</span>
            </a>
        </div>

        <nav class="flex flex-col gap-4 p-3 text-sm">
            <div class="grid gap-1">
                <a class="@LinkClass("")"
                   href=""
                   @onclick="NotifyNavigateAsync">
                    <FaIcon Name="gauge" Class="tfa-icon" />
                    <span>ダッシュボード</span>
                </a>
                <a class="@LinkClass("timeline")"
                   href="timeline"
                   @onclick="NotifyNavigateAsync">
                    <FaIcon Name="timeline" Class="tfa-icon" />
                    <span>時間軸</span>
                </a>
                <a class="@LinkClass("timeline/settings")"
                   href="timeline/settings"
                   @onclick="NotifyNavigateAsync">
                    <FaIcon Name="sliders" Class="tfa-icon" />
                    <span>設定</span>
                </a>
                <a class="@LinkClass("timeline/operations")"
                   href="timeline/operations"
                   @onclick="NotifyNavigateAsync">
                    <FaIcon Name="clipboard-list" Class="tfa-icon" />
                    <span>操作ログ</span>
                </a>
            </div>

            <section>
                <div class="flex items-center gap-2 px-3 py-2 font-semibold text-white">
                    <FaIcon Name="file-audio" Class="tfa-icon text-teal-300" />
                    <span>TimelineForAudio</span>
                </div>
                <div class="ml-3 border-l border-white/10 pl-3">
                    <a class="@LinkClass("audio/files", "audio/file-detail")"
                       href="audio/files"
                       @onclick="NotifyNavigateAsync">
                        <FaIcon Name="list-ul" Class="tfa-icon" />
                        <span>ファイル一覧</span>
                    </a>
                </div>
            </section>

            <section>
                <div class="flex items-center gap-2 px-3 py-2 font-semibold text-white">
                    <FaIcon Name="terminal" Class="tfa-icon text-teal-300" />
                    <span>TimelineForWindowsCodex</span>
                </div>
                <div class="ml-3 border-l border-white/10 pl-3">
                    <a class="@LinkClass("windows-codex", "windows-codex/thread/*")"
                       href="windows-codex"
                       @onclick="NotifyNavigateAsync">
                        <FaIcon Name="clock-rotate-left" Class="tfa-icon" />
                        <span>スレッド一覧</span>
                    </a>
                </div>
            </section>

            <section>
                <div class="flex items-center gap-2 px-3 py-2 font-semibold text-white">
                    <FaIcon Name="comments" Class="tfa-icon text-teal-300" />
                    <span>TimelineForChatGPT</span>
                </div>
                <div class="ml-3 border-l border-white/10 pl-3">
                    <a class="@LinkClass("chatgpt", "chatgpt/thread/*")"
                       href="chatgpt"
                       @onclick="NotifyNavigateAsync">
                        <FaIcon Name="file-zipper" Class="tfa-icon" />
                        <span>スレッド一覧</span>
                    </a>
                </div>
            </section>

            <section>
                <div class="flex items-center gap-2 px-3 py-2 font-semibold text-white">
                    <FaIcon Name="image" Class="tfa-icon text-teal-300" />
                    <span>TimelineForImage</span>
                </div>
                <div class="ml-3 border-l border-white/10 pl-3">
                    <a class="@LinkClass("image", "image/file-detail")"
                       href="image"
                       @onclick="NotifyNavigateAsync">
                        <FaIcon Name="images" Class="tfa-icon" />
                        <span>ファイル一覧</span>
                    </a>
                </div>
            </section>

            <section class="border-t border-white/10 pt-3">
                <div class="px-3 text-xs font-semibold uppercase tracking-normal text-slate-400">他プロダクト</div>
                <div class="mt-2 grid gap-1">
                    <div class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-500">
                        <FaIcon Name="video" Class="tfa-icon" />
                        <span>TimelineForVideo</span>
                    </div>
                </div>
            </section>
        </nav>

        <div class="mt-auto border-t border-white/10 p-4 text-xs text-slate-300">
            <div class="flex items-center gap-2 font-medium text-white">
                <FaIcon Name="circle-check" Class="tfa-icon text-teal-300" />
                <span>ローカル実行</span>
            </div>
        </div>
    </div>
</aside>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private const string NavItemClass = "flex items-center gap-2 rounded-md px-3 py-2 hover:bg-white/10 hover:text-white";

    private string CurrentPath
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            var markerIndex = path.IndexOfAny(new[] { '?', '#' });
            if (markerIndex >= 0) {
                path = path[..markerIndex];
            }

            return path.Trim('/');
        }
    }

    private string LinkClass(params string[] activePaths)
        => IsActive(activePaths)
            ? $"{NavItemClass} bg-white/15 text-white"
            : $"{NavItemClass} text-slate-200";

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private bool IsActive(params string[] activePaths)
    {
        var currentPath = CurrentPath;
        foreach (var activePath in activePaths) {
            var normalizedPath = activePath.Trim('/');
            if (normalizedPath.EndsWith("/*", StringComparison.Ordinal)) {
                var prefix = normalizedPath[..^2];
                if (string.Equals(currentPath, prefix, StringComparison.OrdinalIgnoreCase)
                    || currentPath.StartsWith($"{prefix}/", StringComparison.OrdinalIgnoreCase)) {
                    return true;
                }
                continue;
            }

            if (string.Equals(currentPath, normalizedPath, StringComparison.OrdinalIgnoreCase)) {
                return true;
            }
        }

        return false;
    }

    private Task NotifyNavigateAsync() => OnNavigate.InvokeAsync();

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
