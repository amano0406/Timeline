<aside id="timeline-sidebar" class="tfa-sidebar">
    <div class="flex h-full flex-col">
        <div class="border-b border-white/10 p-5">
            <a class="flex items-center gap-2 text-lg font-semibold text-white" href="" @onclick="NotifyNavigateAsync">
                <FaIcon Name="timeline" Class="tfa-icon text-teal-300" />
                <span>Timeline</span>
            </a>
        </div>

        <nav class="flex flex-col gap-4 p-3 text-sm">
            <div class="grid gap-1">
                <NavLink class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-200 hover:bg-white/10 hover:text-white"
                         ActiveClass="bg-white/15 text-white"
                         href=""
                         @onclick="NotifyNavigateAsync">
                    <FaIcon Name="gauge" Class="tfa-icon" />
                    <span>ダッシュボード</span>
                </NavLink>
                <NavLink class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-200 hover:bg-white/10 hover:text-white"
                         ActiveClass="bg-white/15 text-white"
                         href="timeline"
                         @onclick="NotifyNavigateAsync">
                    <FaIcon Name="timeline" Class="tfa-icon" />
                    <span>時間軸</span>
                </NavLink>
                <NavLink class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-200 hover:bg-white/10 hover:text-white"
                         ActiveClass="bg-white/15 text-white"
                         href="timeline/settings"
                         @onclick="NotifyNavigateAsync">
                    <FaIcon Name="sliders" Class="tfa-icon" />
                    <span>基本設定</span>
                </NavLink>
            </div>

            <section>
                <div class="flex items-center gap-2 px-3 py-2 font-semibold text-white">
                    <FaIcon Name="file-audio" Class="tfa-icon text-teal-300" />
                    <span>TimelineForAudio</span>
                </div>
                <div class="ml-3 border-l border-white/10 pl-3">
                    <NavLink class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-200 hover:bg-white/10 hover:text-white"
                             ActiveClass="bg-white/15 text-white"
                             href="audio/files"
                             @onclick="NotifyNavigateAsync">
                        <FaIcon Name="list-ul" Class="tfa-icon" />
                        <span>ファイル一覧</span>
                    </NavLink>
                    <NavLink class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-200 hover:bg-white/10 hover:text-white"
                             ActiveClass="bg-white/15 text-white"
                             href="audio/settings"
                             @onclick="NotifyNavigateAsync">
                        <FaIcon Name="gear" Class="tfa-icon" />
                        <span>設定</span>
                    </NavLink>
                </div>
            </section>

            <section>
                <div class="flex items-center gap-2 px-3 py-2 font-semibold text-white">
                    <FaIcon Name="terminal" Class="tfa-icon text-teal-300" />
                    <span>TimelineForWindowsCodex</span>
                </div>
                <div class="ml-3 border-l border-white/10 pl-3">
                    <NavLink class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-200 hover:bg-white/10 hover:text-white"
                             ActiveClass="bg-white/15 text-white"
                             href="windows-codex"
                             @onclick="NotifyNavigateAsync">
                        <FaIcon Name="clock-rotate-left" Class="tfa-icon" />
                        <span>スレッド一覧</span>
                    </NavLink>
                    <NavLink class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-200 hover:bg-white/10 hover:text-white"
                             ActiveClass="bg-white/15 text-white"
                             href="windows-codex/settings"
                             @onclick="NotifyNavigateAsync">
                        <FaIcon Name="gear" Class="tfa-icon" />
                        <span>設定</span>
                    </NavLink>
                </div>
            </section>

            <section>
                <div class="flex items-center gap-2 px-3 py-2 font-semibold text-white">
                    <FaIcon Name="comments" Class="tfa-icon text-teal-300" />
                    <span>TimelineForChatGPT</span>
                </div>
                <div class="ml-3 border-l border-white/10 pl-3">
                    <NavLink class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-200 hover:bg-white/10 hover:text-white"
                             ActiveClass="bg-white/15 text-white"
                             href="chatgpt"
                             @onclick="NotifyNavigateAsync">
                        <FaIcon Name="file-zipper" Class="tfa-icon" />
                        <span>スレッド一覧</span>
                    </NavLink>
                    <NavLink class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-200 hover:bg-white/10 hover:text-white"
                             ActiveClass="bg-white/15 text-white"
                             href="chatgpt/settings"
                             @onclick="NotifyNavigateAsync">
                        <FaIcon Name="gear" Class="tfa-icon" />
                        <span>設定</span>
                    </NavLink>
                </div>
            </section>

            <section>
                <div class="flex items-center gap-2 px-3 py-2 font-semibold text-white">
                    <FaIcon Name="image" Class="tfa-icon text-teal-300" />
                    <span>TimelineForImage</span>
                </div>
                <div class="ml-3 border-l border-white/10 pl-3">
                    <NavLink class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-200 hover:bg-white/10 hover:text-white"
                             ActiveClass="bg-white/15 text-white"
                             href="image"
                             @onclick="NotifyNavigateAsync">
                        <FaIcon Name="images" Class="tfa-icon" />
                        <span>ファイル一覧</span>
                    </NavLink>
                    <NavLink class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-200 hover:bg-white/10 hover:text-white"
                             ActiveClass="bg-white/15 text-white"
                             href="image/settings"
                             @onclick="NotifyNavigateAsync">
                        <FaIcon Name="gear" Class="tfa-icon" />
                        <span>設定</span>
                    </NavLink>
                </div>
            </section>

            <section class="border-t border-white/10 pt-3">
                <div class="px-3 text-xs font-semibold uppercase tracking-normal text-slate-400">他プロダクト</div>
                <div class="mt-2 grid gap-1">
                    <div class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-500">
                        <FaIcon Name="video" Class="tfa-icon" />
                        <span>TimelineForVideo</span>
                    </div>
                </div>
            </section>
        </nav>

        <div class="mt-auto border-t border-white/10 p-4 text-xs text-slate-300">
            <div class="flex items-center gap-2 font-medium text-white">
                <FaIcon Name="circle-check" Class="tfa-icon text-teal-300" />
                <span>ローカル実行</span>
            </div>
        </div>
    </div>
</aside>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private Task NotifyNavigateAsync() => OnNavigate.InvokeAsync();
}
