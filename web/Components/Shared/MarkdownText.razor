@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Rendering

<div class="tfa-markdown">
    @foreach (var block in Blocks)
    {
        switch (block.Kind)
        {
            case MarkdownBlockKind.Heading:
                @RenderHeading(block)
                break;
            case MarkdownBlockKind.Code:
                <pre><code>@block.Text</code></pre>
                break;
            case MarkdownBlockKind.UnorderedList:
                <ul>
                    @foreach (var item in block.Items)
                    {
                        <li>@RenderInline(item)</li>
                    }
                </ul>
                break;
            case MarkdownBlockKind.OrderedList:
                <ol>
                    @foreach (var item in block.Items)
                    {
                        <li>@RenderInline(item)</li>
                    }
                </ol>
                break;
            case MarkdownBlockKind.Quote:
                <blockquote>@RenderInline(block.Text)</blockquote>
                break;
            case MarkdownBlockKind.HorizontalRule:
                <hr />
                break;
            default:
                <p>@RenderInline(block.Text)</p>
                break;
        }
    }
</div>

@code {
    private static readonly Regex HeadingPattern = new(@"^\s{0,3}(#{1,6})\s+(.+?)\s*#*\s*$", RegexOptions.Compiled);
    private static readonly Regex UnorderedListPattern = new(@"^\s*[-*+]\s+(.+)$", RegexOptions.Compiled);
    private static readonly Regex OrderedListPattern = new(@"^\s*\d+[.)]\s+(.+)$", RegexOptions.Compiled);
    private static readonly Regex HorizontalRulePattern = new(@"^\s{0,3}([-*_])(?:\s*\1){2,}\s*$", RegexOptions.Compiled);
    private static readonly Regex UnicodeEscapePattern = new(@"\\u([0-9a-fA-F]{4})", RegexOptions.Compiled);
    private static readonly Regex RawUrlPattern = new(@"https?://[^\s<>()]+", RegexOptions.Compiled);

    [Parameter]
    public string? Text { get; set; }

    private IReadOnlyList<MarkdownBlock> Blocks => Parse(Text);

    private static IReadOnlyList<MarkdownBlock> Parse(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return [new MarkdownBlock(MarkdownBlockKind.Paragraph, "本文なし")];
        }

        var normalized = DecodeEscapedUnicode(text).Replace("\r\n", "\n").Replace('\r', '\n');
        var lines = normalized.Split('\n');
        var blocks = new List<MarkdownBlock>();
        var paragraph = new List<string>();
        var listItems = new List<string>();
        var quoteLines = new List<string>();
        var listKind = MarkdownBlockKind.Paragraph;
        var codeLines = new List<string>();
        var inCode = false;
        var fence = "";

        void FlushParagraph()
        {
            if (paragraph.Count == 0)
            {
                return;
            }

            blocks.Add(new MarkdownBlock(MarkdownBlockKind.Paragraph, string.Join("\n", paragraph)));
            paragraph.Clear();
        }

        void FlushList()
        {
            if (listItems.Count == 0)
            {
                return;
            }

            blocks.Add(new MarkdownBlock(listKind, "", [.. listItems]));
            listItems.Clear();
            listKind = MarkdownBlockKind.Paragraph;
        }

        void FlushQuote()
        {
            if (quoteLines.Count == 0)
            {
                return;
            }

            blocks.Add(new MarkdownBlock(MarkdownBlockKind.Quote, string.Join("\n", quoteLines)));
            quoteLines.Clear();
        }

        foreach (var rawLine in lines)
        {
            var line = rawLine.TrimEnd();
            var trimmedStart = line.TrimStart();
            if (trimmedStart.StartsWith("```", StringComparison.Ordinal) || trimmedStart.StartsWith("~~~", StringComparison.Ordinal))
            {
                var currentFence = trimmedStart[..3];
                if (inCode && currentFence == fence)
                {
                    blocks.Add(new MarkdownBlock(MarkdownBlockKind.Code, string.Join("\n", codeLines)));
                    codeLines.Clear();
                    inCode = false;
                    fence = "";
                }
                else if (!inCode)
                {
                    FlushParagraph();
                    FlushList();
                    FlushQuote();
                    inCode = true;
                    fence = currentFence;
                }
                else
                {
                    codeLines.Add(rawLine);
                }
                continue;
            }

            if (inCode)
            {
                codeLines.Add(rawLine);
                continue;
            }

            if (string.IsNullOrWhiteSpace(line))
            {
                FlushParagraph();
                FlushList();
                FlushQuote();
                continue;
            }

            if (HorizontalRulePattern.IsMatch(line))
            {
                FlushParagraph();
                FlushList();
                FlushQuote();
                blocks.Add(new MarkdownBlock(MarkdownBlockKind.HorizontalRule, ""));
                continue;
            }

            var heading = HeadingPattern.Match(line);
            if (heading.Success)
            {
                FlushParagraph();
                FlushList();
                FlushQuote();
                blocks.Add(new MarkdownBlock(MarkdownBlockKind.Heading, heading.Groups[2].Value.Trim(), Level: heading.Groups[1].Value.Length));
                continue;
            }

            var unordered = UnorderedListPattern.Match(line);
            if (unordered.Success)
            {
                FlushParagraph();
                FlushQuote();
                if (listItems.Count > 0 && listKind != MarkdownBlockKind.UnorderedList)
                {
                    FlushList();
                }
                listKind = MarkdownBlockKind.UnorderedList;
                listItems.Add(unordered.Groups[1].Value.Trim());
                continue;
            }

            var ordered = OrderedListPattern.Match(line);
            if (ordered.Success)
            {
                FlushParagraph();
                FlushQuote();
                if (listItems.Count > 0 && listKind != MarkdownBlockKind.OrderedList)
                {
                    FlushList();
                }
                listKind = MarkdownBlockKind.OrderedList;
                listItems.Add(ordered.Groups[1].Value.Trim());
                continue;
            }

            if (line.TrimStart().StartsWith(">", StringComparison.Ordinal))
            {
                FlushParagraph();
                FlushList();
                quoteLines.Add(line.TrimStart().TrimStart('>').Trim());
                continue;
            }

            FlushList();
            FlushQuote();
            paragraph.Add(line);
        }

        if (inCode)
        {
            blocks.Add(new MarkdownBlock(MarkdownBlockKind.Code, string.Join("\n", codeLines)));
        }
        FlushParagraph();
        FlushList();
        FlushQuote();

        return blocks.Count == 0 ? [new MarkdownBlock(MarkdownBlockKind.Paragraph, "本文なし")] : blocks;
    }

    private static RenderFragment RenderHeading(MarkdownBlock block) => builder =>
    {
        var sequence = 0;
        var level = Math.Clamp(block.Level, 2, 4);
        builder.OpenElement(sequence++, $"h{level}");
        builder.AddContent(sequence++, RenderInline(block.Text));
        builder.CloseElement();
    };

    private static RenderFragment RenderInline(string text) => builder =>
    {
        var sequence = 0;
        RenderInlineRange(builder, ref sequence, text, 0, text.Length);
    };

    private static void RenderInlineRange(RenderTreeBuilder builder, ref int sequence, string text, int start, int end)
    {
        var index = start;
        while (index < end)
        {
            var next = FindNextInlineToken(text, index, end);
            if (next < 0)
            {
                builder.AddContent(sequence++, text[index..end]);
                break;
            }

            if (next > index)
            {
                builder.AddContent(sequence++, text[index..next]);
            }

            if (TryRenderInlineToken(builder, ref sequence, text, next, end, out var consumedTo))
            {
                index = consumedTo;
                continue;
            }

            builder.AddContent(sequence++, text[next].ToString());
            index = next + 1;
        }
    }

    private static bool TryRenderInlineToken(RenderTreeBuilder builder, ref int sequence, string text, int index, int end, out int consumedTo)
    {
        consumedTo = index;

        if (text[index] == '`')
        {
            var codeEnd = text.IndexOf('`', index + 1);
            if (codeEnd > index && codeEnd < end)
            {
                builder.OpenElement(sequence++, "code");
                builder.AddContent(sequence++, text[(index + 1)..codeEnd]);
                builder.CloseElement();
                consumedTo = codeEnd + 1;
                return true;
            }
        }

        if (text[index] == '[' && TryReadLink(text, index, out var label, out var href, out var linkEnd))
        {
            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "href", href);
            builder.AddAttribute(sequence++, "target", "_blank");
            builder.AddAttribute(sequence++, "rel", "noreferrer");
            builder.AddContent(sequence++, label);
            builder.CloseElement();
            consumedTo = linkEnd;
            return true;
        }

        if (TryReadRawUrl(text, index, end, out var rawUrl, out var rawUrlEnd))
        {
            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "href", rawUrl);
            builder.AddAttribute(sequence++, "target", "_blank");
            builder.AddAttribute(sequence++, "rel", "noreferrer");
            builder.AddContent(sequence++, rawUrl);
            builder.CloseElement();
            consumedTo = rawUrlEnd;
            return true;
        }

        if (StartsWithAt(text, index, end, "**") && TryFindClosing(text, index + 2, end, "**", out var strongEnd))
        {
            builder.OpenElement(sequence++, "strong");
            RenderInlineRange(builder, ref sequence, text, index + 2, strongEnd);
            builder.CloseElement();
            consumedTo = strongEnd + 2;
            return true;
        }

        if (StartsWithAt(text, index, end, "__") && TryFindClosing(text, index + 2, end, "__", out strongEnd))
        {
            builder.OpenElement(sequence++, "strong");
            RenderInlineRange(builder, ref sequence, text, index + 2, strongEnd);
            builder.CloseElement();
            consumedTo = strongEnd + 2;
            return true;
        }

        if (StartsWithAt(text, index, end, "~~") && TryFindClosing(text, index + 2, end, "~~", out var strikeEnd))
        {
            builder.OpenElement(sequence++, "s");
            RenderInlineRange(builder, ref sequence, text, index + 2, strikeEnd);
            builder.CloseElement();
            consumedTo = strikeEnd + 2;
            return true;
        }

        if ((text[index] == '*' || text[index] == '_') && CanStartEmphasis(text, index, end) && TryFindEmphasisClosing(text, index + 1, end, text[index], out var emEnd))
        {
            builder.OpenElement(sequence++, "em");
            RenderInlineRange(builder, ref sequence, text, index + 1, emEnd);
            builder.CloseElement();
            consumedTo = emEnd + 1;
            return true;
        }

        return false;
    }

    private static int FindNextInlineToken(string text, int start, int end)
    {
        for (var index = start; index < end; index++)
        {
            var current = text[index];
            if (current is '`' or '[' or '*' or '_' or '~')
            {
                return index;
            }
            if (current == 'h' && (StartsWithAt(text, index, end, "http://") || StartsWithAt(text, index, end, "https://")))
            {
                return index;
            }
        }

        return -1;
    }

    private static bool TryReadLink(string text, int start, out string label, out string href, out int end)
    {
        label = "";
        href = "";
        end = start;
        var labelEnd = text.IndexOf("](", start, StringComparison.Ordinal);
        if (labelEnd <= start)
        {
            return false;
        }

        var hrefEnd = text.IndexOf(')', labelEnd + 2);
        if (hrefEnd <= labelEnd + 2)
        {
            return false;
        }

        var candidate = text[(labelEnd + 2)..hrefEnd].Trim();
        if (!IsSafeHttpUrl(candidate))
        {
            return false;
        }

        label = text[(start + 1)..labelEnd];
        href = candidate;
        end = hrefEnd + 1;
        return true;
    }

    private static bool TryReadRawUrl(string text, int start, int end, out string href, out int consumedTo)
    {
        href = "";
        consumedTo = start;
        var match = RawUrlPattern.Match(text, start);
        if (!match.Success || match.Index != start || match.Index >= end)
        {
            return false;
        }

        var candidate = match.Index + match.Length > end
            ? text[start..end]
            : match.Value;
        while (candidate.Length > 0 && ".,;:!?)]}".Contains(candidate[^1]))
        {
            candidate = candidate[..^1];
        }

        if (!IsSafeHttpUrl(candidate))
        {
            return false;
        }

        href = candidate;
        consumedTo = start + candidate.Length;
        return true;
    }

    private static bool IsSafeHttpUrl(string candidate) =>
        Uri.TryCreate(candidate, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    private static bool StartsWithAt(string text, int index, int end, string value) =>
        index + value.Length <= end && text.AsSpan(index, value.Length).SequenceEqual(value);

    private static bool TryFindClosing(string text, int start, int end, string marker, out int closing)
    {
        closing = text.IndexOf(marker, start, StringComparison.Ordinal);
        return closing >= start && closing < end;
    }

    private static bool TryFindEmphasisClosing(string text, int start, int end, char marker, out int closing)
    {
        closing = -1;
        for (var index = start; index < end; index++)
        {
            if (text[index] != marker)
            {
                continue;
            }

            if (index + 1 < end && text[index + 1] == marker)
            {
                continue;
            }

            if (index > start && !char.IsWhiteSpace(text[index - 1]))
            {
                closing = index;
                return true;
            }
        }
        return false;
    }

    private static bool CanStartEmphasis(string text, int index, int end)
    {
        if (index + 1 >= end || char.IsWhiteSpace(text[index + 1]))
        {
            return false;
        }

        return index == 0 || !char.IsLetterOrDigit(text[index - 1]);
    }

    private static string DecodeEscapedUnicode(string text) =>
        UnicodeEscapePattern.Replace(text, match => ((char)Convert.ToInt32(match.Groups[1].Value, 16)).ToString());

    private sealed record MarkdownBlock(
        MarkdownBlockKind Kind,
        string Text,
        IReadOnlyList<string>? RawItems = null,
        int Level = 0)
    {
        public IReadOnlyList<string> Items => RawItems ?? [];
    }

    private enum MarkdownBlockKind
    {
        Paragraph,
        Heading,
        Code,
        UnorderedList,
        OrderedList,
        Quote,
        HorizontalRule,
    }
}
