@inject TimelineLocalApiClient Timeline

<div class="tfa-product-management">
    @if (!Embedded)
    {
        <div class="tfa-product-management-header">
        <div class="text-sm text-slate-600">導入済みの製品と、Timeline から操作した起動状態を確認します。</div>
        <button class="tfa-button-secondary gap-2" @onclick="LoadAsync" disabled="@_loading">
            <FaIcon Name="@(_loading ? "spinner" : "rotate")" Class="@($"tfa-icon {(_loading ? "fa-spin" : "")}")" />
            <span>状態更新</span>
        </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="tfa-alert-danger flex items-start gap-2">
            <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
            <span>@_error</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="@($"{MessageAlertClass} flex items-start gap-2")">
            <FaIcon Name="@MessageIcon" Class="tfa-icon mt-0.5" />
            <span>@_message</span>
        </div>
    }

    @if (_completion is not null)
    {
        <div class="fixed inset-0 z-[1080] flex items-center justify-center bg-slate-950/60 p-4">
            <section class="w-full max-w-xl rounded-md bg-white shadow-xl"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="product-completion-title">
                <header class="flex items-start justify-between gap-4 border-b border-line p-5">
                    <div>
                        <h2 id="product-completion-title" class="flex items-center gap-2 text-lg font-semibold">
                            <FaIcon Name="circle-check" Class="tfa-icon text-accent" />
                            <span>@_completion.Title</span>
                        </h2>
                        <p class="mt-1 text-sm text-slate-600">@_completion.Message</p>
                    </div>
                    <button type="button"
                            class="tfa-button-secondary !min-h-9 !px-2"
                            aria-label="完了通知を閉じる"
                            @onclick="CloseCompletion">
                        <FaIcon Name="xmark" Class="tfa-icon" />
                    </button>
                </header>

                <div class="space-y-4 p-5 text-sm text-slate-700">
                    <dl class="grid gap-2 rounded-md border border-line bg-slate-50 p-4">
                        @foreach (var row in _completion.Rows)
                        {
                            <div class="grid gap-1 border-b border-line/70 pb-2 last:border-b-0 last:pb-0 sm:grid-cols-[12rem_1fr]">
                                <dt class="font-semibold text-slate-900">@row.Label</dt>
                                <dd class="min-w-0 break-words">@row.Value</dd>
                            </div>
                        }
                    </dl>

                    @if (_completion.Warnings.Count > 0)
                    {
                        <div class="rounded-md border border-amber-200 bg-amber-50 p-4 text-amber-900">
                            <div class="mb-2 flex items-center gap-2 font-semibold">
                                <FaIcon Name="triangle-exclamation" Class="tfa-icon !h-4 !w-4" />
                                <span>確認が必要な項目</span>
                            </div>
                            <ul class="space-y-1">
                                @foreach (var warning in _completion.Warnings)
                                {
                                    <li>@UninstallWarningText(warning)</li>
                                }
                            </ul>
                        </div>
                    }
                </div>

                <footer class="flex justify-end border-t border-line p-4">
                    <button type="button" class="tfa-button-primary gap-2" @onclick="CloseCompletion">
                        <FaIcon Name="circle-check" Class="tfa-icon" />
                        <span>確認しました</span>
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (_loading && _overview is null)
    {
        <section class="tfa-card tfa-card-pad flex items-center gap-3">
            <FaIcon Name="spinner" Class="tfa-icon fa-spin text-accent" />
            <span class="text-sm text-slate-600">読み込み中</span>
        </section>
    }
    else if (Products.Count == 0)
    {
        <section class="tfa-card tfa-card-pad text-sm text-slate-600">
            製品情報を取得できませんでした。
        </section>
    }
    else
    {
        <section class="tfa-card tfa-product-card">
            <header class="tfa-product-card-header">
                <h2 class="flex items-center gap-2 text-lg font-semibold">
                    <FaIcon Name="list-check" Class="tfa-icon text-accent" />
                    <span>製品</span>
                </h2>
            </header>

            <div class="tfa-product-list">
                @foreach (var product in Products)
                {
                    <article class="tfa-product-row">
                        <div class="tfa-product-main">
                            <span class="tfa-product-icon">
                                <FaIcon Name="@ProductIcon(product.Id)" Class="tfa-icon" />
                            </span>
                            <div class="tfa-product-content">
                                <div class="tfa-product-title-line">
                                    <h3 class="tfa-product-title">@DisplayName(product)</h3>
                                    <span class="@RuntimePillClass(product)">
                                        <FaIcon Name="@RuntimeIcon(product)" Class="@($"tfa-icon !h-3 !w-3 {(IsBusy(product) ? "fa-spin" : "")}")" />
                                        <span>@RuntimeLabel(product)</span>
                                    </span>
                                </div>

                                <dl class="tfa-product-meta">
                                    <div>
                                        <dt>配置</dt>
                                        <dd>@EmptyText(product.ProductPath)</dd>
                                    </div>
                                    <div>
                                        <dt>管理状態</dt>
                                        <dd>@RuntimeDetailLabel(product)</dd>
                                    </div>
                                    <div>
                                        <dt>現在</dt>
                                        <dd>@VersionText(product.InstalledVersion)</dd>
                                    </div>
                                    <div>
                                        <dt>最新</dt>
                                        <dd>@LatestVersionText(product)</dd>
                                    </div>
                                </dl>

                                @if (ShowProductMessage(product))
                                {
                                    <div class="tfa-product-message">
                                        <FaIcon Name="triangle-exclamation" Class="tfa-icon !h-4 !w-4" />
                                        <span>@ProductMessage(product)</span>
                                    </div>
                                }

                                @if (HasSettingsBackupForInstall(product))
                                {
                                    <div class="mt-3 rounded-md border border-teal-200 bg-teal-50 p-3 text-sm text-teal-900">
                                        <div class="flex items-start gap-2">
                                            <FaIcon Name="rotate-left" Class="tfa-icon !h-4 !w-4 mt-0.5" />
                                            <div>
                                                <div class="font-semibold">前回の設定を利用できます</div>
                                                <label class="mt-2 flex items-center gap-2">
                                                    <input type="checkbox"
                                                           class="h-4 w-4 rounded border-line text-accent"
                                                           checked="@InstallRestoreSettings(product)"
                                                           @onchange="@(args => SetInstallRestoreSettings(product, args))"
                                                           disabled="@(_actionProductId is not null)" />
                                                    <span>インストール時にこの設定を使う</span>
                                                </label>
                                                <div class="mt-1 break-all text-xs text-teal-800">@product.SettingsBackupPath</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="tfa-product-actions">
                            @if (!product.SupportedOnCurrentOperatingSystem)
                            {
                                <span class="tfa-status-pill border-amber-200 bg-amber-50 text-amber-900">
                                    <FaIcon Name="circle-minus" Class="tfa-icon !h-3 !w-3" />
                                    <span>未対応</span>
                                </span>
                            }
                            else if (IsInstalled(product))
                            {
                                <button type="button"
                                        class="tfa-button-primary gap-2"
                                        @onclick="@(() => StartProductAsync(product))"
                                        disabled="@(!CanStart(product))">
                                    <FaIcon Name="play" Class="tfa-icon" />
                                    <span>起動</span>
                                </button>
                                <button type="button"
                                        class="tfa-button-secondary gap-2"
                                        @onclick="@(() => StopProductAsync(product))"
                                        disabled="@(!CanStop(product))">
                                    <FaIcon Name="stop" Class="tfa-icon" />
                                    <span>停止</span>
                                </button>
                                <button type="button"
                                        class="tfa-button-secondary gap-2"
                                        @onclick="@(() => RestartProductAsync(product))"
                                        disabled="@(!CanRestart(product))">
                                    <FaIcon Name="rotate" Class="@($"tfa-icon {(IsBusy(product) ? "fa-spin" : "")}")" />
                                    <span>再起動</span>
                                </button>
                                @if (product.UpdateAvailable)
                                {
                                    <button type="button"
                                            class="tfa-button-primary gap-2"
                                            @onclick="@(() => UpdateProductAsync(product))"
                                            disabled="@(!CanUpdate(product))">
                                        <FaIcon Name="cloud-arrow-down" Class="@($"tfa-icon {(IsBusy(product) ? "fa-spin" : "")}")" />
                                        <span>更新</span>
                                    </button>
                                }
                                else if (product.SourceArchiveUpdateAvailable)
                                {
                                    <span class="tfa-status-pill border-amber-200 bg-amber-50 text-amber-900"
                                          title="GitHub source archive には新しい版がありますが、通常更新にはビルド済み成果物が必要です。">
                                        <FaIcon Name="circle-info" Class="tfa-icon !h-3 !w-3" />
                                        <span>配布成果物待ち</span>
                                    </span>
                                }
                                else if (!string.IsNullOrWhiteSpace(product.LatestVersion))
                                {
                                    <span class="tfa-status-pill border-slate-200 bg-slate-50 text-slate-700">
                                        <FaIcon Name="circle-check" Class="tfa-icon !h-3 !w-3" />
                                        <span>最新</span>
                                    </span>
                                }
                                <button type="button"
                                        class="tfa-button-secondary tfa-product-action-wide gap-2"
                                        @onclick="@(() => RequestUninstallAsync(product))"
                                        disabled="@(!CanRequestUninstall(product))">
                                    <FaIcon Name="trash" Class="tfa-icon" />
                                    <span>アンインストール</span>
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="tfa-button-primary gap-2"
                                        @onclick="@(() => InstallProductAsync(product))"
                                        disabled="@(!CanInstall(product))">
                                    <FaIcon Name="download" Class="tfa-icon" />
                                    <span>インストール</span>
                                </button>
                            }
                        </div>

                    </article>
                }
            </div>
        </section>
    }
</div>

@if (PendingUninstallProduct is { } pendingProduct)
{
    <div class="fixed inset-0 z-[1080] flex items-center justify-center bg-slate-950/60 p-4">
        <section class="flex max-h-[88vh] w-full max-w-xl flex-col overflow-hidden rounded-md bg-white shadow-xl"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="product-uninstall-title">
            <header class="flex items-start justify-between gap-4 border-b border-line p-5">
                <div class="min-w-0">
                    <h2 id="product-uninstall-title" class="flex items-center gap-2 text-lg font-semibold">
                        <FaIcon Name="trash" Class="tfa-icon text-warning" />
                        <span>@DisplayName(pendingProduct) をアンインストールしますか？</span>
                    </h2>
                    <p class="mt-1 text-sm text-slate-600">
                        製品アプリ本体は削除されます。元ファイルは削除されません。
                    </p>
                </div>
                <button type="button"
                        class="tfa-button-secondary !min-h-9 !px-2"
                        aria-label="アンインストール確認を閉じる"
                        @onclick="CancelUninstall"
                        disabled="@(_actionProductId is not null)">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                </button>
            </header>

            <div class="overflow-auto p-5">
                <div class="grid gap-4">
                    @if (IsRuntimeStarted(pendingProduct))
                    {
                        <div class="rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
                            現在起動中です。アンインストール前に停止し、停止に失敗した場合は削除しません。
                        </div>
                    }

                    <div class="rounded-md border border-line bg-white p-4 text-sm text-slate-700">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="font-semibold text-slate-900">選択中の削除レベル</span>
                            <span class="@UninstallModePillClass">@UninstallModeTitle</span>
                        </div>
                        <p class="mt-2 leading-6">@UninstallModeDescription</p>
                    </div>

                    <div class="grid gap-3 rounded-md border border-line bg-slate-50 p-4">
                        <label class="flex items-center gap-2 text-sm">
                            <input type="checkbox"
                                   class="h-4 w-4 rounded border-line text-accent"
                                   checked="@_uninstallKeepSettings"
                                   @onchange="@(async args => await SetUninstallKeepSettingsAsync(args))"
                                   disabled="@(_actionProductId is not null || _uninstallPlanLoading)" />
                            <span>設定を退避して残す</span>
                        </label>
                        <fieldset class="grid gap-2 text-sm">
                            <legend class="font-semibold text-slate-700">取り込んだデータ</legend>
                            <label class="flex items-center gap-2">
                                <input type="radio"
                                       name="@($"uninstall-data-{pendingProduct.Id}")"
                                       class="h-4 w-4 border-line text-accent"
                                       checked="@(!_uninstallRemoveGeneratedData)"
                                       @onchange="@(async _ => await SetUninstallRemoveGeneratedDataAsync(false))"
                                       disabled="@(_actionProductId is not null || _uninstallPlanLoading)" />
                                <span>残す</span>
                            </label>
                            <label class="flex items-center gap-2">
                                <input type="radio"
                                       name="@($"uninstall-data-{pendingProduct.Id}")"
                                       class="h-4 w-4 border-line text-accent"
                                       checked="@_uninstallRemoveGeneratedData"
                                       @onchange="@(async _ => await SetUninstallRemoveGeneratedDataAsync(true))"
                                       disabled="@(_actionProductId is not null || _uninstallPlanLoading)" />
                                <span>生成済みデータも削除する</span>
                            </label>
                        </fieldset>
                    </div>

                    @if (UninstallNeedsStrongConfirmation)
                    {
                        <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-900">
                            <div class="mb-2 flex items-center gap-2 font-semibold">
                                <FaIcon Name="triangle-exclamation" Class="tfa-icon !h-4 !w-4" />
                                <span>削除範囲が広がっています</span>
                            </div>
                            <label class="flex items-start gap-2">
                                <input type="checkbox"
                                       class="mt-1 h-4 w-4 rounded border-red-300 text-red-700"
                                       checked="@_uninstallDangerAccepted"
                                       @onchange="SetUninstallDangerAccepted"
                                       disabled="@(_actionProductId is not null || _uninstallPlanLoading)" />
                                <span>生成済みデータまたは設定が削除対象になることを確認しました。</span>
                            </label>
                        </div>
                    }

                    @if (_uninstallPlanLoading)
                    {
                        <div class="flex items-center gap-2 rounded-md border border-line bg-slate-50 p-4 text-sm text-slate-600">
                            <FaIcon Name="spinner" Class="tfa-icon fa-spin" />
                            <span>削除内容を確認しています。</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_uninstallPlanError))
                    {
                        <div class="tfa-alert-danger">@_uninstallPlanError</div>
                    }
                    else if (_uninstallPlan is not null)
                    {
                        <div class="rounded-md border border-line bg-white p-4 text-sm text-slate-700">
                            <div class="mb-3 font-semibold text-slate-900">実行内容</div>
                            <dl class="grid gap-2">
                                <div class="flex justify-between gap-4">
                                    <dt>削除するアプリ本体</dt>
                                    <dd class="font-mono">@FormatBytes(_uninstallPlan.AppDirectory.SizeBytes)</dd>
                                </div>
                                <div class="flex justify-between gap-4">
                                    <dt>生成済みデータ</dt>
                                    <dd>@GeneratedDataPlanLabel(_uninstallPlan)</dd>
                                </div>
                                <div class="flex justify-between gap-4">
                                    <dt>実行環境データ</dt>
                                    <dd>@RuntimeDataPlanLabel(_uninstallPlan)</dd>
                                </div>
                                <div class="flex justify-between gap-4">
                                    <dt>設定</dt>
                                    <dd>@SettingsPlanLabel(_uninstallPlan)</dd>
                                </div>
                                <div class="flex justify-between gap-4 border-t border-line pt-2">
                                    <dt>空き容量の見込み</dt>
                                    <dd class="font-mono font-semibold">@FormatBytes(_uninstallPlan.TotalDeleteBytes)</dd>
                                </div>
                            </dl>
                            @if (_uninstallPlan.Warnings.Count > 0)
                            {
                                <div class="mt-4 rounded-md border border-amber-200 bg-amber-50 p-3 text-amber-900">
                                    <div class="mb-2 flex items-center gap-2 font-semibold">
                                        <FaIcon Name="triangle-exclamation" Class="tfa-icon !h-4 !w-4" />
                                        <span>削除前に確認してください</span>
                                    </div>
                                    <ul class="grid gap-1">
                                        @foreach (var warning in _uninstallPlan.Warnings)
                                        {
                                            <li>@UninstallWarningText(warning)</li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (_uninstallPlan.RuntimeData.Resources.Count > 0)
                            {
                                <div class="mt-4 rounded-md border border-line bg-slate-50 p-3">
                                    <div class="mb-2 font-semibold text-slate-900">実行環境データの内訳</div>
                                    <ul class="grid gap-2">
                                        @foreach (var resource in _uninstallPlan.RuntimeData.Resources)
                                        {
                                            <li class="rounded-md border border-line bg-white p-2">
                                                <div class="grid gap-1 sm:grid-cols-[9rem_1fr_auto_auto]">
                                                    <span class="font-semibold text-slate-700">@RuntimeResourceKindLabel(resource.Kind)</span>
                                                    <span class="min-w-0 break-all">@RuntimeResourceDisplay(resource)</span>
                                                    <span class="font-mono text-slate-600">@RuntimeResourceSizeLabel(resource)</span>
                                                    <span class="@RuntimeResourceStatusClass(resource)">@RuntimeResourceStatusLabel(resource)</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(RuntimeResourceMessage(resource)))
                                                {
                                                    <div class="mt-1 text-xs text-slate-500">@RuntimeResourceMessage(resource)</div>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            <div class="mt-2 break-all text-xs text-slate-500">@_uninstallPlan.ProductPath</div>
                        </div>
                    }
                </div>
            </div>

            <footer class="flex flex-wrap justify-end gap-2 border-t border-line bg-white p-4">
                <button type="button"
                        class="tfa-button-secondary gap-2"
                        @onclick="CancelUninstall"
                        disabled="@(_actionProductId is not null)">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                    <span>キャンセル</span>
                </button>
                <button type="button"
                        class="tfa-button-primary gap-2"
                        @onclick="@(() => ConfirmUninstallAsync(pendingProduct))"
                        disabled="@(!CanConfirmUninstall(pendingProduct))">
                    <FaIcon Name="@(_actionProductId == pendingProduct.Id ? "spinner" : "trash")"
                            Class="@($"tfa-icon {(_actionProductId == pendingProduct.Id ? "fa-spin" : "")}")" />
                    <span>@ConfirmUninstallLabel</span>
                </button>
            </footer>
        </section>
    </div>
}
