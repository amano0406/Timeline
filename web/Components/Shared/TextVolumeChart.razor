@using System.Globalization

<section class="@($"tfa-card tfa-card-pad {Class}".Trim())">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <h2 class="flex items-center gap-2 text-lg font-semibold">
                <FaIcon Name="bar-chart-3" Class="tfa-icon text-accent" />
                <span>@Title</span>
            </h2>
            <p class="mt-1 text-sm text-slate-600">@Description</p>
        </div>
        @if (Points.Count > 0)
        {
            <div class="flex flex-wrap gap-2 text-xs text-slate-500">
                <span class="tfa-status-pill border-teal-200 bg-teal-50 text-teal-800">@TotalCharacters 文字</span>
                <span class="tfa-status-pill border-slate-200 bg-slate-50 text-slate-700">@Points.Count 区間</span>
            </div>
        }
    </div>

    @if (Points.Count == 0)
    {
        <div class="mt-4 rounded-md border border-line bg-slate-50 p-4 text-sm text-slate-600">
            @EmptyMessage
        </div>
    }
    else
    {
        <div class="mt-4 grid gap-2 overflow-auto pr-1" style="max-height: 360px;">
            @foreach (var point in Points)
            {
                <div class="grid items-center gap-3 rounded-md border border-line bg-white px-3 py-2 sm:grid-cols-[7.5rem_minmax(0,1fr)_4.5rem]">
                    <div class="font-mono text-xs text-slate-600">@point.Label</div>
                    <div class="h-3 overflow-hidden rounded-full bg-slate-100">
                        <div class="h-full rounded-full bg-accent" style="@BarStyle(point.CharacterCount)"></div>
                    </div>
                    <div class="text-right font-mono text-sm text-slate-800">@point.CharacterCount</div>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter]
    public IReadOnlyList<TextVolumeChartPoint> Points { get; set; } = [];

    [Parameter]
    public string Title { get; set; } = "時間ごとの文字量";

    [Parameter]
    public string Description { get; set; } = "文字起こしの文字数を時間帯ごとに集計します。";

    [Parameter]
    public string EmptyMessage { get; set; } = "文字量を集計できる文字起こしはありません。";

    [Parameter]
    public string Class { get; set; } = "";

    private int TotalCharacters => Points.Sum(point => point.CharacterCount);

    private int MaxCharacters => Math.Max(1, Points.Max(point => point.CharacterCount));

    private string BarStyle(int characterCount)
    {
        var width = Math.Clamp(characterCount * 100d / MaxCharacters, 0, 100);
        return string.Create(CultureInfo.InvariantCulture, $"width: {width:0.##}%;");
    }
}

