@inject TimelineHelperClient Timeline
@inject IJSRuntime Js

@if (_visible)
{
    <div class="tfa-initial-setup-overlay fixed inset-0 flex items-center justify-center bg-slate-950/60 p-4">
        <section class="tfa-initial-setup-dialog rounded-md bg-white shadow-xl"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="initial-product-setup-title">
            <header class="flex items-start justify-between gap-4 border-b border-line p-5">
                <div>
                    <h2 id="initial-product-setup-title" class="flex items-center gap-2 text-xl font-semibold text-slate-900">
                        <FaIcon Name="boxes-stacked" Class="tfa-icon text-accent" />
                        <span>使う製品をインストール</span>
                    </h2>
                    <p class="mt-2 text-sm text-slate-600">
                        Timeline はサブ製品を追加すると、音声・画像・動画などを取り込めるようになります。
                    </p>
                </div>
                <button type="button"
                        class="tfa-button-secondary !min-h-9 !px-2"
                        aria-label="初期設定を閉じる"
                        disabled="@_installing"
                        @onclick="DismissAsync">
                    <FaIcon Name="xmark" Class="tfa-icon" />
                </button>
            </header>

            <div class="tfa-initial-setup-body space-y-4 p-5">
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="tfa-alert-danger flex items-start gap-2">
                        <FaIcon Name="triangle-exclamation" Class="tfa-icon mt-0.5" />
                        <span>@_error</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="tfa-alert-info flex items-start gap-2">
                        <FaIcon Name="circle-info" Class="tfa-icon mt-0.5" />
                        <span>@_message</span>
                    </div>
                }

                <div class="grid gap-3">
                    @foreach (var product in InstallableProducts)
                    {
                        var state = ProductInstallState(product.Id);
                        <label class="flex items-start gap-3 rounded-md border border-line bg-slate-50 p-4">
                            <input type="checkbox"
                                   class="mt-1 h-4 w-4 rounded border-line text-accent"
                                   checked="@IsSelected(product.Id)"
                                   disabled="@(_installing || state == "done")"
                                   @onchange="@(args => SetSelected(product.Id, args))" />
                            <span class="min-w-0 flex-1">
                                <span class="flex flex-wrap items-center gap-2 font-semibold text-slate-900">
                                    <FaIcon Name="@ProductIcon(product.Id)" Class="tfa-icon text-accent" />
                                    <span>@DisplayName(product)</span>
                                    @if (DefaultSelectedProductIds.Contains(product.Id))
                                    {
                                        <span class="tfa-status-pill border-teal-200 bg-teal-50 text-teal-800">推奨</span>
                                    }
                                    <span class="@InstallStatePillClass(state)">@InstallStateLabel(state)</span>
                                </span>
                                <span class="mt-1 block text-sm text-slate-600">@ProductDescription(product.Id)</span>
                                @if (!string.IsNullOrWhiteSpace(product.LatestVersion))
                                {
                                    <span class="mt-1 block text-xs text-slate-500">最新: @product.LatestVersion</span>
                                }
                            </span>
                        </label>
                    }
                </div>

                <div class="rounded-md border border-line bg-white p-4 text-sm text-slate-600">
                    Windows Codex、ChatGPT、PC状態は使う人が分かれるため、最初は未選択です。必要になったら製品管理から追加できます。
                </div>
            </div>

            <footer class="flex flex-col gap-3 border-t border-line p-5 sm:flex-row sm:justify-end">
                <button type="button"
                        class="tfa-button-secondary gap-2"
                        disabled="@_installing"
                        @onclick="DismissAsync">
                    <FaIcon Name="clock" Class="tfa-icon" />
                    <span>あとで設定する</span>
                </button>
                <button type="button"
                        class="tfa-button-primary gap-2"
                        disabled="@(!CanInstallSelected)"
                        @onclick="InstallSelectedAsync">
                    <FaIcon Name="@(_installing ? "spinner" : "download")" Class="@($"tfa-icon {(_installing ? "fa-spin" : "")}")" />
                    <span>@(_installing ? "インストール中" : "選択した製品をインストール")</span>
                </button>
            </footer>
        </section>
    </div>
}
