@using System.Text.Json
@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="vendor/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="timeline-file-tree.css" />
    <link rel="stylesheet" href="timeline-console.css" />
    <link rel="stylesheet" href="timeline-export.css" />
    <link rel="stylesheet" href="timeline-responsive.css" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>

<body>
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <script>
        window.timelineHelperBaseUrl = @HelperPublicBaseUrlJson;
    </script>
    <script src="vendor/tw-elements/tw-elements.umd.min.js"></script>
    <script src="timeline-directory-picker.js"></script>
    <script src="timeline-audio-player.js"></script>
    <script src="timeline-download.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    private string HelperPublicBaseUrl =>
        Configuration["Timeline:HelperPublicBaseUrl"]
        ?? Environment.GetEnvironmentVariable("TIMELINE_HELPER_PUBLIC_BASE_URL")
        ?? "http://127.0.0.1:19001";

    private MarkupString HelperPublicBaseUrlJson =>
        (MarkupString)JsonSerializer.Serialize(HelperPublicBaseUrl);
}
